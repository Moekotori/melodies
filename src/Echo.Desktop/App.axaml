<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Echo.Desktop.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Resources/Themes/EchoTokens.axaml" />
        <ResourceInclude Source="/Resources/Themes/EchoClassicTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Resources/Themes/EchoControls.axaml" />
    <StyleInclude Source="/Features/Settings/SettingsStyles.axaml" />
    <StyleInclude Source="/Resources/Motion/EchoMotion.axaml" />
  </Application.Styles>
</Application>
