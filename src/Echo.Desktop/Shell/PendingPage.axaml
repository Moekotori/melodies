<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Shell.PendingPage" x:DataType="shell:ShellViewModel">
  <StackPanel Spacing="20" Margin="12">
    <TextBlock Name="PageTitle" Classes="heading" FontSize="28" />
    <Border Height="1" Background="{DynamicResource EchoDivider}" />
    <StackPanel Spacing="12" Margin="0,90" HorizontalAlignment="Center" MaxWidth="440">
      <icon:EchoIcon Name="PageIcon" Width="48" Height="48" HorizontalAlignment="Center" />
      <TextBlock Text="{DynamicResource ui.PendingPage.04e3e69995dd}" Classes="heading" FontSize="18" HorizontalAlignment="Center" />
      <TextBlock Text="{DynamicResource ui.PendingPage.c4e5f4e7f578}" Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Center" />
      <Button Content="{DynamicResource ui.PendingPage.5ff221f046f0}" Command="{Binding NavigateCommand}" CommandParameter="home" HorizontalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
