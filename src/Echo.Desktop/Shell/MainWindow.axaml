<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Echo.Desktop.Shell.MainWindow"
        Title="melodies" Width="1440" Height="900" MinWidth="800" MinHeight="600"
        Icon="/Resources/Icons/echo-app.ico"
        Win32Properties.WindowCornerPreference="Round"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="40"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource EchoPage}">
  <Window.WindowDecorationsTheme>
    <ControlTheme TargetType="chrome:WindowDrawnDecorations">
      <Setter Property="Template">
        <WindowDrawnDecorationsTemplate><chrome:WindowDrawnDecorationsContent /></WindowDrawnDecorationsTemplate>
      </Setter>
    </ControlTheme>
  </Window.WindowDecorationsTheme>
</Window>
