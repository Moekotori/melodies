<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:Echo.Desktop.Controls">
  <Style Selector="Button.titleAction">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.titleWindow">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.titleAction icon|EchoIcon">
    <Setter Property="BaseBrush" Value="{DynamicResource EchoMuted}" />
    <Setter Property="AccentBrush" Value="{DynamicResource EchoMuted}" />
    <Setter Property="StrokeWidth" Value="1.75" />
  </Style>
  <Style Selector="Button.titleWindow icon|GlyphIcon">
    <Setter Property="StrokeWidth" Value="1.5" />
  </Style>
  <Style Selector="Button.titleAction icon|GlyphIcon">
    <Setter Property="StrokeWidth" Value="1.75" />
  </Style>
  <Style Selector="Button.titleAction:pointerover, Button.titleAction:pressed, Button.titleWindow:pointerover">
    <Setter Property="Background" Value="{DynamicResource EchoDivider}" />
  </Style>
  <Style Selector="Button.titleAction:pointerover icon|EchoIcon, Button.titleAction:focus-visible icon|EchoIcon">
    <Setter Property="BaseBrush" Value="{DynamicResource EchoHeading}" />
    <Setter Property="AccentBrush" Value="{DynamicResource EchoHeading}" />
  </Style>
  <Style Selector="Button.titleWindow:pointerover icon|GlyphIcon">
    <Setter Property="Stroke" Value="{DynamicResource EchoHeading}" />
  </Style>
  <Style Selector="Button.titleAction:pointerover icon|GlyphIcon, Button.titleAction:focus-visible icon|GlyphIcon">
    <Setter Property="Stroke" Value="{DynamicResource EchoHeading}" />
  </Style>
  <Style Selector="Button.titleWindow.close:pointerover">
    <Setter Property="Background" Value="#e5484d" />
  </Style>
  <Style Selector="Button.titleWindow.close:pointerover icon|GlyphIcon">
    <Setter Property="Stroke" Value="White" />
  </Style>
</Styles>
