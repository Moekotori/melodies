<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Shell.Sidebar" x:DataType="shell:ShellViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ChildNavigationTemplate" x:DataType="shell:NavigationItem">
      <Button Classes="nav subnav" Classes.active="{Binding IsActive}" Click="OnNavigationClicked" IsVisible="{Binding !IsHidden}" ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
        <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
          <icon:EchoIcon Kind="{Binding IconId}" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding $parent[Button].Foreground}" />
        </Grid>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="NavigationTemplate" x:DataType="shell:NavigationItem">
      <StackPanel IsVisible="{Binding IsShown}">
      <Grid Classes="navigation-row" Classes.home="{Binding IsHome}" ColumnDefinitions="Auto,*,Auto,Auto" Classes.hidden="{Binding IsHidden}">
        <Button Classes="sidebar-handle" IsVisible="{Binding IsEditing}" Width="24" Height="38" Padding="0" Cursor="SizeAll"
                PointerCaptureLost="OnGripCaptureLost" KeyDown="OnGripKeyDown"
                ToolTip.Tip="{DynamicResource sidebar.reorder}" AutomationProperties.Name="{Binding Label}">
          <icon:GlyphIcon Kind="grip" Scope="sidebar" StrokeWidth="1.25" Width="14" Height="14" />
        </Button>
      <Button Grid.Column="1" Classes="nav" Classes.active="{Binding IsActive}" Classes.editing="{Binding IsEditing}" Classes.on-path="{Binding IsOnPath}" Click="OnNavigationClicked"
              ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
        <Grid ColumnDefinitions="30,*" ColumnSpacing="7">
          <icon:EchoIcon Kind="{Binding IconId}" BaseBrush="{Binding $parent[Button].Foreground}" StrokeWidth="1.9" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding $parent[shell:Sidebar].((shell:ShellViewModel)DataContext).IsSidebarLabelVisible}" Foreground="{Binding $parent[Button].Foreground}" />
        </Grid>
      </Button>
        <Button Grid.Column="2" Classes="quiet branch-toggle" IsVisible="{Binding ShowBranchToggle}" Click="OnBranchToggle" Width="28" Height="38" MinHeight="38" Padding="0" ToolTip.Tip="{DynamicResource sidebar.branch}" AutomationProperties.Name="{DynamicResource sidebar.branch}">
          <icon:GlyphIcon Kind="{Binding BranchIcon}" Width="14" Height="14" />
        </Button>
        <Button Grid.Column="3" Classes="sidebar-eye" Classes.active="{Binding IsActive}" IsVisible="{Binding IsEditing}" Width="30" Height="38" Padding="0"
                Command="{Binding $parent[shell:Sidebar].((shell:ShellViewModel)DataContext).ToggleNavigationVisibilityCommand}" CommandParameter="{Binding}"
                ToolTip.Tip="{DynamicResource sidebar.visibility}" AutomationProperties.Name="{Binding Label}">
          <icon:GlyphIcon Kind="{Binding VisibilityIcon}" Scope="sidebar" StrokeWidth="1.25" Width="17" Height="17" Stroke="{Binding $parent[Button].Foreground}" />
        </Button>
      </Grid>
      <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding ShowChildren}" ItemTemplate="{StaticResource ChildNavigationTemplate}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.nav"><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
    <Style Selector="Button.nav.active"><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /></Style>
    <Style Selector="Button.nav.on-path"><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /></Style>
    <Style Selector="Button.nav.subnav"><Setter Property="Padding" Value="22,0,10,0" /><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" /><Setter Property="Margin" Value="0,2,0,0" /></Style>
    <Style Selector="Button.nav TextBlock"><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="Button.nav.active TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.sidebar-caption"><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Height" Value="24" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="10,0" /></Style>
    <Style Selector="Button.sidebar-eye"><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
    <Style Selector="Grid.navigation-row.hidden Button.nav"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="Grid.navigation-row.drop-target"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
    <Style Selector="Button.sidebar-eye.active"><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /></Style>
    <Style Selector="Button.nav.editing"><Setter Property="Background" Value="Transparent" /></Style>
  </UserControl.Styles>
  <Border Background="Transparent" Padding="10,14,10,6">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="{DynamicResource sidebar.edit}" Click="OnEditClicked" />
        <MenuItem Header="{DynamicResource sidebar.reset}" Click="OnResetClicked" />
      </ContextMenu>
    </Border.ContextMenu>
    <Grid RowDefinitions="36,Auto,Auto,*,Auto" RowSpacing="2">
      <Button Classes="quiet sidebar-search" Command="{Binding OpenSearchCommand}" Height="36" Padding="6,0,8,0"
              Background="{DynamicResource EchoSidebarSearch}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" CornerRadius="8"
              HorizontalContentAlignment="Stretch" ToolTip.Tip="{DynamicResource ui.TitleBar.f1c10da84402}" AutomationProperties.Name="{DynamicResource ui.TitleBar.f1c10da84402}">
        <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="7">
          <icon:GlyphIcon Kind="search" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{DynamicResource sidebar.search}" FontSize="14" VerticalAlignment="Center" IsVisible="{Binding IsSidebarLabelVisible}" />
          <Border Grid.Column="2" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" CornerRadius="4" Padding="4,1" VerticalAlignment="Center" IsVisible="{Binding IsSidebarLabelVisible}"><TextBlock Text="F4" FontSize="11" Classes="muted" /></Border>
        </Grid>
      </Button>
      <Border Grid.Row="1" IsVisible="{Binding IsSidebarEditing}" Background="{DynamicResource EchoPanelMuted}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" CornerRadius="10" Padding="7,4">
        <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="5">
          <icon:GlyphIcon Kind="grip" Scope="sidebar" StrokeWidth="1.25" Width="13" Height="13" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{DynamicResource sidebar.edit}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="2" Name="ExitEditing" Command="{Binding ExitSidebarEditingCommand}" Padding="5,0" MinHeight="26" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="3"><icon:GlyphIcon Kind="close" Scope="sidebar" StrokeWidth="1.25" Width="13" Height="13" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource sidebar.exit}" FontSize="12" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </Grid>
      </Border>
      <ContentControl Grid.Row="2" Content="{Binding HomeNavigationItem}" ContentTemplate="{StaticResource NavigationTemplate}" HorizontalContentAlignment="Stretch" />
      <ScrollViewer Name="NavigationScroll" Grid.Row="3" Margin="0,4,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2">
            <TextBlock Text="{DynamicResource ui.Sidebar.433bdcb25776}" Classes="sidebar-caption" IsVisible="{Binding IsSidebarLabelVisible}" />
            <ItemsControl Classes="library-section" ItemsSource="{Binding SidebarLibraryItems}" ItemTemplate="{StaticResource NavigationTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource ui.Sidebar.a488e93d69cc}" Classes="sidebar-caption" IsVisible="{Binding IsSidebarLabelVisible}" />
            <ItemsControl ItemsSource="{Binding SourceItems}" ItemTemplate="{StaticResource NavigationTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource ui.Sidebar.795d21bbf36d}" Classes="sidebar-caption" IsVisible="{Binding IsSidebarLabelVisible}" />
            <ItemsControl ItemsSource="{Binding PlaybackItems}" ItemTemplate="{StaticResource NavigationTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding PluginItems.Count}">
            <TextBlock Text="{DynamicResource ui.Sidebar.e806fbbe8ec6}" Classes="subtle" FontSize="11" FontWeight="SemiBold" Margin="10,0" IsVisible="{Binding IsSidebarLabelVisible}" />
            <ItemsControl ItemsSource="{Binding PluginItems}" ItemTemplate="{StaticResource NavigationTemplate}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="4" IsVisible="{Binding !IsSidebarEditing}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource EchoDivider}" Padding="0,2,0,0">
        <Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="settings" ToolTip.Tip="{DynamicResource ui.Sidebar.df3d58c7d84b}">
          <Grid ColumnDefinitions="30,*" ColumnSpacing="7">
            <icon:EchoIcon Kind="settings" BaseBrush="{DynamicResource EchoMuted}" StrokeWidth="1.9" Width="22" Height="22" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ui.Sidebar.df3d58c7d84b}" IsVisible="{Binding IsSidebarLabelVisible}" FontSize="14" Classes="muted" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </Border>
    </Grid>
  </Border>
</UserControl>
