<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Shell.Sidebar" x:DataType="shell:ShellViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="NavigationTemplate" x:DataType="shell:NavigationItem">
      <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding $parent[shell:Sidebar].((shell:ShellViewModel)DataContext).NavigateCommand}"
              CommandParameter="{Binding Id}" ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
        <Grid ColumnDefinitions="30,*" ColumnSpacing="7">
          <icon:EchoIcon Kind="{Binding Id}" Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding $parent[shell:Sidebar].((shell:ShellViewModel)DataContext).IsSidebarLabelVisible}" Foreground="{Binding $parent[Button].Foreground}" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <Border Background="{DynamicResource EchoSidebar}" Padding="10,14,10,14">
    <Grid RowDefinitions="28,*,Auto" RowSpacing="8">
      <Grid ColumnDefinitions="*,28" Margin="4,0">
        <TextBlock Text="{DynamicResource ui.Sidebar.433bdcb25776}" IsVisible="{Binding IsSidebarLabelVisible}" Classes="subtle" FontSize="11" FontWeight="SemiBold" Margin="4,7,0,0" />
        <Button Grid.Column="1" Width="28" Height="28" MinHeight="28" Padding="0" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{DynamicResource ui.Sidebar.c3d1de44037a}"><icon:GlyphIcon Kind="collapse" Width="16" Height="16" /></Button>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
          <ItemsControl ItemsSource="{Binding LibraryItems}" ItemTemplate="{StaticResource NavigationTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource ui.Sidebar.a488e93d69cc}" Classes="subtle" FontSize="11" FontWeight="SemiBold" Margin="10,0" IsVisible="{Binding IsSidebarLabelVisible}" />
            <ItemsControl ItemsSource="{Binding SourceItems}" ItemTemplate="{StaticResource NavigationTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource ui.Sidebar.795d21bbf36d}" Classes="subtle" FontSize="11" FontWeight="SemiBold" Margin="10,0" IsVisible="{Binding IsSidebarLabelVisible}" />
            <ItemsControl ItemsSource="{Binding PlaybackItems}" ItemTemplate="{StaticResource NavigationTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding PluginItems.Count}">
            <TextBlock Text="{DynamicResource ui.Sidebar.e806fbbe8ec6}" Classes="subtle" FontSize="11" FontWeight="SemiBold" Margin="10,0" IsVisible="{Binding IsSidebarLabelVisible}" />
            <ItemsControl ItemsSource="{Binding PluginItems}" ItemTemplate="{StaticResource NavigationTemplate}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource EchoDivider}" Padding="0,12,0,0">
        <Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="settings" ToolTip.Tip="{DynamicResource ui.Sidebar.df3d58c7d84b}">
          <Grid ColumnDefinitions="30,*" ColumnSpacing="7">
            <icon:EchoIcon Kind="settings" Width="25" Height="25" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ui.Sidebar.df3d58c7d84b}" IsVisible="{Binding IsSidebarLabelVisible}" FontSize="14" Classes="muted" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </Border>
    </Grid>
  </Border>
</UserControl>
