<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ControlTheme x:Key="TitleBarMenuPresenter" TargetType="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource EchoField}" />
      <Setter Property="Foreground" Value="{DynamicResource EchoText}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="176" />
      <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1"
                CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="TitleBarMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource EchoText}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Template"><ControlTemplate>
        <Border Name="RowSurface" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
            <ContentPresenter Content="{TemplateBinding Icon}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              VerticalAlignment="Center" HorizontalAlignment="Left" />
          </Grid>
        </Border>
      </ControlTemplate></Setter>
      <Style Selector="^:pointerover /template/ Border#RowSurface"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
      <Style Selector="^:selected /template/ Border#RowSurface"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
      <Style Selector="^:focus-visible /template/ Border#RowSurface"><Setter Property="BorderBrush" Value="{DynamicResource EchoFocus}" /><Setter Property="BorderThickness" Value="1" /></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    </ControlTheme>
  </Styles.Resources>
</Styles>
