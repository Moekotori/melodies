<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Shell.TitleBar" x:DataType="shell:ShellViewModel">
  <Border Background="{DynamicResource EchoTitlebar}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="0,0,0,1" Padding="16,0,10,0">
    <Grid ColumnDefinitions="220,*,Auto" PointerPressed="OnTitlePointerPressed">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="ECHO" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource EchoHeading}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
        <Button Classes="icon" Command="{Binding OpenSearchCommand}" ToolTip.Tip="{DynamicResource ui.TitleBar.00d9d5007273}"><icon:GlyphIcon Kind="search" Width="17" Height="17" /></Button>
        <Button Name="AudioDrawerButton" Classes="icon" Command="{Binding OpenQuickSettingsCommand}" CommandParameter="audio" ToolTip.Tip="{DynamicResource ui.TitleBar.24c267e226db}" AutomationProperties.Name="{DynamicResource ui.TitleBar.24c267e226db}"><icon:GlyphIcon Kind="headphones" Width="17" Height="17" /></Button>
        <Button Name="LyricsDrawerButton" Classes="icon" Command="{Binding OpenQuickSettingsCommand}" CommandParameter="lyrics" ToolTip.Tip="{DynamicResource ui.TitleBar.13c2f86425fa}" AutomationProperties.Name="{DynamicResource ui.TitleBar.13c2f86425fa}"><icon:EchoIcon Kind="lyrics" Scope="player" Width="22" Height="22" /></Button>
        <Button Classes="icon" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{DynamicResource ui.TitleBar.395b0181b012}"><icon:GlyphIcon Kind="moon" Width="17" Height="17" /></Button>
        <Button Classes="icon" Command="{Binding NavigateCommand}" CommandParameter="settings" ToolTip.Tip="{DynamicResource ui.Sidebar.df3d58c7d84b}"><icon:GlyphIcon Kind="settings" Width="17" Height="17" /></Button>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
        <Button Classes="window" Click="OnMinimize" ToolTip.Tip="{DynamicResource ui.TitleBar.6d1955fae43e}"><icon:GlyphIcon Kind="hide" Width="15" Height="15" /></Button>
        <Button Classes="window" Click="OnFullscreen" ToolTip.Tip="{DynamicResource ui.TitleBar.ed12b1f768c5}"><icon:GlyphIcon Kind="fullscreen" Width="15" Height="15" /></Button>
        <Button Classes="window" Click="OnMinimize" ToolTip.Tip="{DynamicResource ui.TitleBar.ac29e57a46f4}"><icon:GlyphIcon Kind="minus" Width="16" Height="16" /></Button>
        <Button Classes="window" Click="OnMaximize" ToolTip.Tip="{DynamicResource ui.TitleBar.9949b1fb5f67}"><icon:GlyphIcon Kind="maximize" Width="14" Height="14" /></Button>
        <Button Classes="window close" Click="OnClose" ToolTip.Tip="{DynamicResource ui.TitleBar.3fd47edce45b}"><icon:GlyphIcon Kind="close" Width="16" Height="16" /></Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
