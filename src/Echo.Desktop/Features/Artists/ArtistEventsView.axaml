<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:artists="using:Echo.Desktop.Features.Artists" xmlns:library="using:Echo.Contracts.Library"
             x:Class="Echo.Desktop.Features.Artists.ArtistEventsView" x:DataType="artists:ArtistOverviewViewModel">
  <UserControl.Styles>
    <Style Selector="Button.concert-row"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0,12" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="Button.concert-row:pointerover"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
    <Style Selector="Button.concert-row:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="BorderThickness" Value="1" /></Style>
  </UserControl.Styles>
  <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,24,0,0"><StackPanel Spacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding ConcertHeading}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" VerticalAlignment="Center" /><Button Grid.Column="1" Name="RefreshConcerts" Classes="content-link" Content="{Binding ConcertRefresh}" Command="{Binding RefreshConcertsCommand}" IsEnabled="{Binding CanRefreshConcerts}" /></Grid>
    <TextBlock Text="{Binding EventsStatus}" TextWrapping="Wrap" Foreground="{DynamicResource EchoMuted}" IsVisible="{Binding !HasEvents}" />
    <ItemsControl Name="ConcertList" ItemsSource="{Binding Concerts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="artists:ArtistConcertItem">
      <Button Classes="concert-row" Tag="{Binding Url}" Click="OnExternal" ToolTip.Tip="{Binding Url}"><Grid ColumnDefinitions="72,*,100" ColumnSpacing="18">
        <Border Background="{DynamicResource EchoHover}" CornerRadius="7" Width="64" Padding="6,8" HorizontalAlignment="Left"><StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Day}" FontSize="26" FontWeight="Medium" Foreground="{DynamicResource EchoHeading}" HorizontalAlignment="Center" /><TextBlock Text="{Binding Month}" FontSize="10" Foreground="{DynamicResource EchoMuted}" HorizontalAlignment="Center" /><TextBlock Text="{Binding Weekday}" FontSize="11" Foreground="{DynamicResource EchoMuted}" HorizontalAlignment="Center" /></StackPanel></Border>
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{Binding Venue}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource EchoMuted}" FontSize="12" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding Time}" HorizontalAlignment="Right" FontSize="13" FontWeight="Medium" /><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Source}" FontSize="12" Foreground="{DynamicResource EchoMuted}" /><TextBlock Text="↗" FontSize="13" Foreground="{DynamicResource EchoMuted}" /></StackPanel></StackPanel>
      </Grid></Button>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{DynamicResource artist.concert.stale}" FontSize="12" Foreground="{DynamicResource EchoMuted}" IsVisible="{Binding EventsAreStale}" />
    <WrapPanel><TextBlock Text="{Binding EventsChecked}" FontSize="12" Foreground="{DynamicResource EchoMuted}" Margin="0,0,18,4" IsVisible="{Binding EventsChecked, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" /><TextBlock Text="{Binding ConcertFailures}" FontSize="12" Foreground="{DynamicResource EchoMuted}" TextWrapping="Wrap" Margin="0,0,0,4" IsVisible="{Binding ConcertFailures, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" /></WrapPanel>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"><TextBlock Text="{DynamicResource artist.concert.moreSources}" FontSize="12" Foreground="{DynamicResource EchoMuted}" VerticalAlignment="Top" Margin="0,6,0,0" /><ItemsControl Grid.Column="1" ItemsSource="{Binding EventSources}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="library:ArtistLink"><Button Classes="content-link" Content="{Binding Label}" Tag="{Binding Url}" Click="OnExternal" Margin="0,0,16,0" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
  </StackPanel></Border>
</UserControl>
