<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:filters="using:Echo.Desktop.Features.LibraryDetails" xmlns:artists="using:Echo.Desktop.Features.Artists" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Artists.ArtistsView" x:DataType="artists:ArtistsViewModel">
  <Grid>
    <Grid Name="Wall" RowDefinitions="Auto,Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
        <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="{DynamicResource navigation.artists}" Classes="heading" FontSize="30" FontStyle="Normal" /><TextBlock Text="{Binding CountText}" Classes="muted" FontSize="13" VerticalAlignment="Center" /></StackPanel>
        <Button Grid.Column="1" Classes="icon" Click="OnRefresh" ToolTip.Tip="{DynamicResource ui.ArtistsView.ab75473d030d}"><icon:GlyphIcon Kind="refresh" Width="18" Height="18" /></Button>
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,20">
        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="120">
          <icon:GlyphIcon Kind="search" Width="18" Height="18" Margin="12,0" ZIndex="1" />
          <TextBox Name="SearchField" Grid.ColumnSpan="3" Text="{Binding Search, Mode=TwoWay}" MaxLength="128" PlaceholderText="{DynamicResource ui.ArtistsView.055fa6a68ccc}" Padding="40,10,60,10" CornerRadius="6" Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource EchoBorder}" KeyDown="OnSearchKey" />
          <Button Grid.Column="2" Classes="icon" Content="×" Click="OnClearSearch" ToolTip.Tip="{DynamicResource ui.AlbumsView.b6f00afa6537}" Margin="8,0" IsVisible="{Binding Search, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
        <Button Grid.Column="1" ToolTip.Tip="{DynamicResource ui.ArtistsView.87677e5f4c34}">
          <StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="settings" Width="16" Height="16" /><TextBlock Text="{DynamicResource ui.ArtistsView.1c5c06713870}" FontSize="13" /><TextBlock Text="⌄" /></StackPanel>
          <Button.Flyout><Flyout><StackPanel Spacing="14" Width="300">
            <TextBlock Text="{DynamicResource ui.ArtistsView.f2344901f5da}" FontWeight="SemiBold" />
            <ComboBox SelectedIndex="{Binding GroupingIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBoxItem Content="{DynamicResource ui.ArtistsView.32bbcd7bc477}" /><ComboBoxItem Content="{DynamicResource ui.ArtistsView.0e33112c349c}" /></ComboBox>
            <TextBlock Text="{DynamicResource ui.ArtistsView.ae62c2d8debf}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <Border Height="1" Background="{DynamicResource EchoDivider}" /><CheckBox Content="{DynamicResource ui.ArtistsView.4aafb1059a20}" IsChecked="{Binding ShowAlbumArtwork, Mode=TwoWay}" />
          </StackPanel></Flyout></Button.Flyout>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <ComboBox SelectedIndex="{Binding SortIndex, Mode=TwoWay}" MinWidth="120" VerticalAlignment="Center"><ComboBoxItem Content="{DynamicResource ui.ArtistsView.41a3f13a9f2d}" /><ComboBoxItem Content="{DynamicResource ui.AlbumsView.cfc309de0941}" /><ComboBoxItem Content="{DynamicResource ui.ArtistsView.53fb961b056f}" /><ComboBoxItem Content="{DynamicResource ui.AlbumsView.3411b4e3fafc}" /></ComboBox>
          <ToggleButton IsChecked="{Binding Descending, Mode=TwoWay}" Content="↓" ToolTip.Tip="{DynamicResource ui.AlbumsView.b40514e8597f}" Width="32" />
        </StackPanel>
      </Grid>
      <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="{DynamicResource EchoAccentText}" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Grid Grid.Row="3">
        <ContentControl Name="ViewportHost" />
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><TextBlock Text="{DynamicResource ui.ArtistsView.4330d888dc83}" Classes="heading" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="{DynamicResource ui.ArtistsView.132258d9e02d}" Classes="muted" FontSize="13" /><Button Content="{DynamicResource ui.AlbumsView.b6f00afa6537}" Click="OnClearSearch" HorizontalAlignment="Center" /></StackPanel>
      </Grid>
    </Grid>
    <ContentControl Name="DetailHost" IsVisible="False" />
  </Grid>
</UserControl>
