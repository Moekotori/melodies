<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:artists="using:Echo.Desktop.Features.Artists" xmlns:library="using:Echo.Contracts.Library"
             x:Class="Echo.Desktop.Features.Artists.ArtistFactsView" x:DataType="artists:ArtistOverviewViewModel">
  <StackPanel Spacing="18">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{DynamicResource artist.detail.profile}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" VerticalAlignment="Center" ToolTip.Tip="{Binding FactsMatch}" /><Button Grid.Column="1" Classes="content-link" Padding="0,6" Content="{Binding FactsAction}" Command="{Binding LoadFactsCommand}" IsEnabled="{Binding CanLoadFacts}" ToolTip.Tip="{DynamicResource artist.content.factsHint}" /></Grid>
    <ItemsControl Name="BasicFacts" ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="library:ArtistFact"><StackPanel Spacing="6" Margin="0,0,16,14"><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource EchoMuted}" TextWrapping="Wrap" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Spacing="12" IsVisible="{Binding PublicFacts, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="4" IsVisible="{Binding Aliases, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="{DynamicResource artist.content.aliases}" FontSize="12" Foreground="{DynamicResource EchoMuted}" /><TextBlock Text="{Binding Aliases}" TextWrapping="Wrap" /></StackPanel>
      <ItemsControl Name="PublicFactsGrid" ItemsSource="{Binding PublicFactRows}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="library:ArtistFact"><StackPanel Spacing="6" Margin="0,0,16,14"><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource EchoMuted}" TextWrapping="Wrap" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl Name="PublicMembersGrid" ItemsSource="{Binding PublicMembers}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="library:ArtistOnlineRelation"><StackPanel Spacing="6" Margin="0,0,16,14"><TextBlock Text="{Binding Role}" FontSize="12" Foreground="{DynamicResource EchoMuted}" TextWrapping="Wrap" /><Button Classes="content-link" Content="{Binding Name}" Tag="{Binding Url}" Click="OnExternal" HorizontalAlignment="Left" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="12"><Button Classes="content-link" Content="{DynamicResource artist.content.viewFactsSource}" Tag="{Binding PublicFacts.Url}" Click="OnExternal" HorizontalAlignment="Left" /><TextBlock Text="Wikidata · CC0" Foreground="{DynamicResource EchoMuted}" FontSize="12" VerticalAlignment="Center" /></StackPanel>
    </StackPanel>
    <TextBlock Text="{DynamicResource artist.content.noFacts}" IsVisible="{Binding NoPublicFacts}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource EchoMuted}" />
    <TextBlock Text="{Binding FactsError}" IsVisible="{Binding FactsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource EchoAccentText}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
