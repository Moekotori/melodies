<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:library="using:Echo.Contracts.Library" xmlns:icon="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Home.HomeArtistRow" x:DataType="library:ListeningArtist">
 <Button Classes="quiet" Click="OnOpen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,10" CornerRadius="0">
  <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="10">
   <TextBlock Name="Rank" Classes="muted" FontSize="12" VerticalAlignment="Center" />
   <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Name}" Classes="heading" FontSize="14" TextTrimming="CharacterEllipsis" /><TextBlock Name="Count" Classes="muted" FontSize="12" /></StackPanel>
   <icon:GlyphIcon Grid.Column="2" Kind="chevron-right" Width="14" Height="14" VerticalAlignment="Center" />
  </Grid>
 </Button>
</UserControl>
