<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="using:Echo.Desktop.Features.Home" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Home.LibraryOverview" x:DataType="home:HomeViewModel">
  <UserControl.Styles><Style Selector="Button.metric"><Setter Property="Background" Value="{DynamicResource EchoPanelMuted}" /><Setter Property="Padding" Value="24,18" /><Setter Property="CornerRadius" Value="3" /></Style></UserControl.Styles><UniformGrid Name="Tiles" Columns="4" Rows="1" Margin="-8,0">
    <Button Classes="metric" Margin="8,0" Command="{Binding Shell.NavigateCommand}" CommandParameter="artists"><StackPanel Orientation="Horizontal" Spacing="16"><icon:GlyphIcon Kind="users" Stroke="{DynamicResource EchoHeading}" StrokeWidth="1.35" Width="36" Height="36" VerticalAlignment="Center" /><StackPanel Spacing="6"><TextBlock Text="{Binding ArtistCount}" Classes="heading" FontSize="24" /><TextBlock Text="{DynamicResource ui.AlbumsView.8104520f6e69}" Classes="muted" FontSize="13" /></StackPanel></StackPanel></Button>
    <Button Classes="metric" Margin="8,0" Command="{Binding Shell.NavigateCommand}" CommandParameter="albums"><StackPanel Orientation="Horizontal" Spacing="16"><icon:GlyphIcon Kind="disc" Stroke="{DynamicResource EchoHeading}" StrokeWidth="1.35" Width="36" Height="36" VerticalAlignment="Center" /><StackPanel Spacing="6"><TextBlock Text="{Binding AlbumCount}" Classes="heading" FontSize="24" /><TextBlock Text="{DynamicResource ui.AlbumsView.9e070772b185}" Classes="muted" FontSize="13" /></StackPanel></StackPanel></Button>
    <Button Classes="metric" Margin="8,0" Command="{Binding Shell.NavigateCommand}" CommandParameter="songs"><StackPanel Orientation="Horizontal" Spacing="16"><icon:GlyphIcon Kind="music-stat" Stroke="{DynamicResource EchoHeading}" StrokeWidth="0.96" Width="36" Height="36" VerticalAlignment="Center" /><StackPanel Spacing="6"><TextBlock Text="{Binding TrackCount}" Classes="heading" FontSize="24" /><TextBlock Text="{DynamicResource ui.AlbumDetailView.739ed1896dcd}" Classes="muted" FontSize="13" /></StackPanel></StackPanel></Button>
    <Button Classes="metric" Margin="8,0" Command="{Binding Shell.NavigateCommand}" CommandParameter="folders"><StackPanel Orientation="Horizontal" Spacing="16"><icon:GlyphIcon Kind="folder" Stroke="{DynamicResource EchoHeading}" StrokeWidth="1.35" Width="36" Height="36" VerticalAlignment="Center" /><StackPanel Spacing="6"><TextBlock Text="{Binding FolderCount}" Classes="heading" FontSize="24" /><TextBlock Text="{DynamicResource ui.LibraryOverview.7c7802d8adae}" Classes="muted" FontSize="13" /></StackPanel></StackPanel></Button>
  </UniformGrid>
</UserControl>
