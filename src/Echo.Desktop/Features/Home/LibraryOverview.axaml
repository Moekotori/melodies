<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Home.LibraryOverview" x:DataType="shell:ShellViewModel">
  <UniformGrid Columns="4" Rows="1">
    <Button Classes="metric" Margin="0,0,12,0" Command="{Binding NavigateCommand}" CommandParameter="artists"><StackPanel Orientation="Horizontal" Spacing="16"><icon:GlyphIcon Kind="users" Stroke="{DynamicResource EchoHeading}" StrokeWidth="1.35" Width="36" Height="36" VerticalAlignment="Center" /><StackPanel Spacing="6"><TextBlock Text="0" Classes="heading" FontSize="28" /><TextBlock Text="艺术家" Classes="muted" FontSize="13" /></StackPanel></StackPanel></Button>
    <Button Classes="metric" Margin="4,0,8,0" Command="{Binding NavigateCommand}" CommandParameter="albums"><StackPanel Orientation="Horizontal" Spacing="16"><icon:GlyphIcon Kind="disc" Stroke="{DynamicResource EchoHeading}" StrokeWidth="1.35" Width="36" Height="36" VerticalAlignment="Center" /><StackPanel Spacing="6"><TextBlock Text="0" Classes="heading" FontSize="28" /><TextBlock Text="专辑" Classes="muted" FontSize="13" /></StackPanel></StackPanel></Button>
    <Button Classes="metric" Margin="8,0,4,0" Command="{Binding NavigateCommand}" CommandParameter="songs"><StackPanel Orientation="Horizontal" Spacing="16"><icon:GlyphIcon Kind="music-stat" Stroke="{DynamicResource EchoHeading}" StrokeWidth="0.96" Width="36" Height="36" VerticalAlignment="Center" /><StackPanel Spacing="6"><TextBlock Text="0" Classes="heading" FontSize="28" /><TextBlock Text="曲目" Classes="muted" FontSize="13" /></StackPanel></StackPanel></Button>
    <Button Classes="metric" Margin="12,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="folders"><StackPanel Orientation="Horizontal" Spacing="16"><icon:GlyphIcon Kind="folder" Stroke="{DynamicResource EchoHeading}" StrokeWidth="1.35" Width="36" Height="36" VerticalAlignment="Center" /><StackPanel Spacing="6"><TextBlock Text="0" Classes="heading" FontSize="28" /><TextBlock Text="文件夹" Classes="muted" FontSize="13" /></StackPanel></StackPanel></Button>
  </UniformGrid>
</UserControl>

