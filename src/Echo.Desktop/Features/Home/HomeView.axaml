<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="using:Echo.Desktop.Features.Home" xmlns:icon="using:Echo.Desktop.Controls" xmlns:motion="using:Echo.Desktop.Motion"
             x:Class="Echo.Desktop.Features.Home.HomeView" x:DataType="home:HomeViewModel">
 <Grid>
  <StackPanel Name="HomeContent" MaxWidth="1200" HorizontalAlignment="Stretch" Spacing="22" Margin="12,12,12,28">
    <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,0,1" Padding="0,0,0,20">
      <Grid Name="HeroGrid" ColumnDefinitions="280,*" ColumnSpacing="26" MinHeight="280">
        <Border Name="HeroArtwork" Width="280" Height="280" Background="{DynamicResource EchoPlaceholder}" CornerRadius="{DynamicResource EchoCoverRadius}" ClipToBounds="True"><Grid>
          <Image Source="{DynamicResource EchoPlaceholderImage}" Stretch="UniformToFill" />
          <Image Name="FocusCover" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Grid></Border>
        <StackPanel Name="HeroCopy" Grid.Column="1" Spacing="12" VerticalAlignment="Top">
          <TextBlock LineHeight="18" Text="{Binding HeroLabel}" Foreground="{DynamicResource EchoAccentText}" FontSize="12" FontWeight="SemiBold" />
          <StackPanel Spacing="6">
            <TextBlock Name="HeroTitle" Text="{Binding FocusTitle}" Classes="heading" FontSize="38" LineHeight="44" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FocusTitle}" />
            <WrapPanel>
              <Button Classes="content-link" MinHeight="19" Padding="0" Command="{Binding OpenArtistCommand}" CommandParameter="{Binding FocusArtist}" IsVisible="{Binding HasFocus}"><TextBlock Text="{Binding FocusArtist}" Classes="muted" FontSize="14" /></Button>
              <TextBlock Text=" · " Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasFocus}" />
              <Button Classes="content-link" MinHeight="19" Padding="0" Command="{Binding OpenFocusAlbumCommand}" IsVisible="{Binding HasFocus}"><TextBlock Text="{Binding FocusAlbum}" Classes="muted" FontSize="14" /></Button>
              <TextBlock Text="{DynamicResource ui.HomeView.fabc693887a2}" Classes="muted" FontSize="14" IsVisible="{Binding !HasFocus}" />
            </WrapPanel>
          </StackPanel>
          <TextBlock Text="{DynamicResource ui.HomeView.5550d47bf79d}" FontSize="13" Classes="muted" LineHeight="22" TextWrapping="Wrap" IsVisible="{Binding !HasFocus}" />
          <TextBlock Text="{Binding SourceLabel}" Classes="muted" FontSize="11" IsVisible="{Binding SourceLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <WrapPanel Orientation="Horizontal">
            <Button Name="ContinueButton" Classes="primary" Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinue}" Margin="0,8,6,0"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="play" Width="17" Height="17" Stroke="{DynamicResource EchoOnAccent}" /><TextBlock Text="{DynamicResource ui.HomeView.11a6c8e68b59}" /></StackPanel></Button>
            <Button Classes="quiet" Command="{Binding Shell.NavigateCommand}" CommandParameter="queue" Margin="0,8,6,0"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="queue" Width="17" Height="17" /><TextBlock Classes="muted" Text="{DynamicResource ui.HomeView.f9c57473d6a0}" FontSize="13" /></StackPanel></Button>
            <Button Name="RefreshButton" Classes="quiet" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" Margin="0,8,6,0"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="refresh" Width="17" Height="17" /><TextBlock Classes="muted" Text="{DynamicResource ui.HomeView.aee887434131}" FontSize="13" /></StackPanel></Button>
            <Button Name="RandomButton" Classes="quiet" Command="{Binding RandomCommand}" IsEnabled="{Binding CanRandom}" Margin="0,8,0,0"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="shuffle" Width="17" Height="17" /><TextBlock Classes="muted" Text="{DynamicResource ui.HomeView.41fd818df70c}" FontSize="13" /></StackPanel></Button>
          </WrapPanel>
          <TextBlock Text="{Binding Specifications}" Classes="muted" FontSize="10" />
          <home:HomeNowLyrics />
          <icon:LiveSpectrumView Spectrum="{Binding Shell.AppearanceVisuals.LiveSpectrum}" IsVisible="{Binding Shell.AppearanceVisuals.HomeWaveform}" Brush="{DynamicResource EchoAccent}" Height="48" IsHitTestVisible="False" />
          <TextBlock Text="{Binding Shell.AppearanceVisuals.LiveStatus}" IsVisible="{Binding Shell.AppearanceVisuals.HomeWaveform}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
    <home:LibraryOverview Name="LibraryMetrics" />
    <Grid ColumnDefinitions="*,232" ColumnSpacing="32" Name="DiscoveryGrid">
      <StackPanel Spacing="24">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource ui.HomeView.41f5cada11ed}" Classes="heading" FontSize="18" VerticalAlignment="Center" Margin="0,0,20,0" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="tab" Name="PlayedTab" Content="{DynamicResource ui.HomeView.29487acd3e7a}" FontSize="13.5" Command="{Binding Shell.SetRecentTabCommand}" CommandParameter="played" />
                <Button Classes="tab" Name="AddedTab" Content="{DynamicResource ui.AlbumDetailView.76d76ed548a8}" FontSize="13.5" Command="{Binding Shell.SetRecentTabCommand}" CommandParameter="added" />
              </StackPanel>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Name="PreviousRecentButton" Classes="icon" Command="{Binding PreviousRecentCommand}" IsEnabled="{Binding CanPrevious}" ToolTip.Tip="{DynamicResource home.previous}"><icon:GlyphIcon Kind="chevron-left" Width="15" Height="15" /></Button>
              <Button Name="NextRecentButton" Classes="icon" Command="{Binding NextRecentCommand}" IsEnabled="{Binding CanNext}" ToolTip.Tip="{DynamicResource home.next}"><icon:GlyphIcon Kind="chevron-right" Width="15" Height="15" /></Button>
              <Button Classes="icon" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="{DynamicResource ui.HomeView.aee887434131}"><icon:GlyphIcon Kind="refresh" Width="15" Height="15" /></Button>
            </StackPanel>
          </Grid>
          <motion:MotionPresenter Name="RecentHost" MinHeight="160" />
        </StackPanel>
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource ui.HomeView.1795a8edfa43}" Classes="heading" FontSize="18" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="quiet" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="refresh" Width="15" Height="15" /><TextBlock Text="{DynamicResource ui.HomeView.aee887434131}" Classes="muted" FontSize="13" /></StackPanel></Button>
          </Grid>
          <ContentControl Name="RecommendationsHost" HorizontalContentAlignment="Stretch" />
        </StackPanel>
        <StackPanel Spacing="16" IsVisible="{Binding HasRediscovery}">
          <TextBlock Text="{DynamicResource home.rediscovery}" Classes="heading" FontSize="18" />
          <ContentControl Name="RediscoveryHost" HorizontalContentAlignment="Stretch" />
        </StackPanel>
      </StackPanel>
      <home:ListeningOverview Name="ListeningSidebar" Grid.Column="1" />
    </Grid>
    <home:HomeInsightsView Name="Insights" />
    <StackPanel HorizontalAlignment="Center" Spacing="8">
      <TextBlock Text="{DynamicResource home.loading}" IsVisible="{Binding IsLoading}" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource EchoAccentText}" HorizontalAlignment="Center" />
    </StackPanel>
  </StackPanel>
  <ContentControl Name="DetailHost" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
 </Grid>
</UserControl>
