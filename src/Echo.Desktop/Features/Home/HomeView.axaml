<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:home="using:Echo.Desktop.Features.Home" xmlns:icon="using:Echo.Desktop.Controls"
             xmlns:motion="using:Echo.Desktop.Motion"
             x:Class="Echo.Desktop.Features.Home.HomeView" x:DataType="shell:ShellViewModel">
  <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Spacing="22" Margin="12,12,12,28">
    <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,0,1" Padding="0,0,0,20">
      <Grid ColumnDefinitions="280,*" ColumnSpacing="26" MinHeight="280">
        <Border Width="280" Height="280" Background="{DynamicResource EchoPlaceholder}" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="1">
          <Image Source="{DynamicResource EchoPlaceholderImage}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Top">
          <TextBlock Text="从你的音乐库开始播放。" Foreground="{DynamicResource EchoAccentText}" FontSize="12" FontWeight="SemiBold" />
          <StackPanel Spacing="6">
            <TextBlock Text="暂无播放" Classes="heading" FontSize="35.6" LineHeight="41.3" />
            <TextBlock Text="曲库准备好后会显示最近内容" Classes="muted" FontSize="14" />
          </StackPanel>
          <TextBlock Text="导入音乐后，这里会变成你的曲库入口、最近播放和本周聆听脉冲。" FontSize="13" Classes="muted" LineHeight="22" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary" IsEnabled="False" Margin="0,8,6,0"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="play" Width="17" Height="17" Stroke="White" /><TextBlock Text="继续播放" /></StackPanel></Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="queue" Margin="0,8,6,0"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="queue" Width="17" Height="17" /><TextBlock Classes="muted" Text="查看队列" FontSize="13" /></StackPanel></Button>
            <Button Command="{Binding ShowPendingCommand}" CommandParameter="曲库刷新" Margin="0,8,6,0"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="refresh" Width="17" Height="17" /><TextBlock Classes="muted" Text="刷新" FontSize="13" /></StackPanel></Button>
            <Button IsEnabled="False" Margin="0,8,0,0"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="shuffle" Width="17" Height="17" /><TextBlock Classes="muted" Text="生成随机队列" FontSize="13" /></StackPanel></Button>
          </WrapPanel>
        </StackPanel>
      </Grid>
    </Border>
    <home:LibraryOverview />
    <Grid ColumnDefinitions="*,232" ColumnSpacing="32" Name="DiscoveryGrid">
      <StackPanel Spacing="24">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
              <TextBlock Text="最近活动" Classes="heading" FontSize="18" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="tab" Name="PlayedTab" Content="已播放" FontSize="13.5" Command="{Binding SetRecentTabCommand}" CommandParameter="played" />
                <Button Classes="tab" Name="AddedTab" Content="添加于" FontSize="13.5" Command="{Binding SetRecentTabCommand}" CommandParameter="added" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button Classes="icon" IsEnabled="False"><icon:GlyphIcon Kind="chevron-left" Width="15" Height="15" /></Button>
              <Button Classes="icon" IsEnabled="False"><icon:GlyphIcon Kind="chevron-right" Width="15" Height="15" /></Button>
              <Button Classes="icon" Command="{Binding ShowPendingCommand}" CommandParameter="最近播放刷新" ToolTip.Tip="刷新"><icon:GlyphIcon Kind="refresh" Width="15" Height="15" /></Button>
            </StackPanel>
          </Grid>
          <motion:MotionPresenter Name="RecentHost" MinHeight="160" />
        </StackPanel>
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="为你推荐" Classes="heading" FontSize="18" VerticalAlignment="Center" />
            <Button Grid.Column="1" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="refresh" Width="15" Height="15" /><TextBlock Text="刷新" Classes="muted" FontSize="13" /></StackPanel></Button>
          </Grid>
          <Border MinHeight="132" Padding="24">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <icon:GlyphIcon Kind="album" Width="24" Height="24" HorizontalAlignment="Center" />
              <TextBlock Text="还没有可推荐专辑" Classes="heading" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" />
              <TextBlock Text="导入专辑后，这里会直接铺满你的专辑。" Classes="muted" FontSize="13" TextAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
      <home:ListeningOverview Grid.Column="1" />
    </Grid>
  </StackPanel>
</UserControl>
