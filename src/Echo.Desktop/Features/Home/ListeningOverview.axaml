<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="using:Echo.Desktop.Features.Home" xmlns:library="using:Echo.Contracts.Library" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Home.ListeningOverview" x:DataType="home:HomeViewModel">
  <StackPanel Spacing="24">
    <StackPanel Spacing="16">
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource EchoDivider}" Padding="0,0,0,10">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource home.thisWeek}" Classes="heading" FontSize="16" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="quiet" Content="{DynamicResource ui.ListeningOverview.b0385cfe4b42}" Command="{Binding Shell.NavigateCommand}" CommandParameter="history" FontSize="12" /></Grid>
      </Border>
      <Grid ColumnDefinitions="*,*">
        <StackPanel Spacing="4"><TextBlock Text="{DynamicResource ui.ListeningOverview.7f86543bdd77}" Classes="muted" FontSize="12" /><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding WeekPlays}" FontSize="19" Classes="heading" FontWeight="Medium" /><TextBlock Text="{DynamicResource ui.ListeningOverview.172fb7e67b9b}" Classes="muted" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,4" /></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{DynamicResource ui.ListeningOverview.4af4c8a6ccc8}" Classes="muted" FontSize="12" /><TextBlock Text="{Binding WeekDuration}" FontSize="19" Classes="heading" FontWeight="Medium" /></StackPanel>
      </Grid>
      <StackPanel Spacing="7">
        <TextBlock Name="MonthLabels" FontSize="10" Classes="subtle" Margin="20,0,0,0" />
        <Grid Height="116">
          <icon:ListeningHeatmap Name="Heatmap" Height="116" CellBrush="{DynamicResource EchoPanelMuted}" AccentBrush="{DynamicResource EchoAccent}" />
          <Canvas IsHitTestVisible="False"><TextBlock Text="{DynamicResource ui.ListeningOverview.51a75f4634df}" FontSize="10" Classes="subtle" Canvas.Left="3" Canvas.Top="1" /><TextBlock Text="{DynamicResource ui.ListeningOverview.a4c3313deb18}" FontSize="10" Classes="subtle" Canvas.Left="3" Canvas.Top="35" /><TextBlock Text="{DynamicResource ui.ListeningOverview.c9b87f516a38}" FontSize="10" Classes="subtle" Canvas.Left="3" Canvas.Top="69" /></Canvas>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ActiveWeeks}" FontSize="10" Classes="subtle" />
          <UniformGrid Grid.Column="1" Columns="5" Rows="1" Width="86" Height="14"><Border Background="{DynamicResource EchoPanelMuted}" Margin="1,0" /><Border Background="{DynamicResource EchoAccent}" Opacity="0.18" Margin="1,0" /><Border Background="{DynamicResource EchoAccent}" Opacity="0.36" Margin="1,0" /><Border Background="{DynamicResource EchoAccent}" Opacity="0.65" Margin="1,0" /><Border Background="{DynamicResource EchoAccent}" Margin="1,0" /></UniformGrid>
        </Grid>
      </StackPanel>
      <TextBlock Text="{DynamicResource ui.ListeningOverview.fa92e6441c6f}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasListening}" />
    </StackPanel>
    <StackPanel Spacing="16">
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource EchoDivider}" Padding="0,0,0,10"><TextBlock Text="{DynamicResource ui.ListeningOverview.7817196f39a2}" Classes="heading" FontSize="16" /></Border>
      <ItemsControl ItemsSource="{Binding TopArtists}" IsVisible="{Binding HasListening}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="library:ListeningArtist">
          <home:HomeArtistRow />
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Spacing="8" Margin="0,12" IsVisible="{Binding !HasListening}">
        <TextBlock Text="{DynamicResource ui.ListeningOverview.22daf6f8085c}" Classes="heading" FontWeight="Medium" FontSize="13" />
        <TextBlock Text="{DynamicResource ui.ListeningOverview.96f73169e806}" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
