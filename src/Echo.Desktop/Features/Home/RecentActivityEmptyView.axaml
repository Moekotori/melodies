<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Home.RecentActivityEmptyView">
  <Border MinHeight="128" Padding="20">
    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
      <icon:GlyphIcon Name="EmptyIcon" Kind="history" Width="24" Height="24" HorizontalAlignment="Center" />
      <TextBlock Name="EmptyTitle" FontSize="14" Classes="heading" FontWeight="Medium" HorizontalAlignment="Center" />
      <TextBlock Name="EmptyDescription" Classes="muted" FontSize="13" MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
