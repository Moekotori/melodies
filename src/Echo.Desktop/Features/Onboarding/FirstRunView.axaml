<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Onboarding" xmlns:icon="using:Echo.Desktop.Controls"
             xmlns:loc="using:Echo.Desktop.Localization" xmlns:playback="using:Echo.Playback"
             x:Class="Echo.Desktop.Features.Onboarding.FirstRunView" x:DataType="local:FirstRunViewModel"
             KeyboardNavigation.TabNavigation="Cycle" Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button.phase"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="14,12" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="Button.phase.active"><Setter Property="Background" Value="{DynamicResource EchoField}" /><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /></Style>
    <Style Selector="TextBlock.note"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="23" /></Style>
    <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="44" /></Style>
  </UserControl.Styles>
      <Grid ColumnDefinitions="250,*" Name="WizardLayout" Background="{DynamicResource EchoField}">
        <Border Name="Journey" Background="{DynamicResource EchoPageContent}" Padding="24,30" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12"><Image Source="/Resources/Icons/echo-app.ico" Width="32" Height="32" /><TextBlock Text="melodies" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
            <StackPanel Grid.Row="1" Spacing="10" Margin="0,32,0,28">
              <TextBlock Text="{DynamicResource onboarding.welcome}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource onboarding.intro}" Classes="note" />
            </StackPanel>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Phases}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:OnboardingPhase">
                <Button Classes="phase" Classes.active="{Binding Active}" Command="{Binding $parent[local:FirstRunView].((local:FirstRunViewModel)DataContext).SelectPhaseCommand}" CommandParameter="{Binding Index}" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="24,*" ColumnSpacing="12"><icon:GlyphIcon Kind="{Binding Icon}" Width="19" Height="19" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" /></Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="3" Text="{DynamicResource onboarding.changeLater}" Classes="note" />
          </Grid>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="36,30" Name="Stage">
          <StackPanel Spacing="14" Margin="0,0,0,24">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource onboarding.label}" Foreground="{DynamicResource EchoAccentText}" FontSize="12" LetterSpacing="1" /><TextBlock Grid.Column="1" Text="{Binding Counter}" Classes="muted" FontSize="12" /></Grid>
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3" MinHeight="3" />
            <TextBlock Name="Heading" Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Focusable="True" />
            <TextBlock Text="{Binding Description}" Classes="note" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" Name="StepScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" Margin="0,0,4,20" IsEnabled="{Binding !IsBusy}">
              <StackPanel IsVisible="{Binding IsLanguage}" Spacing="16">
                <TextBlock Text="{DynamicResource onboarding.language}" FontSize="14" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource onboarding.language}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="loc:LanguageChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Border Background="{DynamicResource EchoField}" CornerRadius="10" Padding="20"><StackPanel Spacing="8"><TextBlock Text="{DynamicResource ui.FirstRunView.e30c8969ebcc}" FontSize="22" /><TextBlock Text="Start with your first song." Classes="note" /></StackPanel></Border>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsAudio}" Spacing="14">
                <TextBlock Text="{DynamicResource onboarding.audio.mode}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Audio.Modes}" SelectedItem="{Binding Audio.SelectedMode, Mode=TwoWay}" IsEnabled="{Binding !Audio.IsLoading}" AutomationProperties.Name="{DynamicResource onboarding.audio.mode}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputMode"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{DynamicResource onboarding.audio.device}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Audio.Devices}" SelectedItem="{Binding Audio.SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding !Audio.IsLoading}" AutomationProperties.Name="{DynamicResource onboarding.audio.device}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputDevice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{DynamicResource onboarding.audio.refresh}" Command="{Binding Audio.RefreshCommand}" IsEnabled="{Binding !Audio.IsLoading}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Audio.IsLoading}" Height="3" MinHeight="3" />
                <TextBlock Text="{Binding Audio.Error}" Foreground="{DynamicResource EchoAccentText}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource onboarding.audio.hint}" Classes="note" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsAppearance}" Spacing="16">
                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource onboarding.phase.2}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="local:OnboardingChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ThemeVariantScope Name="ThemePreview">
                <Border CornerRadius="12" Padding="24" Background="{DynamicResource EchoPage}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1">
                  <StackPanel Spacing="14"><icon:GlyphIcon Kind="music" Width="36" Height="36" HorizontalAlignment="Left" /><TextBlock Text="melodies" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource onboarding.appearance.preview}" Classes="note" /><Border Height="4" Width="140" HorizontalAlignment="Left" Background="{DynamicResource EchoAccent}" CornerRadius="2" /></StackPanel>
                </Border>
                </ThemeVariantScope>
                <TextBlock Text="{DynamicResource onboarding.appearance.keep}" Classes="note" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsDaily}" Spacing="18">
                <ItemsControl ItemsSource="{Binding Shortcuts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:OnboardingShortcut">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBlock Text="{Binding Title}" VerticalAlignment="Center" /><Border Grid.Column="1" Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" CornerRadius="5" Padding="12,7"><TextBlock Text="{Binding Key}" FontSize="12" /></Border></Grid>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{DynamicResource onboarding.daily.hint}" Classes="note" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsSummary}" Spacing="18">
                <Border Background="{DynamicResource EchoField}" CornerRadius="10" Padding="20"><StackPanel Spacing="12">
                  <TextBlock Text="{Binding LanguageSummary}" FontWeight="SemiBold" /><TextBlock Text="{Binding ThemeSummary}" /><TextBlock Text="{Binding AudioSummary}" TextWrapping="Wrap" />
                </StackPanel></Border>
                <CheckBox Content="{DynamicResource onboarding.tourAfter}" IsChecked="{Binding StartTour, Mode=TwoWay}" />
                <TextBlock Text="{DynamicResource onboarding.summary.hint}" Classes="note" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="12">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource EchoAccentText}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
              <Button Content="{DynamicResource onboarding.skipSetup}" Command="{Binding SkipCommand}" IsEnabled="{Binding !IsBusy}" />
              <Button Grid.Column="2" Content="{DynamicResource onboarding.back}" Command="{Binding BackCommand}" IsEnabled="{Binding CanBack}" />
              <Button Grid.Column="3" Name="NextButton" Classes="primary" Content="{Binding NextLabel}" Command="{Binding NextCommand}" IsEnabled="{Binding !IsBusy}" MinWidth="96" />
            </Grid>
          </StackPanel>
        </Grid>
      </Grid>
</UserControl>
