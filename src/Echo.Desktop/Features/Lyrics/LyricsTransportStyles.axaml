<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icon="using:Echo.Desktop.Controls" xmlns:lyrics="using:Echo.Desktop.Controls.Lyrics">
  <Styles.Resources>
    <ControlTheme x:Key="LyricsRailButton" TargetType="RepeatButton">
      <Setter Property="Template"><ControlTemplate><Grid Background="Transparent"><Border Background="{TemplateBinding Background}" Height="2" CornerRadius="1" VerticalAlignment="Center" /></Grid></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="LyricsRailThumb" TargetType="Thumb">
      <Setter Property="Template"><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="LyricsRailTheme" TargetType="Slider">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Template"><ControlTemplate><Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid Background="Transparent">
        <Border Name="RailBase" Height="2" Background="{DynamicResource LyricsRail}" CornerRadius="1" VerticalAlignment="Center" />
        <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="Horizontal">
          <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource LyricsRailButton}" Background="{DynamicResource LyricsProgress}" Focusable="False" /></Track.DecreaseButton>
          <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource LyricsRailButton}" Background="Transparent" Focusable="False" /></Track.IncreaseButton>
          <Thumb Name="thumb" Width="0" Height="28" Opacity="0" Theme="{StaticResource LyricsRailThumb}" />
        </Track>
        </Grid>
      </Border></ControlTemplate></Setter>
      <Style Selector="^:focus-visible /template/ Border#RailBase"><Setter Property="Background" Value="{DynamicResource LyricsFocusRail}" /></Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource LyricsInk}" /></Style>
  <Style Selector="TextBlock.lyric-time"><Setter Property="FontFamily" Value="{DynamicResource EchoFont}" /><Setter Property="FontFeatures" Value="tnum" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Opacity" Value="0.64" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="TextBlock.idle-time"><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="Slider.lyric-rail"><Setter Property="Theme" Value="{StaticResource LyricsRailTheme}" /></Style>
  <Style Selector="Button.lyric-control"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Foreground" Value="{DynamicResource LyricsControlInk}" /></Style>
  <Style Selector="Button.lyric-play"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.lyric-secondary"><Setter Property="Opacity" Value="0.72" /></Style>
  <Style Selector="Button.lyric-control:pointerover, Button.lyric-control:focus-visible, Button.lyric-control.active"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Button.lyric-control:pointerover /template/ Border#PART_ButtonBorder"><Setter Property="Background" Value="{DynamicResource LyricsHover}" /></Style>
  <Style Selector="Button.lyric-control:focus-visible /template/ Border#PART_ButtonBorder"><Setter Property="Background" Value="{DynamicResource LyricsHover}" /></Style>
  <Style Selector="Button.lyric-control:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
  <Style Selector="icon|EchoIcon"><Setter Property="BaseBrush" Value="{DynamicResource LyricsControlInk}" /><Setter Property="AccentBrush" Value="{DynamicResource LyricsControlInk}" /></Style>
  <Style Selector="icon|GlyphIcon"><Setter Property="Stroke" Value="{DynamicResource LyricsControlInk}" /></Style>
  <Style Selector="Button.active icon|GlyphIcon"><Setter Property="Stroke" Value="{DynamicResource LyricsProgress}" /></Style>
  <Style Selector="lyrics|LyricsTransportIcon"><Setter Property="Ink" Value="{DynamicResource LyricsControlInk}" /></Style>
  <Style Selector="Button.active lyrics|LyricsTransportIcon"><Setter Property="Ink" Value="{DynamicResource LyricsProgress}" /></Style>
  <Style Selector="UserControl.docked Button.lyric-play"><Setter Property="Background" Value="Transparent" /></Style>
</Styles>
