<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icon="using:Echo.Desktop.Controls">
  <Styles.Resources>
    <ControlTheme x:Key="LyricsMenuPresenter" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource EchoMenuFlyoutPresenter}">
      <Style Selector="^:not(:disabled)">
        <Setter Property="Background" Value="{DynamicResource LyricsChromeMenu}" />
        <Setter Property="Foreground" Value="{DynamicResource LyricsChromeInk}" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource LyricsMenuItem}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="LyricsMenuItem" TargetType="MenuItem" BasedOn="{StaticResource EchoMenuItem}">
      <Setter Property="Foreground" Value="{DynamicResource LyricsChromeInk}" />
      <Style Selector="^:selected /template/ Border#PART_LayoutRoot, ^:pointerover /template/ Border#PART_LayoutRoot, ^:focus-visible /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource LyricsChromeHover}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="Border.lyrics-tool-group">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.lyrics-chrome">
    <Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" />
    <Setter Property="Width" Value="34" /><Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource LyricsChromeInk}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.lyrics-back">
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.lyrics-window"><Setter Property="Width" Value="38" /></Style>
  <Style Selector="Button.lyrics-follow">
    <Setter Property="Width" Value="NaN" /><Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="16,0" /><Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{DynamicResource LyricsChromeSurface}" />
  </Style>
  <Style Selector="Button.lyrics-chrome TextBlock"><Setter Property="Foreground" Value="{DynamicResource LyricsChromeInk}" /></Style>
  <Style Selector="Button.lyrics-chrome icon|GlyphIcon, MenuItem.lyrics-menu icon|GlyphIcon">
    <Setter Property="Stroke" Value="{DynamicResource LyricsChromeInk}" /><Setter Property="StrokeWidth" Value="1.7" />
  </Style>
  <Style Selector="Button.lyrics-window icon|GlyphIcon"><Setter Property="StrokeWidth" Value="1.5" /></Style>
  <Style Selector="Button.lyrics-chrome:pointerover"><Setter Property="Background" Value="{DynamicResource LyricsChromeHover}" /></Style>
  <Style Selector="Button.lyrics-chrome:focus-visible"><Setter Property="Background" Value="{DynamicResource LyricsChromeHover}" /></Style>
  <Style Selector="Button.lyrics-chrome:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
  <Style Selector="Button.lyrics-close:pointerover"><Setter Property="Background" Value="#E5484D" /></Style>
  <Style Selector="Button.lyrics-close:pointerover icon|GlyphIcon"><Setter Property="Stroke" Value="White" /></Style>
</Styles>
