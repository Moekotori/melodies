<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icon="using:Echo.Desktop.Controls">
  <Style Selector="Button.lyrics-chrome">
    <Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EchoText}" />
    <Setter Property="MinHeight" Value="32" /><Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.lyrics-chrome TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoText}" /></Style>
  <Style Selector="Button.lyrics-chrome icon|GlyphIcon"><Setter Property="Stroke" Value="{DynamicResource EchoText}" /></Style>
  <Style Selector="Button.lyrics-chrome:pointerover"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
  <Style Selector="Button.lyrics-chrome:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource EchoFocus}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button.lyrics-chrome:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
</Styles>
