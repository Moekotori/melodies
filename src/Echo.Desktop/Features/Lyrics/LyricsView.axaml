<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lyrics="using:Echo.Desktop.Features.Lyrics" xmlns:controls="using:Echo.Desktop.Controls.Lyrics"
             xmlns:icon="using:Echo.Desktop.Controls" xmlns:motion="using:Echo.Desktop.Motion"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="Echo.Desktop.Features.Lyrics.LyricsView" x:DataType="lyrics:LyricsViewModel">
  <UserControl.Styles><StyleInclude Source="LyricsChromeStyles.axaml" /></UserControl.Styles>
  <ThemeVariantScope Name="ChromeTheme">
  <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">
    <controls:LyricsBackgroundSceneControl Name="BackgroundScene" Grid.RowSpan="3" IsHitTestVisible="False" />
    <controls:LyricsBackdropControl Name="Backdrop" Grid.RowSpan="3" />
    <Panel Name="LyricsStage" Grid.RowSpan="3">
      <controls:LyricsViewportControl Name="Viewport" IsVisible="{Binding Appearance.Enabled}" />
      <controls:JizuraSceneControl Name="JizuraScene" IsVisible="{Binding Appearance.Enabled}" />
      <controls:SourceLyricsSceneControl Name="SourceScene" />
    </Panel>
    <Border Name="ChromeHeader" Background="{DynamicResource LyricsChromeShade}">
      <Grid Name="ChromeHeaderLayout" Height="56" Margin="16,0,6,0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
            Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <Button Name="BackButton" Classes="lyrics-chrome lyrics-back" Click="OnBack" chrome:WindowDecorationProperties.ElementRole="User"
                ToolTip.Tip="{DynamicResource ui.LyricsView.eaaa1d0f0aab}" AutomationProperties.Name="{DynamicResource ui.LyricsView.eaaa1d0f0aab}">
          <icon:GlyphIcon Kind="chevron-down" Width="20" Height="20" />
        </Button>
        <Border Grid.Column="1" Background="Transparent" />
        <Border Grid.Column="2" Classes="lyrics-tool-group" chrome:WindowDecorationProperties.ElementRole="User">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Name="SettingsButton" Classes="lyrics-chrome" Click="OnOpenSettingsDrawer"
                    ToolTip.Tip="{DynamicResource ui.LyricsView.8eef1c88e182}" AutomationProperties.Name="{DynamicResource ui.LyricsView.8eef1c88e182}">
              <icon:GlyphIcon Kind="sliders" Width="18" Height="18" />
            </Button>
            <Button Name="LyricsAudioDrawerButton" Classes="lyrics-chrome" Click="OnOpenAudioDrawer"
                    ToolTip.Tip="{DynamicResource ui.TitleBar.24c267e226db}" AutomationProperties.Name="{DynamicResource ui.TitleBar.24c267e226db}">
              <icon:GlyphIcon Kind="headphones" Width="18" Height="18" />
            </Button>
            <Button Name="FullscreenButton" Classes="lyrics-chrome" Click="OnToggleFullscreen"
                    ToolTip.Tip="{DynamicResource ui.LyricsView.b9a75bc5fa65}" AutomationProperties.Name="{DynamicResource ui.LyricsView.b9a75bc5fa65}">
              <icon:GlyphIcon Kind="fullscreen" Width="17" Height="17" />
            </Button>
            <Button Name="HeaderMoreButton" Classes="lyrics-chrome" ToolTip.Tip="{DynamicResource ui.PlayerBar.38844b135cf7}"
                    AutomationProperties.Name="{DynamicResource ui.PlayerBar.38844b135cf7}">
              <icon:GlyphIcon Kind="more" Width="19" Height="19" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" VerticalOffset="8"
                            FlyoutPresenterTheme="{StaticResource LyricsMenuPresenter}" ItemContainerTheme="{StaticResource LyricsMenuItem}">
                  <MenuItem Name="ReloadLyricsItem" Classes="lyrics-menu" Header="{DynamicResource ui.LyricsView.df7392cc96be}" Command="{Binding ReloadCommand}" IsEnabled="{Binding !IsLoading}">
                    <MenuItem.Icon><icon:GlyphIcon Kind="refresh" Width="16" Height="16" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Name="ImportLyricsItem" Classes="lyrics-menu" Header="{DynamicResource ui.LyricsView.7ea981c88d81}" Click="OnImport" IsEnabled="{Binding !IsLoading}">
                    <MenuItem.Icon><icon:GlyphIcon Kind="file" Width="16" Height="16" /></MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>
        <StackPanel Name="LyricsWindowButtons" Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0" VerticalAlignment="Center">
          <Button Name="LyricsMinimizeButton" Classes="lyrics-chrome lyrics-window" Click="OnMinimize" chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                  ToolTip.Tip="{DynamicResource ui.TitleBar.ac29e57a46f4}" AutomationProperties.Name="{DynamicResource ui.TitleBar.ac29e57a46f4}"><icon:GlyphIcon Kind="minus" Width="14" Height="14" /></Button>
          <Button Name="LyricsMaximizeButton" Classes="lyrics-chrome lyrics-window" Click="OnMaximize" chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                  ToolTip.Tip="{DynamicResource ui.TitleBar.9949b1fb5f67}" AutomationProperties.Name="{DynamicResource ui.TitleBar.9949b1fb5f67}"><icon:GlyphIcon Kind="maximize" Width="13" Height="13" /></Button>
          <Button Name="LyricsCloseButton" Classes="lyrics-chrome lyrics-window lyrics-close" Click="OnClose" chrome:WindowDecorationProperties.ElementRole="CloseButton"
                  ToolTip.Tip="{DynamicResource ui.TitleBar.3fd47edce45b}" AutomationProperties.Name="{DynamicResource ui.TitleBar.3fd47edce45b}"><icon:GlyphIcon Kind="close" Width="14" Height="14" /></Button>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollBar Name="LineScroll" Grid.Row="1" Orientation="Vertical" SmallChange="1" LargeChange="5" Minimum="0" Width="5"
               HorizontalAlignment="Right" Margin="0,36,10,36" ValueChanged="OnScroll" Opacity="0.32" />
    <Button Name="FollowButton" Classes="lyrics-chrome lyrics-follow" Grid.Row="1" Content="{DynamicResource ui.LyricsView.fdbca70be239}" Click="OnFollow" IsVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" />
    <StackPanel Name="ChromeFooter" Grid.Row="2" Spacing="6" Margin="0,0,0,22">
      <TextBlock Text="{Binding Player.Error}" IsVisible="{Binding Player.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 TextAlignment="Center" FontSize="12" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding MessageDisplay}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 TextAlignment="Center" FontSize="12" Opacity="0.72" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Center" />
      <lyrics:LyricsTransportView Name="Transport" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
  </ThemeVariantScope>
</UserControl>
