<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lyrics="using:Echo.Desktop.Features.Lyrics" xmlns:icon="using:Echo.Desktop.Controls"
             xmlns:shell="using:Echo.Desktop.Shell"
             xmlns:player="using:Echo.Desktop.Features.Player"
             xmlns:controls="using:Echo.Desktop.Controls.Lyrics"
             x:Class="Echo.Desktop.Features.Lyrics.LyricsTransportView" x:DataType="lyrics:LyricsViewModel">
  <UserControl.Styles><StyleInclude Source="LyricsTransportStyles.axaml" /></UserControl.Styles>
  <!-- One stable hit region owns the expanded capsule and its idle progress surface. -->
  <Grid Name="TransportLayout" Height="88" Background="Transparent">
    <controls:LyricsPlayerSurface Name="CapsuleSurface" IsHitTestVisible="False" SurfaceBrush="{DynamicResource LyricsSurface}" />
    <Border Name="BarSurface" Height="88" VerticalAlignment="Bottom" Padding="28,0" Background="Transparent">
      <Grid Name="ExpandedLayout" ColumnDefinitions="*,Auto">
        <Grid Name="CenterLayout" ColumnDefinitions="Auto,*" RowDefinitions="32,0">
        <StackPanel Name="PlaybackControls" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
          <Button Name="FavoriteButton" Classes="lyric-control lyric-secondary" Classes.active="{Binding Player.Details.IsFavorite}" Command="{Binding Player.Details.ToggleFavoriteCommand}" IsEnabled="{Binding Player.Details.CanFavorite}" ToolTip.Tip="{Binding Player.Details.FavoriteLabel}" AutomationProperties.Name="{Binding Player.Details.FavoriteLabel}"><controls:LyricsTransportIcon Kind="{Binding Player.Details.HeartIcon}" Width="18" Height="18" /></Button>
          <Button Name="PreviousButton" Classes="lyric-control" Command="{Binding Player.PreviousCommand}" IsEnabled="{Binding Player.CanControl}" ToolTip.Tip="{DynamicResource ui.LyricsTransportView.8c747908bf69}" AutomationProperties.Name="{DynamicResource ui.LyricsTransportView.8c747908bf69}"><controls:LyricsTransportIcon Kind="previous" Width="21" Height="21" /></Button>
          <Button Name="PlayButton" Classes="lyric-control lyric-play" Command="{Binding Player.ToggleCommand}" IsEnabled="{Binding Player.CanStartPlayback}" ToolTip.Tip="{DynamicResource ui.LyricsTransportView.f03e2b5312a8}" AutomationProperties.Name="{DynamicResource ui.LyricsTransportView.f03e2b5312a8}"><controls:LyricsTransportIcon Kind="{Binding Player.PlayIcon}" Width="25" Height="25" Ink="{DynamicResource LyricsInk}" /></Button>
          <Button Name="NextButton" Classes="lyric-control" Command="{Binding Player.NextCommand}" IsEnabled="{Binding Player.CanControl}" ToolTip.Tip="{DynamicResource ui.LyricsTransportView.486e42475adb}" AutomationProperties.Name="{DynamicResource ui.LyricsTransportView.486e42475adb}"><controls:LyricsTransportIcon Kind="next" Width="21" Height="21" /></Button>
          <Button Name="ModeButton" Classes="lyric-control" Classes.active="{Binding Player.IsSpecialMode}" Command="{Binding Player.CycleRepeatCommand}" ToolTip.Tip="{Binding Player.RepeatText}" AutomationProperties.Name="{Binding Player.RepeatText}">
            <Grid><controls:LyricsTransportIcon Kind="sequence" Width="18" Height="18" IsVisible="{Binding !Player.IsSpecialMode}" /><controls:LyricsTransportIcon Kind="{Binding Player.ModeIcon}" Width="18" Height="18" IsVisible="{Binding Player.IsSpecialMode}" /></Grid>
          </Button>
          <Button Name="LyricsButton" Classes="lyric-control" Click="OnLyricsSettings" ToolTip.Tip="{DynamicResource ui.LyricsView.8eef1c88e182}" AutomationProperties.Name="{DynamicResource ui.LyricsView.8eef1c88e182}"><controls:LyricsTransportIcon Kind="captions" Width="19" Height="19" /></Button>
        </StackPanel>
        <Grid Name="ProgressRow" Grid.Column="1" Height="28" ColumnDefinitions="52,*,52" ColumnSpacing="16" Margin="32,0,60,0" VerticalAlignment="Center">
          <TextBlock Name="ElapsedText" Text="{Binding Player.PositionText}" Classes="lyric-time" TextAlignment="Right" />
          <Slider Name="SeekSlider" Grid.Column="1" Classes="lyric-rail" Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Position, Mode=OneWay}" IsEnabled="{Binding Player.CanSeek}" SmallChange="5" LargeChange="15" AutomationProperties.Name="{DynamicResource ui.PlayerBar.fc16e2a0fca6}" />
          <TextBlock Name="DurationLabel" Grid.Column="2" Text="{Binding Player.DurationText}" Classes="lyric-time" TextAlignment="Left" />
        </Grid>
        </Grid>
        <StackPanel Name="AuxiliaryControls" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Name="QueueButton" Classes="lyric-control lyric-secondary" Click="OnQueue" ToolTip.Tip="{DynamicResource ui.PlayerBar.f01b6815d826}" AutomationProperties.Name="{DynamicResource ui.PlayerBar.f01b6815d826}"><controls:LyricsTransportIcon Kind="queue" Width="19" Height="19" /></Button>
          <Button Name="VolumeButton" Classes="lyric-control lyric-secondary" ToolTip.Tip="{Binding Player.VolumeText}" AutomationProperties.Name="{DynamicResource ui.PlayerBar.8bf8b9780d34}"><controls:LyricsTransportIcon Kind="volume" Width="20" Height="20" /></Button>
          <Button Name="MoreButton" Classes="lyric-control lyric-secondary" ToolTip.Tip="{DynamicResource ui.PlayerBar.38844b135cf7}" AutomationProperties.Name="{DynamicResource ui.PlayerBar.38844b135cf7}">
            <controls:LyricsTransportIcon Kind="more" Width="19" Height="19" />
            <Button.Flyout><Flyout Placement="Top"><StackPanel Width="280" Spacing="12" x:DataType="shell:ShellViewModel">
              <TextBlock Text="{Binding Player.Details.Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Player.Details.ArtistAlbum}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
              <Border Height="1" Background="{DynamicResource EchoDivider}" />
              <CheckBox Name="BarModeInput" Content="{DynamicResource ui.LyricsSettingsDrawerView.a0ba94307ac8}" IsChecked="{Binding LyricsAppearance.MiniPlayer}" />
              <CheckBox Content="{DynamicResource ui.LyricsSettingsDrawerView.6e206a6e06e8}" IsChecked="{Binding LyricsAppearance.PlayerCompact}" />
              <CheckBox Content="{DynamicResource ui.LyricsSettingsDrawerView.59e3a2c265fb}" IsChecked="{Binding LyricsAppearance.PlayerAutoHide}" />
              <Border Height="1" Background="{DynamicResource EchoDivider}" />
              <Button Content="{Binding Player.RepeatText}" Command="{Binding Player.CycleRepeatCommand}" HorizontalAlignment="Stretch" />
              <Expander Header="{DynamicResource playerTools.title}" HorizontalAlignment="Stretch"><ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto"><player:PlayerToolsPanel DataContext="{Binding Player.Tools}" Margin="0,10,0,0" /></ScrollViewer></Expander>
              <Button Content="{DynamicResource ui.PlayerBar.f01b6815d826}" Click="OnQueue" HorizontalAlignment="Stretch" />
              <Button Content="{DynamicResource ui.PlayerBar.e63af6420456}" Click="OnLyricsSettings" HorizontalAlignment="Stretch" />
              <Button Content="{DynamicResource ui.PlayerBar.ff71ead6e0d9}" Click="OnAudioSettings" HorizontalAlignment="Stretch" />
              <Button Content="{DynamicResource ui.PlayerBar.a8cc3c4658a5}" Click="OnSignalPath" HorizontalAlignment="Stretch" />
            </StackPanel></Flyout></Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Name="IdleSurface" Background="Transparent" Width="320" Height="34" Padding="18,0" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False">
      <Grid ColumnDefinitions="42,*,42" ColumnSpacing="10">
        <TextBlock Text="{Binding Player.PositionText}" Classes="lyric-time idle-time" />
        <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Position}" Height="3" VerticalAlignment="Center" Foreground="{DynamicResource LyricsProgress}" Background="{DynamicResource LyricsRail}" />
        <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" Classes="lyric-time idle-time" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
