<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
        xmlns:queue="using:Echo.Desktop.Features.Queue" xmlns:floating="using:Echo.Desktop.Features.Floating"
        x:Class="Echo.Desktop.Features.Floating.MiniPlayerWindow" x:DataType="shell:ShellViewModel"
        Title="ECHO · Mini Player" Width="304" Height="76" CanResize="False" WindowDecorations="None"
        Background="Transparent" TransparencyLevelHint="Transparent" ShowInTaskbar="False" Topmost="True">
  <Window.Styles>
    <Style Selector="Button.mini"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="5" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.mini.play"><Setter Property="Foreground" Value="{DynamicResource EchoAccent}" /></Style>
  </Window.Styles>
  <Border Background="{DynamicResource EchoPlayer}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" CornerRadius="30" Margin="0,4" Padding="12,8">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
      <Grid Name="Pill" ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
        <Border CornerRadius="18" ClipToBounds="True" Width="36" Height="36" Background="{DynamicResource EchoPlaceholder}" PointerPressed="Drag">
          <Image Name="CoverImage" Stretch="UniformToFill" Source="{DynamicResource EchoPlaceholderImage}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" PointerPressed="Drag">
          <TextBlock Text="{Binding Player.Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Name="LyricLine" Text="{Binding Player.ArtistAlbum}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="PreviousButton" IsVisible="False" Classes="mini" Command="{Binding Player.PreviousCommand}" IsEnabled="{Binding Player.CanControl}" ToolTip.Tip="{DynamicResource floating.previous}"><icon:EchoIcon Kind="previous" Scope="player" /></Button>
          <Button Name="PlayButton" Classes="mini play" Command="{Binding Player.ToggleCommand}" IsEnabled="{Binding Player.CanPlay}" ToolTip.Tip="{Binding Player.Subtitle}"><icon:EchoIcon Kind="{Binding Player.PlayIcon}" Scope="player" /></Button>
          <Button Name="NextButton" IsVisible="False" Classes="mini" Command="{Binding Player.NextCommand}" IsEnabled="{Binding Player.CanControl}" ToolTip.Tip="{DynamicResource floating.next}"><icon:EchoIcon Kind="next" Scope="player" /></Button>
          <Button Name="ExpandButton" Classes="mini" Click="ToggleExpanded" ToolTip.Tip="{DynamicResource floating.expand}"><icon:GlyphIcon Kind="more" /></Button>
        </StackPanel>
      </Grid>
      <Grid Name="ExpandedControls" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,Auto" RowSpacing="7">
        <Slider Name="SeekSlider" Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Position, Mode=OneWay}" IsEnabled="{Binding Player.CanControl}" Height="16" AutomationProperties.Name="{DynamicResource floating.seek}" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Text="{Binding Player.PositionText}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
            <Button Name="QueueButton" Classes="mini" Click="ToggleQueue" ToolTip.Tip="{DynamicResource floating.queue}"><icon:GlyphIcon Kind="queue" /></Button>
            <Button Classes="mini" ToolTip.Tip="{Binding Player.VolumeText}"><icon:EchoIcon Kind="volume" Scope="player" /><Button.Flyout><Flyout><Slider Name="VolumeSlider" Width="150" Minimum="0" Maximum="1" Value="{Binding Player.Volume, Mode=OneWay}" AutomationProperties.Name="{DynamicResource floating.volume}" /></Flyout></Button.Flyout></Button>
            <Button Classes="mini" Command="{Binding Floating.RestoreMainCommand}" ToolTip.Tip="{DynamicResource floating.restore}"><icon:GlyphIcon Kind="maximize" /></Button>
            <Button Classes="mini" Command="{Binding Floating.ToggleMiniCommand}" ToolTip.Tip="{DynamicResource floating.close}"><icon:GlyphIcon Kind="close" /></Button>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
        </Grid>
      </Grid>
      <Grid Name="QueuePanel" Grid.Row="2" IsVisible="False" Height="200" RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Text="{Binding Player.Queue.Heading}" FontSize="12" FontWeight="SemiBold" />
        <ListBox Name="QueueList" Grid.Row="1" ItemsSource="{Binding Player.Queue.Rows}" SelectionChanged="SelectQueue" Background="Transparent">
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate x:DataType="queue:QueueRowViewModel"><Grid ColumnDefinitions="24,*,Auto" Margin="0,4"><TextBlock Text="{Binding Number}" Classes="muted" FontSize="11" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" /><TextBlock Text="{Binding Artist}" Classes="muted" FontSize="10" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Duration}" Classes="muted" FontSize="10" /></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="{Binding Player.Queue.EmptyHint}" IsVisible="{Binding Player.Queue.IsEmpty}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
      </Grid>
    </Grid>
  </Border>
</Window>
