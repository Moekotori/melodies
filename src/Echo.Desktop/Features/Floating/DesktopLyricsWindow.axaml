<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
        xmlns:lyrics="using:Echo.Desktop.Controls.Lyrics"
        x:Class="Echo.Desktop.Features.Floating.DesktopLyricsWindow" x:DataType="shell:ShellViewModel"
        Title="ECHO · Desktop Lyrics" Width="880" Height="190" MinWidth="360" MinHeight="130"
        WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True">
  <Grid Background="Transparent" PointerPressed="Drag">
    <Border Name="HoverSurface" Background="#A0202430" CornerRadius="8" Opacity="0" />
    <lyrics:FloatingLyricsControl Name="LyricsCanvas" Margin="16,38,16,12" IsHitTestVisible="False" />
    <StackPanel Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="4" Margin="8,4" Opacity="0">
      <Button Classes="icon" Command="{Binding Player.PreviousCommand}" IsEnabled="{Binding Player.CanControl}" ToolTip.Tip="{DynamicResource floating.previous}"><icon:EchoIcon Width="18" Height="18" Kind="previous" Scope="player" /></Button>
      <Button Classes="icon" Command="{Binding Player.ToggleCommand}" IsEnabled="{Binding Player.CanPlay}" ToolTip.Tip="{Binding Player.Subtitle}"><icon:EchoIcon Width="18" Height="18" Kind="{Binding Player.PlayIcon}" Scope="player" /></Button>
      <Button Classes="icon" Command="{Binding Player.NextCommand}" IsEnabled="{Binding Player.CanControl}" ToolTip.Tip="{DynamicResource floating.next}"><icon:EchoIcon Width="18" Height="18" Kind="next" Scope="player" /></Button>
      <Button Classes="icon" Command="{Binding Floating.ToggleLockCommand}" IsEnabled="{Binding Floating.SupportsPassthrough}" ToolTip.Tip="{DynamicResource floating.lock}"><icon:GlyphIcon Width="18" Height="18" Kind="lock" /></Button>
      <Button Classes="icon" Command="{Binding Floating.RestoreMainCommand}" ToolTip.Tip="{DynamicResource floating.restore}"><icon:GlyphIcon Width="18" Height="18" Kind="maximize" /></Button>
      <Button Classes="icon" Command="{Binding Floating.ToggleLyricsCommand}" ToolTip.Tip="{DynamicResource floating.close}"><icon:GlyphIcon Width="18" Height="18" Kind="close" /></Button>
    </StackPanel>
    <Border Name="ResizeGrip" Width="20" Height="20" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="BottomRightCorner" PointerPressed="Resize"><icon:GlyphIcon Kind="grip" Width="12" Height="12" /></Border>
  </Grid>
</Window>
