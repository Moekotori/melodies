<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:queue="using:Echo.Desktop.Features.Queue" xmlns:icon="using:Echo.Desktop.Controls" xmlns:motion="using:Echo.Desktop.Motion"
             x:Class="Echo.Desktop.Features.Queue.QueueView" x:DataType="queue:QueuePageViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <TextBlock Text="{Binding Queue.Heading}" Classes="heading" FontSize="{StaticResource EchoPageTitleSize}" FontWeight="Bold" />
      <TextBlock Text="{Binding Queue.Summary}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="16" IsVisible="{Binding !Queue.ShowHistory}">
      <Border Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="1" CornerRadius="16" Padding="18,16">
        <StackPanel Spacing="14">
          <Grid Name="HeroLayout" ColumnDefinitions="88,*,228" RowDefinitions="Auto,Auto" ColumnSpacing="18">
            <queue:QueueArtwork Name="CurrentCover" Width="88" Height="88" VerticalAlignment="Center" CornerRadius="{DynamicResource EchoCoverRadius}" FilePath="{Binding Queue.CurrentArtworkPath}" Cache="{Binding Queue.Artwork}" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource ui.QueueView.e6666b2eb332}" Classes="muted" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Player.Title}" Classes="heading" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Player.ArtistAlbum}" Classes="muted" FontSize="13" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="{Binding Queue.CurrentQuality}" Foreground="{DynamicResource EchoAccentText}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Queue.CurrentSource}" /></TextBlock>
              <Grid ColumnDefinitions="34,*,34" ColumnSpacing="8">
                <TextBlock Text="{Binding Player.PositionText}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Classes="queue-progress" Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Position}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" Classes="muted" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
            <Button Name="NextPreview" Grid.Column="2" Classes="queue-next" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                    Command="{Binding Queue.PlayUpcomingCommand}" IsEnabled="{Binding Queue.HasUpcoming}">
              <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                <queue:QueueArtwork Width="40" Height="40" CornerRadius="8" FilePath="{Binding Queue.UpcomingPath}" Cache="{Binding Queue.Artwork}" IsVisible="{Binding Queue.HasUpcoming}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Queue.UpcomingReason}" Classes="muted" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsVisible="{Binding Queue.UpcomingReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding Queue.UpcomingTitle}" Classes="heading" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Queue.UpcomingArtist}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Button>
          </Grid>
          <Grid Name="StrategyLayout" RowDefinitions="Auto,Auto" RowSpacing="8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <queue:QueueModes DataContext="{Binding Queue}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <StackPanel Name="PlaybackActions" Orientation="Horizontal" Spacing="4">
            <Button Classes="queue-tool" Command="{Binding Player.ToggleCommand}" IsEnabled="{Binding Queue.CanPlay}"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="play" Width="15" Height="15" /><TextBlock Text="{Binding Queue.PlayLabel}" /></StackPanel></Button>
            <Button Classes="queue-tool" Content="{DynamicResource ui.QueueDrawer.4c8a4e3da39e}" Click="OnAdd" />
            <Button Classes="queue-tool" ToolTip.Tip="{DynamicResource ui.QueueList.7bbb8a858f8c}">
              <StackPanel Orientation="Horizontal" Spacing="6"><icon:EchoIcon Scope="player" Kind="more" Width="17" Height="17" /><TextBlock Text="{Binding Queue.ManageLabel}" /></StackPanel>
              <Button.Flyout><motion:MotionFlyout><StackPanel Width="220" Spacing="5">
                <Button Content="{DynamicResource ui.QueueDrawer.4c8a4e3da39e}" Click="OnAdd" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Button Content="{DynamicResource ui.QueueDrawer.926a50b98ece}" Command="{Binding Queue.UndoCommand}" IsEnabled="{Binding Queue.CanUndo}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Border Background="{DynamicResource EchoDivider}" Height="1" />
                <Button Content="{DynamicResource ui.QueueDrawer.d18e02739127}" Command="{Binding Queue.ClearCommand}" IsEnabled="{Binding !Queue.IsBusy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
              </StackPanel></motion:MotionFlyout></Button.Flyout>
            </Button>
          </StackPanel>
            </WrapPanel>
            <TextBlock Grid.Row="1" Text="{Binding Queue.StrategyText}" Classes="muted" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
          </Grid>
        </StackPanel>
      </Border>
      <StackPanel Spacing="8" IsVisible="{Binding Queue.ShowPlan}">
        <TextBlock Text="{Binding Queue.PlanHeading}" Classes="muted" FontSize="11" FontWeight="SemiBold" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Queue.Plan}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="queue:QueuePlanItem">
                <Button Classes="queue-plan" Classes.first="{Binding IsFirst}" Click="OnPlanPlay" AutomationProperties.Name="{Binding Title}">
                  <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                    <queue:QueueArtwork Width="32" Height="32" CornerRadius="6" FilePath="{Binding ArtworkPath}" Cache="{Binding Artwork}" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" MaxWidth="132">
                      <TextBlock Text="{Binding Reason}" Classes="plan-reason" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Title}" Classes="heading" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
    <Grid Name="ListHeading" Grid.Row="2" ColumnDefinitions="*,260,Auto" ColumnSpacing="10">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="{Binding Queue.SectionTitle}" Classes="heading" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding Queue.ResultText}" Classes="muted" FontSize="11" VerticalAlignment="Center" /></StackPanel>
      <Grid Grid.Column="1"><TextBox Name="QueueSearch" Classes="queue-search" Padding="32,5,10,5" PlaceholderText="{DynamicResource ui.QueueView.87b9143f8cb9}" Text="{Binding Queue.Search, Mode=TwoWay}" /><icon:GlyphIcon Kind="search" Width="15" Height="15" HorizontalAlignment="Left" Margin="10,0" IsHitTestVisible="False" /></Grid>
      <Button Grid.Column="2" Classes="queue-tool" Click="OnLocate" ToolTip.Tip="{DynamicResource ui.QueueView.0a0de1034dd5}"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="locate" Width="15" Height="15" /><TextBlock Text="{DynamicResource ui.QueueView.0a0de1034dd5}" /></StackPanel></Button>
    </Grid>
    <queue:QueueList Name="QueueTracks" Grid.Row="3" DataContext="{Binding Queue}" />
    <TextBlock Grid.Row="4" Text="{Binding Queue.Message}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Queue.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</UserControl>
