<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icon="using:Echo.Desktop.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="EchoQueueHero">#f0f0f7</SolidColorBrush><SolidColorBrush x:Key="EchoQueueActive">#ededfa</SolidColorBrush><SolidColorBrush x:Key="EchoQueueChip">#e8e7f6</SolidColorBrush></ResourceDictionary>
        <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="EchoQueueHero">#1b1c22</SolidColorBrush><SolidColorBrush x:Key="EchoQueueActive">#232430</SolidColorBrush><SolidColorBrush x:Key="EchoQueueChip">#2b2b3c</SolidColorBrush></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="icon|GlyphIcon"><Setter Property="Stroke" Value="{DynamicResource EchoMuted}" /></Style>
  <Style Selector="icon|EchoIcon"><Setter Property="BaseBrush" Value="{DynamicResource EchoHeading}" /><Setter Property="AccentBrush" Value="{DynamicResource EchoIconAccent}" /></Style>
  <Style Selector="Button.queue-tool"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="8,0" /><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="30" /></Style>
  <Style Selector="Button.queue-tool:pointerover"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
  <Style Selector="Button.queue-next"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="BorderThickness" Value="1,0,0,0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Padding" Value="16,0,0,0" /><Setter Property="MinHeight" Value="72" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.queue-next:pointerover"><Setter Property="Background" Value="{DynamicResource EchoHover}" /><Setter Property="CornerRadius" Value="10" /></Style>
  <Style Selector="ProgressBar.queue-progress"><Setter Property="Height" Value="2" /><Setter Property="MinHeight" Value="2" /><Setter Property="MaxHeight" Value="2" /><Setter Property="Foreground" Value="{DynamicResource EchoAccent}" /><Setter Property="Background" Value="{DynamicResource EchoDivider}" /></Style>
  <Style Selector="Button.queue-plan"><Setter Property="Background" Value="{DynamicResource EchoField}" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="6" /><Setter Property="MinHeight" Value="44" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.queue-plan:pointerover"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
  <Style Selector="Button.queue-plan.first"><Setter Property="Background" Value="{DynamicResource EchoQueueActive}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="TextBlock.plan-reason"><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
  <Style Selector="Button.queue-plan.first TextBlock.plan-reason"><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /></Style>
  <Style Selector="Button.queue-mode"><Setter Property="Background" Value="Transparent" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="10,0" /><Setter Property="MinHeight" Value="30" /><Setter Property="CornerRadius" Value="8" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Button.queue-mode:pointerover"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
  <Style Selector="Button.queue-mode.active"><Setter Property="Background" Value="{DynamicResource EchoQueueActive}" /><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /></Style>
  <Style Selector="Button.queue-mode.active:pointerover"><Setter Property="Background" Value="{DynamicResource EchoQueueActive}" /></Style>
  <Style Selector="Button.queue-mode.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.queue-mode.active icon|GlyphIcon.mode-icon"><Setter Property="Stroke" Value="{DynamicResource EchoAccentText}" /></Style>
  <Style Selector="TextBox.queue-search"><Setter Property="Background" Value="{DynamicResource EchoPanelMuted}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="34" /></Style>
  <Style Selector="Border.queue-chip"><Setter Property="Background" Value="{DynamicResource EchoQueueChip}" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="7,2" /></Style>
  <Style Selector="Border.queue-selection"><Setter Property="Background" Value="{DynamicResource EchoField}" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="6,4" /></Style>
  <Style Selector="Border.queue-state"><Setter Property="Background" Value="{DynamicResource EchoQueueChip}" /><Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="5,1" /><Setter Property="Margin" Value="8,0,0,0" /></Style>
  <Style Selector="Border.queue-state TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
</Styles>
