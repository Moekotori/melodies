<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.drawer-action"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="Background" Value="{DynamicResource DrawerInset}" /><Setter Property="Padding" Value="10,0" /><Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="CornerRadius" Value="9" /></Style>
  <Style Selector="Button.drawer-action:pointerover"><Setter Property="Background" Value="{DynamicResource DrawerHover}" /></Style>
  <Style Selector="Button.drawer-mode"><Setter Property="Background" Value="{DynamicResource EchoQueueActive}" /><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /><Setter Property="Padding" Value="11,0" /><Setter Property="MinHeight" Value="32" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="CornerRadius" Value="9" /></Style>
  <Style Selector="Button.icon"><Setter Property="Background" Value="{DynamicResource DrawerInset}" /><Setter Property="CornerRadius" Value="10" /></Style>
  <Style Selector="Button.icon:pointerover"><Setter Property="Background" Value="{DynamicResource DrawerHover}" /></Style>
  <Style Selector="TextBox.queue-search"><Setter Property="Background" Value="{DynamicResource DrawerInset}" /><Setter Property="BorderBrush" Value="{DynamicResource DrawerStroke}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="11" /><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="12,8" /></Style>
</Styles>
