<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:icon="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.LibraryDetails.DetailSortButton">
 <UserControl.Styles>
  <Style Selector="Button.sort-opener"><Setter Property="Padding" Value="8,0" /><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="CornerRadius" Value="4" /></Style>
  <Style Selector="Button.sort-item"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="10,0" /><Setter Property="MinHeight" Value="34" /><Setter Property="CornerRadius" Value="4" /></Style>
 </UserControl.Styles>
 <Grid>
 <Border Name="InlineHost" IsVisible="False" />
 <Button Name="SortOpener" Classes="sort-opener" ToolTip.Tip="{DynamicResource detail.sort.label}" AutomationProperties.Name="{DynamicResource detail.sort.label}">
  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
   <TextBlock Name="SelectedLabel" FontSize="12" Classes="muted" VerticalAlignment="Center" />
   <TextBlock Name="DirectionLabel" Text="↓" FontSize="13" Classes="muted" VerticalAlignment="Center" />
   <icon:GlyphIcon Kind="chevron-right" Width="12" Height="12" StrokeWidth="1.5"><icon:GlyphIcon.RenderTransform><RotateTransform Angle="90" /></icon:GlyphIcon.RenderTransform></icon:GlyphIcon>
  </StackPanel>
  <Button.Flyout>
   <Flyout Placement="BottomEdgeAlignedRight"><StackPanel Name="SortOptions" Width="172" Spacing="2">
    <Button Classes="sort-item" Tag="0" Click="OnSort" AutomationProperties.Name="{DynamicResource detail.sort.order}"><Grid ColumnDefinitions="*,14" ColumnSpacing="10"><TextBlock Text="{DynamicResource detail.sort.order}" FontSize="13" VerticalAlignment="Center" /><icon:GlyphIcon Name="OrderCheck" Grid.Column="1" Kind="check" Width="14" Height="14" Stroke="{DynamicResource EchoAccentText}" /></Grid></Button>
    <Button Classes="sort-item" Tag="1" Click="OnSort" AutomationProperties.Name="{DynamicResource ui.AlbumDetailView.d44e9b3d3b31}"><Grid ColumnDefinitions="*,14" ColumnSpacing="10"><TextBlock Text="{DynamicResource ui.AlbumDetailView.d44e9b3d3b31}" FontSize="13" VerticalAlignment="Center" /><icon:GlyphIcon Name="TitleCheck" Grid.Column="1" Kind="check" Width="14" Height="14" Stroke="{DynamicResource EchoAccentText}" /></Grid></Button>
    <Button Classes="sort-item" Tag="2" Click="OnSort" AutomationProperties.Name="{DynamicResource ui.AlbumDetailView.04a95e0654d3}"><Grid ColumnDefinitions="*,14" ColumnSpacing="10"><TextBlock Text="{DynamicResource ui.AlbumDetailView.04a95e0654d3}" FontSize="13" VerticalAlignment="Center" /><icon:GlyphIcon Name="DurationCheck" Grid.Column="1" Kind="check" Width="14" Height="14" Stroke="{DynamicResource EchoAccentText}" /></Grid></Button>
    <Button Classes="sort-item" Tag="3" Click="OnSort" AutomationProperties.Name="{DynamicResource ui.AlbumDetailView.eb11dd93ee99}"><Grid ColumnDefinitions="*,14" ColumnSpacing="10"><TextBlock Text="{DynamicResource ui.AlbumDetailView.eb11dd93ee99}" FontSize="13" VerticalAlignment="Center" /><icon:GlyphIcon Name="QualityCheck" Grid.Column="1" Kind="check" Width="14" Height="14" Stroke="{DynamicResource EchoAccentText}" /></Grid></Button>
    <Border Height="1" Background="{DynamicResource EchoDivider}" Margin="6,6" />
    <Button Classes="sort-item" Tag="False" Click="OnDirection" AutomationProperties.Name="{DynamicResource detail.sort.ascending}"><Grid ColumnDefinitions="*,14" ColumnSpacing="10"><TextBlock Text="{DynamicResource detail.sort.ascending}" FontSize="13" VerticalAlignment="Center" /><icon:GlyphIcon Name="AscendingCheck" Grid.Column="1" Kind="check" Width="14" Height="14" Stroke="{DynamicResource EchoAccentText}" /></Grid></Button>
    <Button Classes="sort-item" Tag="True" Click="OnDirection" AutomationProperties.Name="{DynamicResource detail.sort.descending}"><Grid ColumnDefinitions="*,14" ColumnSpacing="10"><TextBlock Text="{DynamicResource detail.sort.descending}" FontSize="13" VerticalAlignment="Center" /><icon:GlyphIcon Name="DescendingCheck" Grid.Column="1" Kind="check" Width="14" Height="14" Stroke="{DynamicResource EchoAccentText}" /></Grid></Button>
   </StackPanel></Flyout>
  </Button.Flyout>
 </Button>
 </Grid>
</UserControl>
