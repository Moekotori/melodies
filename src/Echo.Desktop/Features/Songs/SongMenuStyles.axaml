<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ContextMenu.songTrackMenu">
    <Setter Property="Background" Value="{DynamicResource EchoField}" /><Setter Property="BorderBrush" Value="{DynamicResource EchoBorder}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="6" />
    <Setter Property="FontFamily" Value="{DynamicResource EchoFont}" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ContextMenu.songTrackMenu MenuItem.songMenuAction"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,5" /><Setter Property="Foreground" Value="{DynamicResource EchoText}" /></Style>
  <Style Selector="ContextMenu.songTrackMenu MenuItem.songMenuAction:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
  <Style Selector="ContextMenu.songTrackMenu MenuItem.songMenuAction:selected"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
  <Style Selector="ContextMenu.songTrackMenu MenuItem.songMenuHeader"><Setter Property="Opacity" Value="1" /><Setter Property="Padding" Value="8,6" /><Setter Property="MinHeight" Value="0" /></Style>
  <Style Selector="ContextMenu.songTrackMenu Separator"><Setter Property="Margin" Value="6,4" /><Setter Property="Background" Value="{DynamicResource EchoDivider}" /></Style>
</Styles>
