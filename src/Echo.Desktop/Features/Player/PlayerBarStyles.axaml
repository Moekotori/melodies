<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icon="using:Echo.Desktop.Controls">
  <StyleInclude Source="/Controls/PlayerProgressStyles.axaml" />
  <Styles.Resources>

    <ControlTheme x:Key="PlayerRailButton" TargetType="RepeatButton">
      <Setter Property="Template"><ControlTemplate><Grid Background="Transparent"><Border Background="{TemplateBinding Background}" Height="5" CornerRadius="3" VerticalAlignment="Center" /></Grid></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="PlayerRailThumb" TargetType="Thumb">
      <Setter Property="Template"><ControlTemplate><Border Background="{DynamicResource EchoAccent}" BorderBrush="{DynamicResource EchoPlayer}" BorderThickness="2" CornerRadius="6" /></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="PlayerRail" TargetType="Slider">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template"><ControlTemplate>
        <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
          <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="Horizontal">
            <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource PlayerRailButton}" Background="{DynamicResource EchoAccent}" Focusable="False" /></Track.DecreaseButton>
            <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource PlayerRailButton}" Background="{DynamicResource EchoDivider}" Focusable="False" /></Track.IncreaseButton>
            <Thumb Name="thumb" Width="12" Height="12" Theme="{StaticResource PlayerRailThumb}" />
          </Track>
        </Border>
      </ControlTemplate></Setter>
      <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="BorderThickness" Value="1" /></Style>
    </ControlTheme>
  </Styles.Resources>






  <Style Selector="Slider.player-rail"><Setter Property="Theme" Value="{StaticResource PlayerRail}" /></Style>
  <Style Selector="Button.player-cover"><Setter Property="CornerRadius" Value="11" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  <Style Selector="Button.player-cover:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.play:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.transport.active icon|GlyphIcon"><Setter Property="Stroke" Value="{DynamicResource EchoAccentText}" /></Style>
  <Style Selector="Border.player-chip"><Setter Property="Background" Value="{DynamicResource EchoChip}" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="8,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Border.player-chip TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Border.player-chip.format TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /></Style>
</Styles>

