<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:player="using:Echo.Desktop.Features.Player" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Player.SignalPathPanel" x:DataType="player:SignalPathViewModel">
  <Border Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" CornerRadius="12" BoxShadow="{DynamicResource EchoPanelShadow}" ClipToBounds="True">
    <Grid>
      <Border Height="92" VerticalAlignment="Top" Background="{DynamicResource EchoPageGlow}" IsHitTestVisible="False" />
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,14,16,12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" VerticalAlignment="Center" />
          <Button Name="CloseButton" Grid.Column="1" Classes="close" Click="Close" ToolTip.Tip="{Binding CloseLabel}" AutomationProperties.Name="{Binding CloseLabel}"><icon:GlyphIcon Kind="close" Width="15" Height="15" /></Button>
        </Grid>
        <ScrollViewer Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0">
          <StackPanel Spacing="14">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding Spec}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="pill"><TextBlock Text="{Binding Layers}" /></Border>
              </Grid>
              <TextBlock Text="{Binding Headline}" Classes="hero" />
              <TextBlock Text="{Binding Description}" Classes="detail" />
            </StackPanel>
            <Border Classes="hairline" />
            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding LevelLabel}" Classes="eyebrow" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="15" FontWeight="SemiBold" />
              </Grid>
              <player:SignalLevelRail Height="8" Percent="{Binding LevelPercent}" ToolTip.Tip="{Binding LevelDetail}" />
              <Grid ColumnDefinitions="2*,*,*,*">
                <TextBlock Text="−60" Classes="detail" FontSize="10" /><TextBlock Text="−24" Classes="detail" FontSize="10" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1" Text="−12" Classes="detail" FontSize="10" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" Text="−6" Classes="detail" FontSize="10" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="0 dBFS" Classes="detail" FontSize="10" HorizontalAlignment="Right" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding LevelSummary}" Classes="detail" />
                <icon:GlyphIcon Grid.Column="1" Kind="info" Width="13" Height="13" ToolTip.Tip="{Binding LevelNote}" VerticalAlignment="Top" />
              </Grid>
            </StackPanel>
            <Border Classes="hairline" />
            <ItemsControl ItemsSource="{Binding Metrics}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="player:SignalPathFact">
                <StackPanel Spacing="3" Margin="0,0,14,12">
                  <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                  <TextBlock Text="{Binding Value}" Classes="value" Classes.highlight="{Binding Highlight}" />
                  <TextBlock Text="{Binding Detail}" Classes="detail" />
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding TechLabel}" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding EngagedChips}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="player:SignalPathChip">
                  <Border Classes="chip" Classes.active="{Binding Active}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding Label}" Classes="chip-label" />
                      <TextBlock Text="{Binding Value}" Classes="chip-value" />
                    </StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding IdleSummary}" Classes="detail" IsVisible="{Binding IdleSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Border Classes="hairline" />
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding StabilityLabel}" Classes="eyebrow" />
              <TextBlock Text="{Binding StabilityHeadline}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" />
              <TextBlock Text="{Binding StabilityDetail}" Classes="detail" />
              <ItemsControl ItemsSource="{Binding Stability}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="player:SignalPathFact">
                  <StackPanel Spacing="2" Margin="0,4,12,8">
                    <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                    <TextBlock Text="{Binding Value}" Classes="value" FontSize="12" Classes.highlight="{Binding Highlight}" />
                    <TextBlock Text="{Binding Detail}" Classes="detail" />
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="8">
              <Border Classes="note"><TextBlock Text="{Binding InsightPreview}" Classes="detail" /></Border>
              <Expander Name="DoctorExpander" Header="{Binding DoctorCount}" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Insights}" Margin="2,8,0,0"><ItemsControl.ItemTemplate><DataTemplate x:DataType="player:SignalPathInsight">
                  <StackPanel Spacing="2" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding Detail}" Classes="detail" />
                    <TextBlock Text="{Binding Advice}" Classes="detail" />
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </Expander>
            </StackPanel>
            <Expander Name="DiagnosticsExpander" Header="{Binding DiagnosticsLabel}" HorizontalAlignment="Stretch">
              <StackPanel Spacing="12" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding OutputFacts}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="player:SignalPathFact"><StackPanel Spacing="2" Margin="0,0,12,10"><TextBlock Text="{Binding Label}" Classes="eyebrow" /><TextBlock Text="{Binding Value}" Classes="value" FontSize="12" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="hairline" />
                <TextBlock Text="{Binding ChainLabel}" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding Nodes}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="player:SignalPathNode">
                    <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" Margin="0,0,0,12">
                      <Border Classes="badge" VerticalAlignment="Top"><icon:GlyphIcon Kind="{Binding Icon}" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                      <Border Grid.Row="1" Width="1" MinHeight="10" Background="{DynamicResource EchoDivider}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="{Binding Value}" Classes="value" FontSize="12" /></StackPanel>
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" Classes="detail" Margin="0,3,0,0" />
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="hairline" />
                <TextBlock Text="{Binding Diagnosis}" Classes="detail" />
                <TextBlock Text="{Binding PerformanceText}" Classes="detail" />
                <ItemsControl ItemsSource="{Binding Diagnostics}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="player:SignalPathFact"><Grid ColumnDefinitions="*,*" Margin="0,0,0,8"><TextBlock Text="{Binding Label}" Classes="eyebrow" /><TextBlock Grid.Column="1" Text="{Binding Value}" Classes="value" FontSize="12" HorizontalAlignment="Right" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0">
          <Border Classes="hairline" />
          <Button Name="SettingsButton" Classes="link" Content="{Binding OutputSettingsLabel}" Click="OpenSettings" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
