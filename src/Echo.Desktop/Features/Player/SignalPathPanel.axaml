<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:player="using:Echo.Desktop.Features.Player" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Player.SignalPathPanel" x:DataType="player:SignalPathViewModel">
  <Border Name="Root" Classes="root muted" Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1"
          CornerRadius="12" BoxShadow="{DynamicResource EchoPanelShadow}" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Classes="glow" Grid.RowSpan="3" />
      <Grid ColumnDefinitions="*,Auto" Margin="22,16,14,10">
        <TextBlock Text="{Binding Title}" Classes="title" VerticalAlignment="Center" />
        <Button Name="CloseButton" Grid.Column="1" Classes="close" Click="Close"
                ToolTip.Tip="{Binding CloseLabel}" AutomationProperties.Name="{Binding CloseLabel}">
          <icon:GlyphIcon Kind="close" Width="16" Height="16" />
        </Button>
      </Grid>
      <ScrollViewer Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
        <StackPanel Margin="22,8,22,6">
          <TextBlock Text="{Binding Spec}" Classes="spec" Margin="0,0,0,6" />
          <TextBlock Text="{Binding Headline}" Classes="hero" />
          <TextBlock Text="{Binding Description}" Classes="detail" Margin="0,4,0,0" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
            <TextBlock Text="{Binding LevelLabel}" Classes="eyebrow" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LevelText}" Classes="level" Classes.clip="{Binding LevelClip}" />
          </Grid>
          <player:SignalLevelRail Height="14" Margin="0,6,0,2" Percent="{Binding LevelPercent}" RmsPercent="{Binding RmsPercent}" ToolTip.Tip="{Binding LevelDetail}" />
          <Grid ColumnDefinitions="2*,*,*,*">
            <TextBlock Text="−60" Classes="scale" />
            <TextBlock Text="−24" Classes="scale" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="1" Text="−12" Classes="scale" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="−6" Classes="scale" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="0 dBFS" Classes="scale" HorizontalAlignment="Right" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,5,0,0">
            <TextBlock Text="{Binding LevelSummary}" Classes="detail" />
            <icon:GlyphIcon Grid.Column="1" Kind="info" Width="13" Height="13" ToolTip.Tip="{Binding LevelNote}" VerticalAlignment="Top" />
          </Grid>

          <Border Classes="rule" Margin="0,12,0,14" />
          <ItemsControl Name="SignalChain" ItemsSource="{Binding Nodes}" AutomationProperties.Name="{Binding ChainLabel}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="player:SignalPathNode">
                <Grid ColumnDefinitions="32,*" ColumnSpacing="12" Classes="chain-node"
                      Classes.good="{Binding IsGood}" Classes.proc="{Binding IsProc}" Classes.warn="{Binding IsWarn}"
                      Classes.danger="{Binding IsDanger}" Classes.muted="{Binding IsMuted}">
                  <Border Classes="connector" Classes.last="{Binding IsLast}" />
                  <Border Classes="badge">
                    <icon:GlyphIcon Kind="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Title}" Classes="eyebrow" />
                      <TextBlock Grid.Column="1" Text="{Binding Tag}" Classes="tag" IsVisible="{Binding HasTag}" />
                    </Grid>
                    <TextBlock Text="{Binding Value}" Classes="node-title" Classes.processing="{Binding IsProcessing}" />
                    <TextBlock Text="{Binding Detail}" Classes="detail" />
                    <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasSummary}" Margin="0,3,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="player:SignalPathFact">
                          <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,2">
                            <TextBlock Text="{Binding Label}" Classes="summary" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding Value}" Classes="fact" TextWrapping="NoWrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="rule" Margin="0,0,0,6" />
          <ToggleButton Name="DoctorToggle" Classes="fold">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding DoctorCount}" Classes="node-title" VerticalAlignment="Center" />
              <icon:GlyphIcon Grid.Column="1" Kind="chevron-down" Width="14" Height="14" />
            </Grid>
          </ToggleButton>
          <ItemsControl ItemsSource="{Binding Insights}" Margin="0,8,0,0" IsVisible="{Binding #DoctorToggle.IsChecked}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="player:SignalPathInsight">
                <StackPanel Spacing="3" Margin="0,0,0,12">
                  <TextBlock Text="{Binding Title}" Classes="node-title" />
                  <TextBlock Text="{Binding Detail}" Classes="detail" />
                  <TextBlock Text="{Binding Advice}" Classes="detail" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="rule" Margin="0,6" />
          <ToggleButton Name="DiagnosticsToggle" Classes="fold">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding DiagnosticsLabel}" Classes="node-title" VerticalAlignment="Center" />
              <icon:GlyphIcon Grid.Column="1" Kind="chevron-down" Width="14" Height="14" />
            </Grid>
          </ToggleButton>
          <StackPanel Spacing="10" Margin="0,8,0,0" IsVisible="{Binding #DiagnosticsToggle.IsChecked}">
            <StackPanel Spacing="2" AutomationProperties.Name="{Binding StabilityLabel}">
              <TextBlock Text="{Binding StabilityHeadline}" Classes="node-title" />
              <TextBlock Text="{Binding StabilityDetail}" Classes="detail" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Stability}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="player:SignalPathFact">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,7" ToolTip.Tip="{Binding Detail}">
                    <TextBlock Text="{Binding Label}" Classes="detail" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="value" Classes.highlight="{Binding Highlight}" TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
              <TextBlock Text="{Binding TechLabel}" Classes="eyebrow" Margin="0,0,0,0" />
              <ItemsControl ItemsSource="{Binding EngagedChips}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="player:SignalPathChip">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,6">
                      <TextBlock Text="{Binding Label}" Classes="detail" />
                      <TextBlock Text="{Binding Value}" Classes="value" Classes.highlight="{Binding Active}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            <TextBlock Text="{Binding Diagnosis}" Classes="detail" />
            <TextBlock Text="{Binding PerformanceText}" Classes="detail" />
            <ItemsControl ItemsSource="{Binding OutputFacts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="player:SignalPathFact">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Label}" Classes="detail" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="value" TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Diagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="player:SignalPathFact">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Label}" Classes="detail" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="value" TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding IdleSummary}" Classes="detail" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Classes="rule" Margin="22,0" VerticalAlignment="Top" />
      <Button Name="SettingsButton" Grid.Row="2" Classes="link" Content="{Binding OutputSettingsLabel}" Click="OpenSettings" HorizontalAlignment="Right" Margin="22,8,22,10" />
    </Grid>
  </Border>
</UserControl>
