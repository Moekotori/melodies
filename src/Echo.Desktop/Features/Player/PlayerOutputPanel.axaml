<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="using:Echo.Desktop.Shell" xmlns:player="using:Echo.Desktop.Features.Player" xmlns:playback="using:Echo.Playback" xmlns:motion="using:Echo.Desktop.Motion" x:Class="Echo.Desktop.Features.Player.PlayerOutputPanel" x:DataType="shell:ShellViewModel">
<ScrollViewer MaxHeight="650" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Width="360" Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Text="{Binding Player.ZoneName}" Classes="heading" /><TextBlock Grid.Column="1" Text="{Binding Player.OutputName}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid>
                <TextBlock Text="{Binding Player.SignalPath}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
                <Border Height="1" Background="{DynamicResource EchoDivider}" />
                <Button Content="{DynamicResource ui.PlayerOutputPanel.c62ccce456a1}" Command="{Binding Player.AudioSettings.RefreshCommand}" HorizontalAlignment="Stretch" />
                <ComboBox ItemsSource="{Binding Player.AudioSettings.Devices}" SelectedItem="{Binding Player.AudioSettings.SelectedDevice}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputDevice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{DynamicResource ui.PlayerOutputPanel.c25a1af82895}" Classes="muted" />
                <ComboBox ItemsSource="{Binding Player.AudioSettings.Modes}" SelectedItem="{Binding Player.AudioSettings.SelectedMode}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputMode"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{DynamicResource ui.PlayerOutputPanel.d657fd77137b}" Classes="muted" />
                <ComboBox ItemsSource="{Binding Player.AudioSettings.Rates}" SelectedItem="{Binding Player.AudioSettings.SampleRate}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{DynamicResource ui.PlayerOutputPanel.cc143767eee8}" Classes="muted" />
                <NumericUpDown Minimum="64" Maximum="32768" Increment="64" Value="{Binding Player.AudioSettings.BufferFrames}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding Player.AudioSettings.IsAsio}">
                  <StackPanel Spacing="6"><TextBlock Text="{DynamicResource ui.PlayerOutputPanel.d7eacc320005}" Classes="muted" /><NumericUpDown Minimum="2" Maximum="8" Increment="1" Value="{Binding Player.AudioSettings.OutputChannels}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{DynamicResource ui.PlayerOutputPanel.798f69c823bd}" Classes="muted" /><NumericUpDown Minimum="1" Maximum="129" Increment="1" Value="{Binding Player.AudioSettings.AsioChannelStart}" /></StackPanel>
                </Grid>
                <TextBlock Text="{DynamicResource ui.PlayerOutputPanel.41d0e52f0a91}" Classes="muted" />
                <ComboBox ItemsSource="{Binding Player.AudioSettings.Formats}" SelectedItem="{Binding Player.AudioSettings.SelectedFormat}" IsEnabled="{Binding Player.AudioSettings.CanUseDsd}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="player:OutputFormatChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding Player.AudioSettings.DsdRates}" SelectedItem="{Binding Player.AudioSettings.DsdTransportRate}" IsVisible="{Binding Player.AudioSettings.IsDsd}" HorizontalAlignment="Stretch" />
                <Button Content="{DynamicResource ui.PlayerOutputPanel.cda57be20b9a}" Command="{Binding Player.AudioSettings.ProbeDsdCommand}" IsVisible="{Binding Player.AudioSettings.IsAsio}" />
                <TextBlock Text="{Binding Player.AudioSettings.DsdCapabilities}" IsVisible="{Binding Player.AudioSettings.IsAsio}" Classes="muted" TextWrapping="Wrap" />
                <Border Height="1" Background="{DynamicResource EchoDivider}" />
                <CheckBox Content="{DynamicResource ui.PlayerOutputPanel.61600fa691d5}" IsChecked="{Binding Player.AudioSettings.EqualizerEnabled}" />
                <CheckBox Content="{DynamicResource ui.PlayerOutputPanel.a2018d18ffbc}" IsChecked="{Binding Player.AudioSettings.CrossfeedEnabled}" />
                <TextBlock Text="{DynamicResource ui.PlayerOutputPanel.c114a632b201}" Classes="muted" />
                <NumericUpDown Minimum="0.5" Maximum="2" Increment="0.05" Value="{Binding Player.AudioSettings.PlaybackRate}" />
                <Button Content="{DynamicResource ui.PlayerOutputPanel.a1a42cd9b16e}" Command="{Binding Player.AudioSettings.ApplyCommand}" />
                <TextBlock Text="{Binding Player.AudioSettings.Message}" TextWrapping="Wrap" Classes="muted" />
              </StackPanel>
              </ScrollViewer>
</UserControl>

