<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:player="using:Echo.Desktop.Features.Player"
             x:Class="Echo.Desktop.Features.Player.PlayerToolsPanel" x:DataType="player:PlayerToolsViewModel">
  <StackPanel Spacing="12" MaxWidth="320">
    <player:PlayerSleepTimerPanel Name="SleepTimer" />
    <Border Height="1" Background="{DynamicResource EchoDivider}" Margin="0,4" />
    <StackPanel Spacing="4">
      <TextBlock Text="{DynamicResource playerTools.loop}" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="{Binding LoopStatus}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource playerTools.loopHelp}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsEnabled="{Binding CanLoop}">
      <StackPanel Spacing="6">
        <Button Content="{DynamicResource playerTools.markA}" Command="{Binding MarkStartCommand}" HorizontalAlignment="Stretch" />
        <NumericUpDown Name="LoopStart" Minimum="0" Maximum="{Binding TrackDuration}" Value="{Binding StartSeconds}" Increment="0.5" FormatString="0.00" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <Button Content="{DynamicResource playerTools.markB}" Command="{Binding MarkEndCommand}" HorizontalAlignment="Stretch" />
        <NumericUpDown Name="LoopEnd" Minimum="0" Maximum="{Binding TrackDuration}" Value="{Binding EndSeconds}" Increment="0.5" FormatString="0.00" />
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsEnabled="{Binding !IsBusy}">
      <Button Name="StartLoop" Content="{DynamicResource playerTools.startLoop}" Command="{Binding StartLoopCommand}" IsEnabled="{Binding CanLoop}" HorizontalAlignment="Stretch" />
      <Button Name="ClearLoop" Grid.Column="1" Content="{DynamicResource playerTools.clearLoop}" Command="{Binding ClearLoopCommand}" IsEnabled="{Binding LoopActive}" HorizontalAlignment="Stretch" />
    </Grid>
    <TextBlock Name="ToolFeedback" Text="{Binding Feedback}" Foreground="{DynamicResource EchoAccent}" TextWrapping="Wrap" FontSize="12" />
  </StackPanel>
</UserControl>
