<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Player.PlayerVolumePanel" x:DataType="shell:ShellViewModel">
  <UserControl.Styles><StyleInclude Source="PlayerBarStyles.axaml" /></UserControl.Styles>
  <StackPanel Width="280" Spacing="16">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="播放控制" Classes="heading" FontSize="16" /><TextBlock Grid.Column="1" Text="{Binding Player.ZoneName}" Classes="muted" FontSize="12" VerticalAlignment="Center" /></Grid>
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="音量" Classes="heading" /><TextBlock Name="VolumeReadout" Grid.Column="1" Text="{Binding Player.VolumeText}" Classes="muted" /></Grid>
    <Slider Name="VolumeSlider" Classes="player-rail" Minimum="0" Maximum="1" Value="{Binding Player.Volume, Mode=OneWay}" IsMoveToPointEnabled="True" SmallChange="0.01" LargeChange="0.1" AutomationProperties.Name="音量" />
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <Button Name="MuteButton" Classes="icon" Click="ToggleMute" ToolTip.Tip="静音 / 恢复音量" AutomationProperties.Name="静音 / 恢复音量"><icon:EchoIcon Scope="player" Kind="volume" Width="20" Height="20" /></Button>
      <TextBlock Grid.Column="1" Text="使用方向键微调音量" Classes="muted" FontSize="12" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="100%" Click="ResetVolume" ToolTip.Tip="恢复最大音量" />
    </Grid>
    <Border Height="1" Background="{DynamicResource EchoDivider}" />
    <TextBlock Text="{Binding Player.OutputName}" Classes="muted" TextTrimming="CharacterEllipsis" />
    <TextBlock Text="{Binding Player.Error}" IsVisible="{Binding Player.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" FontSize="12" />
  </StackPanel>
</UserControl>
