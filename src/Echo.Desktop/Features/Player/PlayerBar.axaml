<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
             xmlns:queue="using:Echo.Desktop.Features.Queue" xmlns:motion="using:Echo.Desktop.Motion"
             xmlns:player="using:Echo.Desktop.Features.Player" xmlns:floating="using:Echo.Desktop.Features.Floating"
             x:Class="Echo.Desktop.Features.Player.PlayerBar" x:DataType="shell:ShellViewModel">
  <UserControl.Styles><StyleInclude Source="PlayerBarStyles.axaml" /></UserControl.Styles>
  <Grid>
  <icon:MeasuredWaveform Name="TopWaveform" Envelope="{Binding AppearanceVisuals.Envelope}" Position="{Binding Player.Position}" IsVisible="{Binding AppearanceVisuals.TopWaveform}" Brush="{DynamicResource EchoAccent}" Height="20" VerticalAlignment="Top" Margin="0,-20,0,0" IsHitTestVisible="False" />
  <Border Name="BarSurface" Background="{DynamicResource EchoPlayer}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource EchoBorder}" Padding="14,6,28,6">
    <Grid ColumnDefinitions="*,691.2,*" ColumnSpacing="16" Name="PlayerLayout" Background="{DynamicResource EchoPlayerGlow}">
      <Border Name="NowPlayingHost" Background="Transparent" ClipToBounds="True">
      <Grid Name="NowPlaying" ColumnDefinitions="84,*" ColumnSpacing="14" VerticalAlignment="Center" ClipToBounds="True">
        <Button Name="CoverButton" Classes="player-cover" Width="84" Height="84" Padding="0"
                Command="{Binding OpenNowPlayingCommand}" ToolTip.Tip="{Binding Player.NowPlayingViewLabel}" AutomationProperties.Name="{Binding Player.NowPlayingViewLabel}">
          <Grid Width="{Binding #CoverButton.Bounds.Width}" Height="{Binding #CoverButton.Bounds.Height}"><queue:QueueArtwork Name="CoverArtwork" IsVisible="{Binding Player.HasTrack}" Width="84" Height="84" CornerRadius="{DynamicResource EchoCoverRadius}" Cache="{Binding AlbumArtwork}" FilePath="{Binding Player.CurrentFilePath}" />
            <Border IsVisible="{Binding !Player.HasTrack}" Background="{DynamicResource EchoPanelMuted}" CornerRadius="11"><icon:GlyphIcon Kind="music" Width="26" Height="26" Stroke="{DynamicResource EchoSubtle}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          </Grid>
        </Button>
        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center" ClipToBounds="True">
          <TextBlock Text="{Binding Player.Details.Title}" IsVisible="{Binding Player.HasTrack}" Classes="heading" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Player.Details.Title}" />
          <TextBlock Text="{DynamicResource player.idleTitle}" IsVisible="{Binding !Player.HasTrack}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Player.Details.Artist}" IsVisible="{Binding Player.HasTrack}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Player.Details.ArtistAlbum}" />
          <TextBlock Text="{DynamicResource player.idleHint}" IsVisible="{Binding !Player.HasTrack}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="6" Height="20" IsVisible="{Binding Player.HasTrack}">
            <Border Classes="player-chip"><Grid><TextBlock Text="{Binding Player.Subtitle}" IsVisible="{Binding Player.HasTrack}" /><TextBlock Text="{DynamicResource ui.PlayerBar.b073db9c0bd6}" IsVisible="{Binding !Player.HasTrack}" /></Grid></Border>
            <Button Classes="player-chip format" IsVisible="{Binding Player.Details.HasFormat}" Click="OpenSignalPath" Padding="6,1" MinHeight="0" ToolTip.Tip="{DynamicResource ui.PlayerBar.a8cc3c4658a5}"><TextBlock Text="{Binding Player.Details.Format}" /></Button>
          </StackPanel>
          <TextBlock Text="{Binding Player.Error}" IsVisible="{Binding Player.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Player.Error}" />
          <TextBlock Text="{Binding Player.Details.Message}" IsVisible="{Binding Player.Details.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Player.Details.Message}" />
        </StackPanel>
      </Grid>
      </Border>
      <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
        <StackPanel Name="Transport" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Name="SignalPathButton" Classes="transport" ToolTip.Tip="{DynamicResource ui.PlayerBar.a8cc3c4658a5}" AutomationProperties.Name="{DynamicResource ui.PlayerBar.a8cc3c4658a5}">
            <icon:SignalPathStateIcon State="{Binding Player.SignalIconState}" Width="28" Height="28" />
          </Button>
          <Button Name="FavoriteButton" Classes="transport" Classes.active="{Binding Player.Details.IsFavorite}" IsEnabled="{Binding Player.Details.CanFavorite}"
                  Command="{Binding Player.Details.ToggleFavoriteCommand}" ToolTip.Tip="{Binding Player.Details.FavoriteLabel}" AutomationProperties.Name="{Binding Player.Details.FavoriteLabel}">
            <icon:GlyphIcon Kind="{Binding Player.Details.HeartIcon}" Width="23" Height="23" StrokeWidth="1.8" />
          </Button>
          <Button Name="PreviousButton" Classes="transport" IsEnabled="{Binding Player.CanControl}" Command="{Binding Player.PreviousCommand}" ToolTip.Tip="{DynamicResource ui.LyricsTransportView.8c747908bf69}" AutomationProperties.Name="{DynamicResource ui.LyricsTransportView.8c747908bf69}"><icon:EchoIcon Scope="player" Kind="previous" Width="22" Height="22" /></Button>
          <Button Name="PlayButton" Classes="transport play" IsEnabled="{Binding Player.CanStartPlayback}" Command="{Binding Player.ToggleCommand}" ToolTip.Tip="{DynamicResource ui.LyricsTransportView.f03e2b5312a8}" AutomationProperties.Name="{DynamicResource ui.LyricsTransportView.f03e2b5312a8}"><icon:EchoIcon Scope="player" Kind="{Binding Player.PlayIcon}" Width="35" Height="35" BaseBrush="{Binding $parent[Button].Foreground}" AccentBrush="{DynamicResource EchoAccent}" /></Button>
          <Button Name="NextButton" Classes="transport" IsEnabled="{Binding Player.CanControl}" Command="{Binding Player.NextCommand}" ToolTip.Tip="{DynamicResource ui.LyricsTransportView.486e42475adb}" AutomationProperties.Name="{DynamicResource ui.LyricsTransportView.486e42475adb}"><icon:EchoIcon Scope="player" Kind="next" Width="22" Height="22" /></Button>
          <Button Name="ModeButton" Classes="transport" Classes.active="{Binding Player.IsSpecialMode}" Command="{Binding Player.CycleRepeatCommand}" ToolTip.Tip="{Binding Player.RepeatText}" AutomationProperties.Name="{Binding Player.RepeatText}">
            <Grid><icon:EchoIcon Scope="player" Kind="{Binding Player.TransportModeIcon}" Width="24" Height="24" /><Border Width="12" Height="2" Background="{DynamicResource EchoAccentText}" VerticalAlignment="Bottom" Margin="0,0,0,-5" IsVisible="{Binding Player.IsSpecialMode}" /></Grid>
          </Button>
          <Button Name="LyricsButton" Classes="transport" Command="{Binding OpenNowPlayingCommand}" ToolTip.Tip="{Binding Player.NowPlayingViewLabel}" AutomationProperties.Name="{Binding Player.NowPlayingViewLabel}"><icon:EchoIcon Scope="player" Kind="lyrics" Width="20" Height="20" /></Button>
        </StackPanel>
        <Grid ColumnDefinitions="48,*,48" ColumnSpacing="10" Height="24" IsVisible="{Binding !Player.IsLiveStream}">
          <TextBlock Name="ElapsedText" Text="{Binding Player.PositionText}" FontSize="12" Classes="muted" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center" />
          <icon:PlayerWaveformSlider Name="SeekSlider" EnergyEnvelope="{Binding AppearanceVisuals.EnergyEnvelope}" Grid.Column="1" Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Position, Mode=OneWay}"
                  Seed="{Binding Player.CurrentFilePath}" IsEnabled="{Binding Player.CanSeek}" SmallChange="5" LargeChange="10" AutomationProperties.Name="{DynamicResource ui.PlayerBar.fc16e2a0fca6}" />
          <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="12" Classes="muted" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
        <StackPanel IsVisible="{Binding Player.IsLiveStream}" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Ellipse Width="5" Height="5" Fill="{DynamicResource EchoAccentText}" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource ui.PlayerBar.e472b37cf9ad}" Foreground="{DynamicResource EchoAccentText}" FontSize="12" FontWeight="Medium" />
          <TextBlock Text="{Binding Player.LiveStatus}" Classes="muted" FontSize="12" />
          <TextBlock Text="{Binding Player.PositionText}" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Button Name="QueueButton" Classes="transport" Command="{Binding ToggleQueueDrawerCommand}" ToolTip.Tip="{DynamicResource ui.PlayerBar.6edf6b969da4}" AutomationProperties.Name="{DynamicResource ui.PlayerBar.f01b6815d826}"><icon:GlyphIcon Kind="queue" Width="22" Height="22" /></Button>
        <Button Name="OutputSettingsButton" Classes="transport" ToolTip.Tip="{DynamicResource ui.PlayerBar.38844b135cf7}" AutomationProperties.Name="{DynamicResource ui.PlayerBar.38844b135cf7}">
          <icon:EchoIcon Scope="player" Kind="more" Width="22" Height="22" />
          <Button.Flyout><motion:MotionFlyout Placement="Top"><ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto"><StackPanel Width="320" Spacing="8">
            <TextBlock Text="{Binding Player.Details.Title}" Classes="heading" FontSize="16" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Player.Details.ArtistAlbum}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Player.Details.Specifications}" IsVisible="{Binding Player.Details.HasSpecifications}" Classes="muted" />
            <Border Height="1" Background="{DynamicResource EchoDivider}" Margin="0,4" />
            <Button Content="{DynamicResource ui.PlayerBar.2274070f191c}" Click="OpenFiles" HorizontalAlignment="Stretch" />
            <Button Content="{DynamicResource ui.PlayerBar.e63af6420456}" Click="OpenLyrics" HorizontalAlignment="Stretch" />
            <Expander Header="{DynamicResource playerTools.title}" HorizontalAlignment="Stretch" IsVisible="{Binding Player.Tools, Converter={x:Static ObjectConverters.IsNotNull}}"><player:PlayerToolsPanel DataContext="{Binding Player.Tools}" Margin="0,10,0,0" /></Expander>
            <Button Name="MiniPlayerToggle" Content="{DynamicResource floating.mini}" Command="{Binding Floating.ToggleMiniCommand}" HorizontalAlignment="Stretch" />
            <Button Name="DesktopLyricsToggle" Content="{DynamicResource floating.lyrics}" Command="{Binding Floating.ToggleLyricsCommand}" HorizontalAlignment="Stretch" />
            <Expander Header="{DynamicResource floating.title}" HorizontalAlignment="Stretch"><ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto"><floating:FloatingSettingsView Margin="0,10,0,0" /></ScrollViewer></Expander>
            <Button Content="{DynamicResource ui.PlayerBar.f01b6815d826}" Click="OpenQueue" HorizontalAlignment="Stretch" />
            <Button Content="{DynamicResource ui.PlayerBar.a8cc3c4658a5}" Click="OpenSignalPath" HorizontalAlignment="Stretch" />
            <Button Content="{DynamicResource ui.PlayerBar.ff71ead6e0d9}" Click="OpenOutputSettings" HorizontalAlignment="Stretch" />
            <Button Content="{DynamicResource ui.PlayerBar.f867a4c836db}" Command="{Binding Player.RecoverCommand}" IsEnabled="{Binding Player.CanControl}" HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding Player.Error}" IsVisible="{Binding Player.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Player.Details.Message}" IsVisible="{Binding Player.Details.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel></ScrollViewer></motion:MotionFlyout></Button.Flyout>
        </Button>
        <Button Name="VolumeButton" Classes="transport" ToolTip.Tip="{Binding Player.VolumeText}" AutomationProperties.Name="{DynamicResource ui.PlayerBar.8bf8b9780d34}">
          <icon:GlyphIcon Kind="sliders" Width="25" Height="25" />
          <Button.Flyout><motion:MotionFlyout Placement="TopEdgeAlignedRight" VerticalOffset="-6"><player:PlayerVolumePanel /></motion:MotionFlyout></Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
  </Grid>
</UserControl>
