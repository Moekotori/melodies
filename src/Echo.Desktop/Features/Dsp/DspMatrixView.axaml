<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Dsp.DspMatrixView" x:DataType="local:DspViewModel">
  <ScrollViewer Name="SpatialScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <local:DspWorkbenchSplit Name="SpatialWorkbench" StretchContent="True" MinHeight="{Binding #SpatialScroller.Viewport.Height}">
        <Border Classes="dsp-plot">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <TextBlock Text="{DynamicResource ui.DspMatrixView.b08cc0e5a2ae}" Classes="dsp-note"/>
            <local:DspDiagramControl Kind="matrix" Name="SpatialDiagram" Grid.Row="1" UseThemeSurface="True" MinHeight="260" MaxHeight="760" Margin="0,6,0,6"/>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding SpatialMetrics}" Margin="0,18,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:DspColumns MinimumColumnWidth="150" MaximumColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:DspMetric"><StackPanel Spacing="8" Margin="0,0,12,12"><TextBlock Text="{Binding Label}" Classes="muted" FontSize="12"/><TextBlock Text="{Binding Value}" FontSize="25" FontWeight="Medium"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
        <Border Classes="dsp-rule" Padding="0,0,0,0" BorderThickness="0">
          <StackPanel Spacing="28" VerticalAlignment="Center">
            <StackPanel Spacing="18">
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource ui.DspMatrixView.9460f5ecea8b}" Classes="dsp-section-title"/>
            </StackPanel>
            <WrapPanel>
              <Button Content="{DynamicResource ui.DspMatrixView.fd4f079be4ac}" Classes="dsp-quiet" Command="{Binding MatrixPresetCommand}" CommandParameter="identity" IsEnabled="{Binding CanEdit}"/>
              <Button Content="{DynamicResource ui.DspMatrixView.0ea3fd8d5741}" Classes="dsp-quiet" Command="{Binding MatrixPresetCommand}" CommandParameter="swap" IsEnabled="{Binding CanEdit}"/>
              <Button Content="{DynamicResource ui.DspMatrixView.d64650de26d2}" Classes="dsp-quiet" Command="{Binding MatrixPresetCommand}" CommandParameter="mono" IsEnabled="{Binding CanEdit}"/>
              <Button Content="Mid / Side" Classes="dsp-quiet" Command="{Binding MatrixPresetCommand}" CommandParameter="midSide" IsEnabled="{Binding CanEdit}"/>
            </WrapPanel>
            </StackPanel>
            <StackPanel Spacing="30" IsEnabled="{Binding CanEdit}">
              <local:DspColumns MinimumColumnWidth="180" MaximumColumns="2">
                <local:DspParameterEditor DataContext="{Binding Fields[leftToLeft]}"/>
                <local:DspParameterEditor DataContext="{Binding Fields[rightToLeft]}"/>
                <local:DspParameterEditor DataContext="{Binding Fields[leftToRight]}"/>
                <local:DspParameterEditor DataContext="{Binding Fields[rightToRight]}"/>
              </local:DspColumns>
            </StackPanel>
          </StackPanel>
        </Border>
    </local:DspWorkbenchSplit>
  </ScrollViewer>
</UserControl>
