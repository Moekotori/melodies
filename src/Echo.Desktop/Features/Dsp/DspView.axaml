<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Dsp.DspView" x:DataType="local:DspViewModel">
  <UserControl.Styles>
    <StyleInclude Source="DspStyles.axaml" />
  </UserControl.Styles>
  <Grid Name="Workbench" ColumnDefinitions="232,*">
    <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,1,0" Background="{DynamicResource EchoSidebar}">
      <Grid RowDefinitions="Auto,Auto,*" Margin="8,14,0,10">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,8,0">
          <TextBlock Text="ECHO" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource EchoHeading}" VerticalAlignment="Center" />
          <TextBlock Text="DSP" FontSize="11" Classes="muted" VerticalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,0,1" Margin="8,12,12,0" Padding="0,0,0,10">
          <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
            <icons:GlyphIcon Kind="speaker" Width="16" Height="16" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Text="{Binding OutputName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding OutputRate}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
        <ListBox Grid.Row="2" Name="ModuleList" Classes="dsp-navigation" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </Grid>
    </Border>
    <Grid Name="Workspace" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="16,6,18,6">
      <Grid Name="Header" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,8" IsVisible="{Binding !IsEq}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource LibraryPopupSelected}" VerticalAlignment="Center">
            <icons:GlyphIcon Kind="{Binding SelectedModule.Icon}" Width="18" Height="18" Stroke="{DynamicResource EchoAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding SelectedModule.Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" />
              <TextBlock Text="{Binding SelectedModule.Badge}" IsVisible="{Binding SelectedModule.HasBadge}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding SelectedModule.Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <StackPanel Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" CornerRadius="7" Padding="8,4" Background="{DynamicResource EchoField}" IsVisible="{Binding IsReady}">
            <TextBlock Text="{Binding ConfirmedStatus}" FontSize="12" Classes="muted" />
          </Border>
          <ToggleSwitch IsVisible="{Binding HasEnable}" OnContent="开启" OffContent="旁路" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
          <Button Classes="dsp-quiet" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="重新读取">
            <icons:GlyphIcon Kind="refresh" Width="15" Height="15" />
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <local:EqEditorView IsVisible="{Binding IsEq}" />
        <local:DspHeadphoneView IsVisible="{Binding IsHeadphone}" />
        <ScrollViewer IsVisible="{Binding ShowGeneric}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="2,4,8,12">
            <StackPanel IsVisible="{Binding IsPending}" Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
              <TextBlock Text="{Binding PendingDescription}" TextWrapping="Wrap" Classes="muted" />
              <Button Content="打开音频设置" Command="{Binding OpenOutputCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsReady}" Spacing="16">
              <StackPanel IsVisible="{Binding IsReplayGain}" Spacing="12" IsEnabled="{Binding CanEdit}" MaxWidth="420">
                <TextBlock Text="增益来源" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ReplayModes}" SelectedItem="{Binding ReplayMode, Mode=TwoWay}" MinWidth="220" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:DspChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="防止削波" IsChecked="{Binding PreventClipping, Mode=TwoWay}" />
                <TextBlock Text="{Binding ReplayFacts}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsListening}" Spacing="10" MaxWidth="520">
                <TextBox Watermark="方案名称" Text="{Binding ListeningName}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="保存当前处理链" Command="{Binding SaveListeningCommand}" IsEnabled="{Binding !IsBusy}" />
                  <Button Content="套用" Classes="dsp-quiet" Command="{Binding ApplyListeningCommand}" IsEnabled="{Binding !IsBusy}" />
                  <Button Content="删除" Classes="dsp-quiet" Command="{Binding DeleteListeningCommand}" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" MaxHeight="240">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:DspListeningProfile">
                      <TextBlock Text="{Binding Name}" FontSize="13" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsOutput}" Spacing="8" MaxWidth="640">
                <TextBlock Text="{Binding OutputFacts}" TextWrapping="Wrap" />
                <TextBlock Text="升频使用整数倍窗函数，目标采样率就是当前设备采样率乘上倍率。共享输出可能不会走这条路径；DoP 需要独占或 ASIO。" TextWrapping="Wrap" Classes="muted" FontSize="12" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsRoom}" Spacing="8" MaxWidth="640">
                <TextBlock Text="{Binding RoomFacts}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="导入脉冲" Click="ImportRoom" IsEnabled="{Binding CanEdit}" />
                  <Button Content="清除脉冲" Classes="dsp-quiet" Command="{Binding ClearImpulseCommand}" IsEnabled="{Binding CanEdit}" />
                </StackPanel>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsChannel}" Orientation="Horizontal" Spacing="8">
                <Button Content="左右对调" Classes="dsp-quiet" Command="{Binding SwapChannelsCommand}" IsEnabled="{Binding CanEdit}" />
                <Button Content="恢复居中" Classes="dsp-quiet" Command="{Binding ResetChannelCommand}" IsEnabled="{Binding CanEdit}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Choices}" IsEnabled="{Binding CanEdit}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:DspChoiceField">
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="16" Margin="0,0,0,12">
                      <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="180">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="local:DspChoice">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Toggles}" IsEnabled="{Binding CanEdit}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:DspToggle">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Value, Mode=TwoWay}" Margin="0,0,0,8" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Parameters}" IsEnabled="{Binding CanEdit}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:DspParameter">
                    <Grid ColumnDefinitions="*,108" ColumnSpacing="20" Margin="0,2,0,14">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                        <Slider Classes="dsp-fader" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding Value, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Unit}" Classes="muted" FontSize="10" />
                        <NumericUpDown Classes="dsp-value" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="{Binding Step}" Value="{Binding Value, Mode=TwoWay}" FormatString="0.##" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <local:DspRackView IsVisible="{Binding IsRack}" IsEnabled="{Binding CanEdit}" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" IsVisible="{Binding !IsReady}" TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
        </ScrollViewer>
        <ProgressBar Height="2" VerticalAlignment="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" IsHitTestVisible="False" />
      </Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,10,0,2" IsVisible="{Binding IsReady}">
        <Grid Name="Footer" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding DraftLabel}" FontSize="12" Classes="muted" />
            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource EchoAccentText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ToggleButton Content="A" IsChecked="{Binding IsComparisonA, Mode=OneWay}" Command="{Binding CompareCommand}" CommandParameter="A" IsEnabled="{Binding CanEdit}" ToolTip.Tip="切换到对比 A" />
            <ToggleButton Content="B" IsChecked="{Binding IsComparisonB, Mode=OneWay}" Command="{Binding CompareCommand}" CommandParameter="B" IsEnabled="{Binding CanEdit}" ToolTip.Tip="切换到对比 B" />
            <Button Content="撤销" Classes="dsp-quiet" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
            <Button Content="还原" Classes="dsp-quiet" Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert}" />
            <Button Name="ApplyButton" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Classes="primary" Padding="16,7" Margin="6,0,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
