<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Dsp.DspView" x:DataType="local:DspViewModel">
  <UserControl.Styles>
    <StyleInclude Source="DspStyles.axaml" />
  </UserControl.Styles>
  <Grid Name="Workbench" ColumnDefinitions="232,*">
    <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,1,0" Background="{DynamicResource EchoSidebar}">
      <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18,24,14,16">
        <StackPanel Spacing="3" Margin="8,0,0,22">
          <TextBlock Text="DSP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource EchoMuted}" LetterSpacing="2" />
          <TextBlock Text="ECHO" FontFamily="Georgia, DejaVu Serif" FontSize="34" Foreground="{DynamicResource EchoHeading}" />
          <TextBlock Text="Signal Control" FontSize="11" Classes="muted" />
        </StackPanel>
        <ListBox Grid.Row="1" Name="ModuleList" Classes="dsp-navigation" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
        <ToggleButton Grid.Row="2" Classes="dsp-advanced-toggle" Content="高级处理" IsChecked="{Binding AdvancedExpanded, Mode=TwoWay}" Margin="0,10,0,12" HorizontalContentAlignment="Left" />
        <Border Grid.Row="3" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="6,16,0,0">
          <Grid ColumnDefinitions="18,*" ColumnSpacing="10">
            <icons:GlyphIcon Kind="speaker" Width="17" Height="17" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{Binding OutputName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding OutputRate}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>


    </Border>
    <Grid Name="Workspace" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="28,24,28,16">
      <Grid Name="Header" ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,20">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding SelectedModule.Title}" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" />
            <TextBlock Text="{Binding SelectedModule.Badge}" IsVisible="{Binding SelectedModule.HasBadge}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding SelectedModule.Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="dsp-chip" IsVisible="{Binding IsReady}">
            <TextBlock Text="{Binding ConfirmedStatus}" FontSize="12" Classes="muted" />
          </Border>
          <ToggleSwitch IsVisible="{Binding HasEnable}" OnContent="开启" OffContent="旁路" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
          <Button Classes="dsp-quiet" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="重新读取">
            <icons:GlyphIcon Kind="refresh" Width="15" Height="15" />
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <local:EqEditorView IsVisible="{Binding IsEq}" />
        <local:DspHeadphoneView IsVisible="{Binding IsHeadphone}" />
        <local:DspGenericView IsVisible="{Binding ShowGeneric}" />
        <ProgressBar Height="2" VerticalAlignment="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" IsHitTestVisible="False" />
      </Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,14,0,0" IsVisible="{Binding IsReady}">
        <Grid Name="Footer" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding DraftLabel}" FontSize="12" Classes="muted" />
            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource EchoAccentText}" />
          </StackPanel>
          <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding !IsListening}">
            <ToggleButton Classes="dsp-compare" Content="A" IsChecked="{Binding IsComparisonA, Mode=OneWay}" Command="{Binding CompareCommand}" CommandParameter="A" IsEnabled="{Binding CanEdit}" ToolTip.Tip="切换到对比 A" />
            <ToggleButton Classes="dsp-compare" Content="B" IsChecked="{Binding IsComparisonB, Mode=OneWay}" Command="{Binding CompareCommand}" CommandParameter="B" IsEnabled="{Binding CanEdit}" ToolTip.Tip="切换到对比 B" />
            <Button Content="撤销" Classes="dsp-quiet" Margin="8,0,0,0" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
            <Button Content="还原" Classes="dsp-quiet" Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert}" />
            <Button Name="ApplyButton" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Classes="primary" Padding="16,7" Margin="6,0,0,0" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
