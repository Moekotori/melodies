<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Dsp.DspView" x:DataType="local:DspViewModel">
  <UserControl.Styles>
    <StyleInclude Source="DspStyles.axaml" />
  </UserControl.Styles>
  <Grid Name="Workbench" ColumnDefinitions="232,*">
    <Border Name="NavigationSurface" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,1,0" Background="{DynamicResource EchoSidebar}">
      <Grid Name="NavigationLayout" RowDefinitions="Auto,*,Auto" Margin="12,20,12,18">
        <StackPanel Name="Brand" Spacing="2" Margin="12,0,0,20">
          <TextBlock Text="DSP" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource EchoMuted}" />
          <TextBlock Text="ECHO" FontFamily="Georgia, DejaVu Serif" FontSize="33" Foreground="{DynamicResource EchoHeading}" />
          <TextBlock Text="Signal Control" FontSize="12" Classes="muted" />
        </StackPanel>
        <ListBox Grid.Row="1" Name="ModuleList" Classes="dsp-navigation" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        <Border Name="OutputSummary" Grid.Row="2" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="10,14,10,0">
          <Grid ColumnDefinitions="18,*" ColumnSpacing="10">
            <icons:GlyphIcon Kind="speaker" Width="17" Height="17" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{Binding OutputName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding OutputRate}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Grid Name="Workspace" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="24,0,24,16">
      <Grid Name="Header" IsVisible="{Binding !IsEq}" ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,18" MinHeight="72">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{DynamicResource LibraryPopupSelected}" CornerRadius="8" Width="36" Height="36"><icons:GlyphIcon Kind="{Binding SelectedModule.Icon}" Width="20" Height="20" Stroke="{DynamicResource EchoAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="{Binding SelectedModule.Title}" Classes="page-title" FontSize="20" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SelectedModule.Badge}" IsVisible="{Binding SelectedModule.HasBadge}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="dsp-chip" IsVisible="{Binding IsReady}">
            <TextBlock Text="{Binding ConfirmedStatus}" FontSize="12" Classes="muted" />
          </Border>
          <ToggleSwitch IsVisible="{Binding HasEnable}" OnContent="开启" OffContent="旁路" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
          <Button Classes="dsp-quiet" Command="{Binding RefreshPageCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{DynamicResource ui.DspView.df7392cc96be}">
            <StackPanel Orientation="Horizontal" Spacing="6"><icons:GlyphIcon Kind="refresh" Width="14" Height="14" /><TextBlock Text="{DynamicResource ui.DspView.aee887434131}" FontSize="12" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <local:DspModuleHost />
        <TextBlock Text="{Binding Message}" IsVisible="{Binding !IsReady}" Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" />
        <ProgressBar Height="2" VerticalAlignment="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" IsHitTestVisible="False" />
      </Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,14,0,0" IsVisible="{Binding IsReady}">
        <Grid Name="Footer" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding DraftLabel}" FontSize="12" Classes="muted" />
            <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource EchoAccentText}" />
          </StackPanel>
          <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding !IsListening}">
            <ToggleButton Classes="dsp-compare" Content="A" IsChecked="{Binding IsComparisonA, Mode=OneWay}" Command="{Binding CompareCommand}" CommandParameter="A" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{DynamicResource ui.DspView.a1a3905678dc}" />
            <ToggleButton Classes="dsp-compare" Content="B" IsChecked="{Binding IsComparisonB, Mode=OneWay}" Command="{Binding CompareCommand}" CommandParameter="B" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{DynamicResource ui.DspView.04a05c7c1700}" />
            <Button Content="{DynamicResource ui.DspView.926a50b98ece}" Classes="dsp-quiet" Margin="8,0,0,0" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
            <Button Content="{DynamicResource ui.DspView.ddde08946298}" Classes="dsp-quiet" Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert}" />
            <Button Name="ApplyButton" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Classes="primary" Padding="16,7" Margin="6,0,0,0" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
