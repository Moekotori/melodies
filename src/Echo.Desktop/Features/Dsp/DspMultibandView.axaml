<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Dsp.DspMultibandView" x:DataType="local:DspViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="24" Margin="0,0,12,24">
      <local:DspDynamicsStatus/>
      <StackPanel Spacing="7">
        <TextBlock Text="{DynamicResource ui.DspMultibandView.e68fbd92c8df}" Classes="dsp-section-title"/>
        <TextBlock Text="{DynamicResource ui.DspMultibandView.a415aca1cd6c}" Classes="dsp-note" TextWrapping="Wrap"/>
      </StackPanel>
      <ListBox Classes="dsp-segments" ItemsSource="{Binding CompressionBands}" SelectedItem="{Binding CompressionBand, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:DspChoice">
            <TextBlock Text="{Binding Label}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Spacing="8"><TextBlock Text="分频 · 拖动分界或点选频段" FontSize="14" FontWeight="Medium"/><local:DspDiagramControl Kind="multibandBands" UseThemeSurface="True" Height="155"/></StackPanel>
      <local:DspColumns MinimumColumnWidth="300" MaximumColumns="3">
        <Border Classes="dsp-section">
          <StackPanel Spacing="18">
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource ui.DspMultibandView.30c24806eff7}" Classes="dsp-section-title"/>
            </StackPanel>
            <StackPanel Spacing="18" IsEnabled="{Binding CanEdit}">
              <local:DspParameterEditor DataContext="{Binding Fields[lowCrossoverHz]}"/>
              <local:DspParameterEditor DataContext="{Binding Fields[highCrossoverHz]}"/>
              <local:DspParameterEditor DataContext="{Binding Fields[mix]}"/>
              <local:DspParameterEditor DataContext="{Binding Fields[stereoLink]}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="dsp-section">
          <StackPanel Spacing="18">
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource ui.DspMultibandView.5f69b57b4826}" Classes="dsp-section-title"/>
<local:DspToggleEditor DataContext="{Binding BandSwitches[enabled]}"/>
            </StackPanel>
            <StackPanel Spacing="18" IsEnabled="{Binding CanEdit}">
              <local:DspColumns MinimumColumnWidth="180" MaximumColumns="2">
                <local:DspParameterEditor DataContext="{Binding BandFields[thresholdDb]}"/>
                <local:DspParameterEditor DataContext="{Binding BandFields[ratio]}"/>
                <local:DspParameterEditor DataContext="{Binding BandFields[makeupDb]}"/>
                <local:DspParameterEditor DataContext="{Binding BandFields[kneeDb]}"/>


              </local:DspColumns>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="dsp-section"><StackPanel Spacing="18"><TextBlock Text="快慢" Classes="dsp-section-title"/><StackPanel Spacing="18" IsEnabled="{Binding CanEdit}"><local:DspParameterEditor DataContext="{Binding BandFields[attackMs]}"/><local:DspParameterEditor DataContext="{Binding BandFields[releaseMs]}"/></StackPanel></StackPanel></Border>
      </local:DspColumns>
      <Border Classes="dsp-rule" Padding="0,18,0,0"><StackPanel Spacing="8"><TextBlock Text="衰减轨迹" FontSize="14" FontWeight="Medium"/><local:DspDiagramControl Kind="history" UseThemeSurface="True" Height="145"/></StackPanel></Border>
      <Border Classes="dsp-section">
        <StackPanel Spacing="18">
          <StackPanel Spacing="7">
            <TextBlock Text="{DynamicResource ui.DspMultibandView.86866cddb0e5}" Classes="dsp-section-title"/>
          </StackPanel>
          <local:DspRuntimeReadout/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
