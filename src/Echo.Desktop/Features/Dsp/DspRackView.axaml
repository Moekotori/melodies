<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Dsp.DspRackView" x:DataType="local:DspViewModel">
  <StackPanel Spacing="20">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{DynamicResource ui.DspRackView.9cf2defcdd1f}" Classes="dsp-note"/><TextBlock Grid.Column="1" Text="{Binding DraftLabel}" Classes="dsp-note"/></Grid>
    <Grid Name="RackLayout" ColumnDefinitions="280,*" ColumnSpacing="28" RowSpacing="24">
      <StackPanel Spacing="12">
        <TextBlock Text="{DynamicResource ui.DspRackView.2b1058e01be3}" Classes="dsp-section-title" />
        <ListBox Name="RackOrderList" Classes="dsp-rack" ItemsSource="{Binding RackRows}" SelectedItem="{Binding SelectedRack, Mode=TwoWay}" MaxHeight="560" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:DspRackRow">
              <Grid ColumnDefinitions="32,20,*" ColumnSpacing="10" Margin="0,10">
                <TextBlock Text="{Binding PositionLabel}" FontSize="12" Classes="muted" VerticalAlignment="Center"/>
                <icons:GlyphIcon Grid.Column="1" Kind="sequence" Width="15" Height="15" VerticalAlignment="Center" Opacity="0.65" />
                <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RoleLabel}" FontSize="12" Classes="muted"/></StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel>
          <Button Content="{DynamicResource ui.DspRackView.f853a70b1204}" Classes="dsp-quiet" Command="{Binding MoveRackUpCommand}" IsEnabled="{Binding CanMoveRackUp}" />
          <Button Content="{DynamicResource ui.DspRackView.e75e8b4e5c97}" Classes="dsp-quiet" Command="{Binding MoveRackDownCommand}" IsEnabled="{Binding CanMoveRackDown}" />
          <Button Content="{DynamicResource ui.DspRackView.63d90d977348}" Classes="dsp-quiet" Command="{Binding DuplicateRackFilterCommand}" IsEnabled="{Binding CanRemoveRackFilter}" />
          <Button Content="{DynamicResource ui.DspRackView.2f9daa828907}" Classes="dsp-quiet" Command="{Binding RemoveRackFilterCommand}" IsEnabled="{Binding CanRemoveRackFilter}" />
        </WrapPanel>
      </StackPanel>
      <StackPanel Name="RackDetails" Grid.Column="1" Spacing="16">
        <TextBlock Text="{Binding SelectedRack.Label}" FontSize="18" FontWeight="SemiBold" />
        <local:DspImpulsePicker IsVisible="{Binding IsConvolutionRackFilter}" />
        <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled"><ContentControl Content="{Binding RackEditor}" /></ScrollViewer>
      </StackPanel>
    </Grid>
    <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
      <WrapPanel>
        <ComboBox ItemsSource="{Binding RackFilterKinds}" SelectedItem="{Binding RackFilterKind, Mode=TwoWay}" MinWidth="200" Margin="0,0,10,8">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="local:DspChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="{DynamicResource ui.DspRackView.c4d88220ec61}" Command="{Binding AddRackFilterCommand}" />
      </WrapPanel>
    </Border>
  </StackPanel>
</UserControl>
