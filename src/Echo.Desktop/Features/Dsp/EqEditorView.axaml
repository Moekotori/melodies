<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Dsp.EqEditorView" x:DataType="local:DspViewModel">
  <UserControl.Styles><StyleInclude Source="DspStyles.axaml" /><StyleInclude Source="EqEditorStyles.axaml" /></UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
      <Grid Name="EqToolbar" ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,14,0,18" RowSpacing="10">
        <StackPanel Name="EqTitle" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Background="{DynamicResource EqSelection}" CornerRadius="10" Width="38" Height="38"><icons:GlyphIcon Kind="sliders" Width="21" Height="21" Stroke="{DynamicResource EchoAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="{DynamicResource ui.EqEditorView.32b2c4007dac}" Classes="page-title" FontSize="22" VerticalAlignment="Center" />
        </StackPanel>
        <WrapPanel Name="EqTools" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border CornerRadius="9" Background="{DynamicResource EqSurface}" BorderBrush="{DynamicResource EqSurfaceBorder}" BorderThickness="1" Padding="3" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Name="SimpleMode" Content="{DynamicResource ui.EqEditorView.aa55960e4b02}" Classes="dsp-compare eq-mode" IsChecked="{Binding IsEqSimple, Mode=OneWay}" Command="{Binding SetEqModeCommand}" CommandParameter="simple" ToolTip.Tip="{DynamicResource ui.EqEditorView.b82eec5c4fe6}" />
              <ToggleButton Name="ProMode" Content="{DynamicResource ui.EqEditorView.349b21c03d6a}" Classes="dsp-compare eq-mode" IsChecked="{Binding IsEqAdvanced, Mode=OneWay}" Command="{Binding SetEqModeCommand}" CommandParameter="pro" ToolTip.Tip="{DynamicResource ui.EqEditorView.2822fa3f3dce}" />
            </StackPanel>
          </Border>
          <ComboBox Name="PresetPicker" Classes="eq-preset" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" Width="180" MinHeight="36" IsEnabled="{Binding CanEdit}" Margin="0,0,10,0" ToolTip.Tip="{DynamicResource ui.EqEditorView.0d839e847b86}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EqPresetChoice"><TextBlock Text="{Binding Label}" FontSize="13" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleSwitch OnContent="开启" OffContent="旁路" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Button Classes="dsp-quiet eq-action" Command="{Binding RefreshPageCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{DynamicResource ui.EqEditorView.d57d557d2a10}" VerticalAlignment="Center"><icons:GlyphIcon Kind="refresh" Width="15" Height="15" /></Button>
        </WrapPanel>
      </Grid>
  <local:EqOverviewView Grid.Row="1" />
  <ScrollViewer Name="EditorScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,Auto" MinHeight="{Binding #EditorScroller.Viewport.Height}">
      <Border Name="EqPlot" Background="{DynamicResource EqPlotBackground}" BorderBrush="{DynamicResource EqSurfaceBorder}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" MinHeight="220">
        <Panel>
          <local:EqCurveControl Name="EqCurve" IsVisible="{Binding IsReady}" Margin="12,10" ToolTip.Tip="{DynamicResource ui.EqEditorView.df44a09e3ad9}" />
          <TextBlock Text="{Binding Message}" IsVisible="{Binding !IsReady}" Foreground="{DynamicResource DspPlotMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
        </Panel>
      </Border>
      <Border Grid.Row="1" IsVisible="{Binding IsEqAdvanced}" IsEnabled="{Binding CanEdit}" Background="{DynamicResource EqSurface}" BorderBrush="{DynamicResource EqSurfaceBorder}" BorderThickness="1" CornerRadius="10" Margin="0,10,0,0"><local:EqBandInspectorView Name="BandInspector" DataContext="{Binding SelectedBand}" Margin="16,0" /></Border>
      <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,8,0,0" IsVisible="{Binding IsEqAdvanced}">
        <TextBlock Text="{Binding CurveScopeLabel}" Classes="muted" FontSize="12" Margin="14,0,0,6" />
        <ListBox Grid.Row="1" Name="EqBands" Classes="dsp-bands" ItemContainerTheme="{StaticResource EqBandTile}" ItemsSource="{Binding Bands}" SelectedItem="{Binding SelectedBand, Mode=TwoWay}" Height="62" IsEnabled="{Binding CanEdit}" AutoScrollToSelectedItem="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:EqBandViewModel">
              <Grid ColumnDefinitions="5,*" ColumnSpacing="7" Width="60">
                <Ellipse Width="5" Height="5" Fill="{Binding Swatch}" VerticalAlignment="Top" Margin="0,5,0,0" />
                <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding FrequencyLabel}" FontSize="12" FontWeight="Medium" /><TextBlock Text="{Binding GainLabel}" FontSize="12" Classes="muted" /></StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Border Grid.Row="3" CornerRadius="10" Background="{DynamicResource EqSurface}" Padding="12,8" Margin="0,8,0,8" IsVisible="{Binding IsReady}"><Grid Name="PreampBar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" IsEnabled="{Binding CanEdit}">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource ui.EqEditorView.c8947d7d9a52}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding PreampDb, StringFormat={}{0:0.0} dB}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Slider Name="PreampFader" Grid.Column="1" Theme="{StaticResource EqFader}" Classes="dsp-fader" Minimum="-12" Maximum="6" Value="{Binding PreampDb, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
        <WrapPanel Name="PreampActions" Grid.Column="2" Orientation="Horizontal">
          <Button Content="{DynamicResource ui.EqEditorView.58c4b1b11d39}" Classes="dsp-quiet eq-action" Command="{Binding AutoPreampCommand}" />
          <Button Content="{DynamicResource ui.EqEditorView.b4ef6f54bd9f}" Classes="dsp-quiet eq-action" Command="{Binding ResetBandCommand}" IsEnabled="{Binding CanResetBand}" IsVisible="{Binding IsEqAdvanced}" />
          <Button Content="{DynamicResource ui.EqEditorView.8fcadc0ef8ad}" Classes="dsp-quiet eq-action" Command="{Binding FlattenCommand}" />
        </WrapPanel>
      </Grid></Border>
      <Expander Grid.Row="4" Name="AdvancedEq" Classes="eq-section" Header="{DynamicResource ui.EqEditorView.c94f9412cde8}" IsVisible="{Binding IsReady}" IsExpanded="False" HorizontalAlignment="Stretch">
        <StackPanel Spacing="18" Margin="0,8,0,12" IsEnabled="{Binding CanEdit}">
          <local:EqBandProcessingView DataContext="{Binding SelectedBand}" IsVisible="{Binding $parent[local:EqEditorView].((local:DspViewModel)DataContext).IsEqAdvanced}" />
          <Grid Name="TrimControls" ColumnDefinitions="*,*" ColumnSpacing="28">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource ui.EqEditorView.5b315ccf90ea}" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding StrengthPercent, StringFormat={}{0:0}%}" /></Grid>
              <Slider Theme="{StaticResource EqFader}" Classes="dsp-fader" Minimum="0" Maximum="100" Value="{Binding StrengthPercent, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />
            </StackPanel>
            <StackPanel Name="TiltField" Grid.Column="1" Spacing="6">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource ui.EqEditorView.b23b991c3786}" Classes="muted" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding TiltDb, StringFormat={}{0:0.0} dB}" /></Grid>
              <Slider Theme="{StaticResource EqFader}" Classes="dsp-fader" Minimum="-6" Maximum="6" Value="{Binding TiltDb, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Expander>
      <Expander Name="EqPresetLibrary" Classes="eq-section" Grid.Row="5" Header="{DynamicResource ui.EqEditorView.1b928509146c}" IsVisible="{Binding IsReady}" IsExpanded="False" HorizontalAlignment="Stretch">
        <WrapPanel Margin="0,8,0,12">
          <TextBox Text="{Binding PresetName}" MaxLength="80" PlaceholderText="{DynamicResource ui.EqEditorView.5fe110aa6d1d}" Width="200" MinHeight="34" IsEnabled="{Binding CanEdit}" Margin="0,0,10,6" />
          <Button Content="{DynamicResource ui.EqEditorView.3a55feb59603}" Click="ImportPreset" IsEnabled="{Binding CanUseResources}" Margin="0,0,6,6" />
          <Button Content="{DynamicResource ui.EqEditorView.fb48367b485c}" Click="ExportPreset" IsEnabled="{Binding CanEdit}" Margin="0,0,6,6" />
          <Button Content="{DynamicResource ui.EqEditorView.1cfb7d3492fd}" Command="{Binding SavePresetCommand}" IsEnabled="{Binding CanUseResources}" Margin="0,0,6,6" />
          <Button Content="{DynamicResource ui.EqEditorView.2f9daa828907}" Classes="dsp-quiet eq-action" Command="{Binding DeletePresetCommand}" IsEnabled="{Binding CanDeletePreset}" />
        </WrapPanel>
      </Expander>
    </Grid>
  </ScrollViewer>
  </Grid>
</UserControl>
