<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls">
  <Styles.Resources>
    <ControlTheme x:Key="DspNavigationItem" TargetType="ListBoxItem" x:DataType="local:DspModule">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Group}" IsVisible="{Binding HasGroupHeading}" Margin="8,12,8,4" FontSize="11" Foreground="{DynamicResource EchoMuted}" />
            <Border Name="Row" Padding="8,5" MinHeight="34" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand">
              <Grid ColumnDefinitions="17,*,14" ColumnSpacing="8">
                <icons:GlyphIcon Name="ModuleIcon" Kind="{Binding Icon}" Width="16" Height="16" StrokeWidth="1.6" Stroke="{DynamicResource EchoMuted}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Badge}" IsVisible="{Binding HasBadge}" FontSize="10" Classes="muted" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding Detail}" IsVisible="{Binding ShowsDetail}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <icons:GlyphIcon Grid.Column="2" Kind="check" Width="12" Height="12" StrokeWidth="2.2" IsVisible="{Binding IsActive}" Stroke="{DynamicResource EchoSignalModified}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Row">
        <Setter Property="Background" Value="{DynamicResource EchoHover}" />
      </Style>
      <Style Selector="^:selected /template/ Border#Row">
        <Setter Property="Background" Value="{DynamicResource LibraryPopupSelected}" />
      </Style>
      <Style Selector="^:selected /template/ icons|GlyphIcon#ModuleIcon">
        <Setter Property="Stroke" Value="{DynamicResource EchoAccent}" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#Row">
        <Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="DspBandItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="BandRow" BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="6,6,0,0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource EchoHover}" />
      </Style>
      <Style Selector="^:selected /template/ Border#BandRow">
        <Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" />
        <Setter Property="Background" Value="{DynamicResource LibraryPopupSelected}" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#BandRow">
        <Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="ListBox.dsp-navigation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4,4,0" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource DspNavigationItem}" />
  </Style>
  <Style Selector="ListBox.dsp-bands">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource DspBandItem}" />
  </Style>
  <Style Selector="Button.dsp-quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.dsp-quiet:pointerover">
    <Setter Property="Background" Value="{DynamicResource EchoHover}" />
  </Style>
  <Style Selector="Border.dsp-chip">
    <Setter Property="Background" Value="{DynamicResource LibraryPopupSelected}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Slider.dsp-fader">
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown.dsp-value">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown.dsp-value /template/ TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource EchoBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="NumericUpDown.dsp-value:focus-within /template/ TextBox">
    <Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" />
  </Style>
</Styles>
