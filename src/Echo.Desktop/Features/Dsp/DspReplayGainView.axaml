<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Dsp.DspReplayGainView" x:DataType="local:DspViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="24" Margin="0,0,0,24">
      <local:DspWorkbenchSplit MainWeight="1.3" Gap="48">
        <Border Classes="dsp-rule" Padding="0,10,0,0" BorderThickness="0">
          <StackPanel Spacing="18">
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource ui.DspReplayGainView.9f5cfd550100}" Classes="dsp-section-title"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="—" FontSize="84" FontWeight="Light"/>
              <TextBlock Text="LUFS" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource ui.DspReplayGainView.580ee5be8fdb}" Classes="dsp-note" TextWrapping="Wrap"/>
            <local:DspColumns MinimumColumnWidth="130" MaximumColumns="3" IsEnabled="False" ToolTip.Tip="当前连接暂不支持目标响度设置">
              <Button HorizontalAlignment="Stretch" Margin="0,0,8,0" Padding="14"><StackPanel Spacing="8"><TextBlock Text="标准" FontSize="12"/><TextBlock Text="−14 LUFS" FontSize="18"/></StackPanel></Button>
              <Button HorizontalAlignment="Stretch" Margin="0,0,8,0" Padding="14"><StackPanel Spacing="8"><TextBlock Text="安静" FontSize="12"/><TextBlock Text="−18 LUFS" FontSize="18"/></StackPanel></Button>
              <Button HorizontalAlignment="Stretch" Margin="0,0,8,0" Padding="14"><StackPanel Spacing="8"><TextBlock Text="EBU R128" FontSize="12"/><TextBlock Text="−23 LUFS" FontSize="18"/></StackPanel></Button>
            </local:DspColumns>
            <TextBlock Text="{DynamicResource ui.DspReplayGainView.e6c0251d0811}" FontWeight="SemiBold"/>
            <ListBox Classes="dsp-segments" ItemsSource="{Binding ReplayModes}" SelectedItem="{Binding ReplayMode, Mode=TwoWay}" IsEnabled="{Binding CanEdit}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:DspChoice">
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Spacing="18" IsEnabled="{Binding CanEdit}">
              <local:DspParameterEditor DataContext="{Binding Fields[preampDb]}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="dsp-rule" Padding="0,10,0,0" BorderThickness="0">
          <StackPanel Spacing="18">
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource ui.DspReplayGainView.999a8475b3bf}" Classes="dsp-section-title"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding AppliedGainReadout}" Classes="dsp-hero-number"/>
              <TextBlock Text="dB" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
            </StackPanel>
            <local:DspRuntimeReadout/>
            <Border Classes="dsp-rule">
              <StackPanel Spacing="14">
                <TextBlock Text="自动处理与保护" FontWeight="Medium"/>
                <CheckBox Content="{DynamicResource ui.DspReplayGainView.40f99d2e8d1f}" IsChecked="{Binding PreventClipping, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </local:DspWorkbenchSplit>
      <Border Classes="dsp-rule">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="8"><TextBlock Text="响度分析" Classes="dsp-section-title"/><TextBlock Text="当前连接暂不支持曲库响度分析。已有 ReplayGain 标签仍可使用。" Classes="dsp-note"/></StackPanel>
          <Button Grid.Column="1" Content="分析缺失曲目" IsEnabled="False" VerticalAlignment="Top"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
