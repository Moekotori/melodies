<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" xmlns:icons="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Dsp.DspChoiceEditor" x:DataType="local:DspChoiceField">
  <StackPanel Spacing="9" Margin="0,0,22,18">
    <TextBlock Text="{Binding Label}" Classes="muted" FontSize="12"/>
    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="38">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="local:DspChoice">
          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
  </StackPanel>
</UserControl>
