<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" x:Class="Echo.Desktop.Features.Dsp.EqBandProcessingView" x:DataType="local:EqBandViewModel">
  <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding !IsCorrection}">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="作用声道" Classes="muted" FontSize="11" />
        <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope, Mode=TwoWay}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="local:DspChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding SupportsDynamic}">
        <TextBlock Text="动态 EQ" Classes="muted" FontSize="11" />
        <ComboBox ItemsSource="{Binding DynamicModes}" SelectedItem="{Binding DynamicMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="local:DspChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" IsVisible="{Binding DynamicActive}">
      <StackPanel Spacing="3"><TextBlock Text="阈值 / dB" Classes="muted" FontSize="11" /><NumericUpDown Classes="dsp-value" Minimum="-48" Maximum="0" Increment="0.1" Value="{Binding DynamicThresholdDb, Mode=TwoWay}" FormatString="0.0" /></StackPanel>
      <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="压缩比" Classes="muted" FontSize="11" /><NumericUpDown Classes="dsp-value" Minimum="1" Maximum="20" Increment="0.1" Value="{Binding DynamicRatio, Mode=TwoWay}" FormatString="0.0" /></StackPanel>
      <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="启动 / ms" Classes="muted" FontSize="11" /><NumericUpDown Classes="dsp-value" Minimum="0.5" Maximum="80" Increment="0.5" Value="{Binding DynamicAttackMs, Mode=TwoWay}" FormatString="0.0" /></StackPanel>
      <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="释放 / ms" Classes="muted" FontSize="11" /><NumericUpDown Classes="dsp-value" Minimum="10" Maximum="400" Increment="1" Value="{Binding DynamicReleaseMs, Mode=TwoWay}" FormatString="0" /></StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
