<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" x:Class="Echo.Desktop.Features.Dsp.EqBandInspectorView" x:DataType="local:EqBandViewModel">
  <Border Padding="0,12">
    <Grid Name="InspectorLayout" ColumnDefinitions="112,*,*,*,*" ColumnSpacing="16" RowSpacing="10">
      <StackPanel Name="BandIdentity" Spacing="6" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="8" Height="8" Fill="{Binding Swatch}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Number, StringFormat=频段 {0}}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource EchoAccentText}" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox Content="{DynamicResource ui.EqBandInspectorView.f4f0ead1116b}" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="12" />
      </StackPanel>
      <StackPanel Name="FrequencyField" Grid.Column="1" Spacing="3">
        <TextBlock Text="{DynamicResource ui.EqBandInspectorView.bc87af6baa6f}" FontSize="12" Classes="muted" />
        <NumericUpDown Name="BandFrequency" Classes="dsp-value dsp-band-value" Minimum="{Binding FrequencyMinimum}" Maximum="20000" Increment="1" Value="{Binding FrequencyValue, Mode=TwoWay}" FormatString="{Binding FrequencyFormat}" ShowButtonSpinner="False" />
      </StackPanel>
      <StackPanel Name="GainField" Grid.Column="2" Spacing="3">
        <TextBlock Text="{DynamicResource ui.EqBandInspectorView.f6a1aa71313a}" FontSize="12" Classes="muted" />
        <NumericUpDown Name="BandGain" Classes="dsp-value dsp-band-value" Minimum="{Binding GainMinimum}" Maximum="{Binding GainMaximum}" Increment="0.1" Value="{Binding GainValue, Mode=TwoWay}" IsEnabled="{Binding IsGainEditable}" FormatString="{Binding GainFormat}" ShowButtonSpinner="False" />
      </StackPanel>
      <StackPanel Name="QField" Grid.Column="3" Spacing="3">
        <TextBlock Text="{DynamicResource ui.EqBandInspectorView.b7637ff57bc0}" FontSize="12" Classes="muted" />
        <NumericUpDown Name="BandQ" Classes="dsp-value dsp-band-value" Minimum="{Binding QMinimum}" Maximum="{Binding QMaximum}" Increment="0.1" Value="{Binding QualityValue, Mode=TwoWay}" FormatString="{Binding QualityFormat}" ShowButtonSpinner="False" />
      </StackPanel>
      <StackPanel Name="FilterField" Grid.Column="4" Spacing="3">
        <TextBlock Text="{DynamicResource ui.EqBandInspectorView.301f834df100}" FontSize="12" Classes="muted" />
        <ComboBox ItemsSource="{x:Static local:EqFilters.All}" SelectedItem="{Binding Filter, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="32">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="local:DspChoice">
              <TextBlock Text="{Binding Label}" FontSize="13" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
