<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Echo.Desktop.Features.Dsp" x:Class="Echo.Desktop.Features.Dsp.DspImpulsePicker" x:DataType="local:DspViewModel">
  <StackPanel Spacing="10">
    <TextBlock Text="{DynamicResource ui.DspImpulsePicker.3b66b73e5e83}" FontSize="12" FontWeight="Medium" />
    <ComboBox ItemsSource="{Binding ImpulseBanks}" SelectedItem="{Binding SelectedImpulseBank, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanUseResources}">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="local:DspImpulseBankChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <WrapPanel><Button Content="{DynamicResource ui.DspImpulsePicker.fb72926d76a6}" Click="ImportImpulse" IsEnabled="{Binding CanUseResources}" Margin="0,0,8,0" /><Button Content="{DynamicResource ui.DspImpulsePicker.823a7ad8f3be}" Classes="dsp-quiet" Command="{Binding RefreshBanksCommand}" IsEnabled="{Binding CanUseResources}" /><Button Content="{DynamicResource ui.DspImpulsePicker.3f9f58113abc}" Command="{Binding DeleteBankCommand}" Classes="dsp-quiet" IsEnabled="{Binding CanUseResources}" /></WrapPanel>
  </StackPanel>
</UserControl>
