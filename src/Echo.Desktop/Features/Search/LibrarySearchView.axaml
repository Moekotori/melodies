<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Search" x:Class="Echo.Desktop.Features.Search.LibrarySearchView" x:DataType="local:LibrarySearchViewModel">
  <Grid>
    <Grid Name="Results" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
      <TextBlock Text="{DynamicResource query.globalSearch}" Classes="heading" FontSize="30" />
      <Grid Grid.Row="1"><TextBox Name="SearchField" Text="{Binding Search, Mode=TwoWay}" MaxLength="128" PlaceholderText="{DynamicResource query.globalHint}" KeyDown="OnSearchKey" Padding="12,12,40,12" /><Button Content="×" Click="OnClear" Classes="icon" HorizontalAlignment="Right" Margin="4" /></Grid>
      <StackPanel Grid.Row="2" Spacing="5"><TextBlock Text="{DynamicResource query.globalLimit}" Classes="muted" FontSize="12" /><TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource EchoAccentText}" /></StackPanel>
      <Grid Grid.Row="3">
        <ListBox Name="HitList" ItemsSource="{Binding Hits}" DoubleTapped="OnOpen" KeyDown="OnResultsKey" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate><DataTemplate x:DataType="local:LibrarySearchHit"><Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="18" Height="66">
            <TextBlock Text="{Binding Kind}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Classes="muted" FontSize="12" /></StackPanel>
            <Button Grid.Column="2" Content="{DynamicResource query.open}" Click="OnOpenClick" />
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{DynamicResource query.globalEmpty}" IsVisible="{Binding IsEmpty}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2" VerticalAlignment="Top" />
      </Grid>
    </Grid>
    <ContentControl Name="Details" IsVisible="False" />
  </Grid>
</UserControl>
