<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Search" xmlns:icon="using:Echo.Desktop.Controls"
             xmlns:queue="using:Echo.Desktop.Features.Queue"
             x:Class="Echo.Desktop.Features.Search.GlobalSearchOverlay">
  <UserControl.Styles>
    <Style Selector="TextBox.global-search">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,8" /><Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource EchoHeading}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.global-search /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.search-result">
      <Setter Property="Background" Value="{DynamicResource EchoHover}" />
    </Style>
    <Style Selector="ListBoxItem icon|GlyphIcon.result-arrow"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="ListBoxItem:selected icon|GlyphIcon.result-arrow"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Border.search-key">
      <Setter Property="MinWidth" Value="20" /><Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="5,0" /><Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderBrush" Value="{DynamicResource EchoBorder}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource EchoPanelMuted}" />
    </Style>
    <Style Selector="Border.search-key TextBlock">
      <Setter Property="FontSize" Value="12" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" />
    </Style>
  </UserControl.Styles>
  <Grid ClipToBounds="True">
    <Border Background="#38181a20" PointerPressed="OnScrimPressed" />
    <Border Name="SearchPanel" x:DataType="local:GlobalSearchViewModel" Width="660"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="18,99,18,24"
            Background="{DynamicResource EchoField}" CornerRadius="12" ClipToBounds="True"
            BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" BoxShadow="0 12 40 0 #24181a20"
            AutomationProperties.Name="{DynamicResource query.globalSearch}">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,0,1">
          <Grid MinHeight="52" ColumnDefinitions="18,*,Auto" ColumnSpacing="10" Margin="16,0,12,0">
            <icon:GlyphIcon Kind="search" Width="18" Height="18" Stroke="{DynamicResource EchoMuted}" VerticalAlignment="Center" />
            <TextBox Name="SearchField" Grid.Column="1" Classes="global-search" Text="{Binding Search, Mode=TwoWay}"
                     MaxLength="128" PlaceholderText="{DynamicResource globalSearch.hint}" VerticalAlignment="Center"
                     AutomationProperties.Name="{DynamicResource query.globalSearch}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="icon" Width="100" Padding="5,0" Height="28" Click="OnClear" IsVisible="{Binding IsExpanded}"
                      ToolTip.Tip="{DynamicResource globalSearch.clear}" AutomationProperties.Name="{DynamicResource globalSearch.clear}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <icon:GlyphIcon Kind="close" Width="14" Height="14" />
                  <TextBlock Text="{Binding Copy.NewSearch}" FontSize="12" VerticalAlignment="Center" Classes="muted" />
                </StackPanel>
              </Button>
              <Button Classes="icon" Padding="0" Click="OnClose" Focusable="False" AutomationProperties.Name="Esc">
                <Border Classes="search-key"><TextBlock Text="Esc" /></Border>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto">
          <ListBox Name="HitList" ItemsSource="{Binding Hits}" Background="Transparent" BorderThickness="0" Padding="6,4,6,6"
                   SelectionChanged="OnSelectionChanged" PointerReleased="OnResultReleased" PointerMoved="OnResultPointerMoved"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:GlobalSearchHit">
                <StackPanel>
                  <TextBlock Text="{Binding SectionTitle}" IsVisible="{Binding StartsSection}" Margin="10,10,10,4"
                             FontSize="12" FontWeight="Medium" Classes="muted" />
                  <Border Classes="search-result" CornerRadius="7" Padding="10,0" MinHeight="36">
                    <Grid ColumnDefinitions="22,*,16" ColumnSpacing="10">
                      <Border CornerRadius="5" ClipToBounds="True" Width="22" Height="22" VerticalAlignment="Center">
                        <Grid>
                          <icon:GlyphIcon Kind="{Binding Icon}" Stroke="{DynamicResource EchoMuted}" Width="16" Height="16" />
                          <queue:QueueArtwork FilePath="{Binding ArtworkPath}" Cache="{Binding $parent[local:GlobalSearchOverlay].Artwork}"
                                              IsVisible="{Binding HasArtwork}" CornerRadius="5" />
                        </Grid>
                      </Border>
                      <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" MaxWidth="360" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Context}" IsVisible="{Binding HasDescription}" FontSize="13"
                                   Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                      <icon:GlyphIcon Grid.Column="2" Classes="result-arrow" Kind="arrow-right" Width="15" Height="15" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Text="{DynamicResource globalSearch.empty}" IsVisible="{Binding IsEmpty}" Classes="muted"
                     Margin="24,20" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <Border Grid.Row="2" IsVisible="{Binding HasError}" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource EchoAccentText}" TextWrapping="Wrap" />
              <Button Grid.Column="1" Content="{DynamicResource globalSearch.retry}" Click="OnRetry" Margin="12,0,0,0" />
            </Grid>
          </Border>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2" VerticalAlignment="Top" />
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource EchoPanelMuted}" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="14,0" MinHeight="38">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Classes="search-key"><TextBlock Text="↑" /></Border><Border Classes="search-key"><TextBlock Text="↓" /></Border>
              <TextBlock Text="{Binding Copy.Navigate}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Classes="search-key"><TextBlock Text="↵" /></Border>
              <TextBlock Text="{Binding Copy.Select}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
