<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Podcasts" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Podcasts.PodcastView" x:DataType="local:PodcastViewModel" x:Name="Root"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Button.podcast-tool"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="Button.filter"><Setter Property="Padding" Value="10,6" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
    <Style Selector="Button.filter.on"><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /><Setter Property="FontWeight" Value="Medium" /></Style>
    <Style Selector="Button.show"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="10,8" /></Style>
    <Style Selector="Button.show.on"><Setter Property="Background" Value="{DynamicResource EchoPanelMuted}" /></Style>
  </UserControl.Styles>
  <Grid Name="PodcastLayout" RowDefinitions="Auto,*" ColumnDefinitions="244,*" Margin="32,28,32,24" ColumnSpacing="28" RowSpacing="24">
    <StackPanel Grid.ColumnSpan="2" Spacing="8">
      <TextBlock Text="{DynamicResource ui.PodcastView.8ae0035c5aec}" Classes="page-title" />
      <TextBlock Text="{DynamicResource ui.PodcastView.645415af64ae}" Classes="muted" FontSize="13" />
      <TextBlock Text="{DynamicResource ui.PodcastView.32fe10180dc8}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource EchoAccentText}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Button Content="{DynamicResource ui.PodcastView.b8784c8dd563}" Command="{Binding RetryListCommand}" IsVisible="{Binding ListFailed}" HorizontalAlignment="Left" />
    </StackPanel>
    <Border Grid.Row="1" IsVisible="{Binding ShowSubscriptionRail}" Background="{DynamicResource EchoPanelMuted}" CornerRadius="14" Padding="16">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource ui.PodcastView.79aad303b15f}" Classes="heading" FontSize="18" Margin="0,8,0,8" />
        <TextBox DockPanel.Dock="Top" PlaceholderText="{DynamicResource ui.PodcastView.7c04d14c202b}" Text="{Binding ShowQuery}" MaxLength="128" Margin="0,0,0,8" />
        <Button DockPanel.Dock="Bottom" Classes="primary podcast-tool" Command="{Binding ToggleEditorCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{DynamicResource ui.PodcastView.1fb74f151925}" />
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,12" IsVisible="{Binding EditorOpen}">
          <TextBox PlaceholderText="{DynamicResource ui.PodcastView.c317b10370d9}" Text="{Binding DraftUrl}" MaxLength="4096" />
          <Button Classes="primary podcast-tool" Command="{Binding SubscribeCommand}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{DynamicResource ui.PodcastView.cf8efc450f71}" />
        </StackPanel>
        <TextBlock Text="{DynamicResource ui.PodcastView.146790885b1d}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasShows}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Shows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:PodcastShowRow">
                <Button Classes="show" Classes.on="{Binding IsSelected}" Command="{Binding $parent[UserControl].((local:PodcastViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Author}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" IsVisible="{Binding Author, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="0,0,0,8" IsVisible="{Binding ShowSubscriptionRail}">
      <Grid Grid.Row="1" ColumnDefinitions="96,*" Margin="0,18,0,12" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Width="96" Height="96" CornerRadius="6" Background="{DynamicResource EchoPanelMuted}" ClipToBounds="True">
          <Panel>
            <icon:GlyphIcon Kind="headphones" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6">
          <TextBlock Text="{Binding ShowTitle}" Classes="heading" FontSize="22" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ShowAuthor}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ShowDescription}" TextWrapping="Wrap" MaxLines="{Binding DescriptionLines}" FontSize="13" />
          <Button Content="{Binding DescriptionToggle}" Command="{Binding ToggleDescriptionCommand}" Padding="0" Background="Transparent" HorizontalAlignment="Left" IsVisible="{Binding ShowDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary podcast-tool" Command="{Binding ListenCommand}" IsEnabled="{Binding !Busy}" Content="{DynamicResource ui.PodcastView.d65e4bc27e46}" />
            <Button Classes="podcast-tool" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}" Content="{DynamicResource ui.PodcastView.dceb1a464ebe}" />
            <Button Classes="podcast-tool" Command="{Binding AskRemoveCommand}" IsEnabled="{Binding !Busy}" Content="{DynamicResource ui.PodcastView.6af7023b9f5f}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmRemove}">
            <TextBlock Text="{DynamicResource ui.PodcastView.f3317fc9e5a0}" VerticalAlignment="Center" FontSize="12" />
            <Button Content="{DynamicResource ui.PodcastView.6af7023b9f5f}" Command="{Binding RemoveCommand}" />
            <Button Content="{DynamicResource ui.PodcastView.2cd0f3be8738}" Command="{Binding CancelRemoveCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <DockPanel Grid.Row="2" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button Classes="filter" Classes.on="{Binding FilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="all" Content="{DynamicResource ui.PodcastView.5c55a67935af}" />
          <Button Classes="filter" Classes.on="{Binding FilterUnplayed}" Command="{Binding SetFilterCommand}" CommandParameter="unplayed" Content="{DynamicResource ui.PodcastView.42d695255d34}" />
          <Button Classes="filter" Classes.on="{Binding FilterProgress}" Command="{Binding SetFilterCommand}" CommandParameter="progress" Content="{DynamicResource ui.PodcastView.186ce6343967}" />
          <Button Classes="filter" Classes.on="{Binding FilterPlayed}" Command="{Binding SetFilterCommand}" CommandParameter="played" Content="{DynamicResource ui.PodcastView.241b3f21bbfa}" />
          <TextBox PlaceholderText="{DynamicResource ui.PodcastView.e2231d4fbd3c}" Text="{Binding EpisodeQuery}" MaxLength="128" Width="180" />
          <Button Content="{DynamicResource ui.PodcastView.44ce7ae909bb}" Command="{Binding SearchEpisodesCommand}" />
          <TextBlock Text="{Binding CountText}" Classes="muted" VerticalAlignment="Center" />
        </WrapPanel>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
          <Button Content="{DynamicResource ui.PodcastView.c9b9ae7a6144}" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPrevious}" />
          <TextBlock Grid.Column="1" Text="{Binding PageText}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
          <Button Grid.Column="2" Content="{DynamicResource ui.PodcastView.8a8542f69648}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNext}" />
        </Grid>
        <Button DockPanel.Dock="Top" Content="{DynamicResource ui.PodcastView.b8784c8dd563}" Command="{Binding RetryEpisodesCommand}" IsVisible="{Binding EpisodesFailed}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        <Panel>
          <TextBlock Text="{DynamicResource ui.PodcastView.86b6d0d63062}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowEpisodeLoading}" />
          <TextBlock Text="{DynamicResource ui.PodcastView.e23f7d5aa846}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowEpisodeEmpty}" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasEpisodes}">
          <ItemsControl ItemsSource="{Binding Episodes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:PodcastEpisodeRow">
                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="52">
                  <Button Classes="icon" Command="{Binding $parent[UserControl].((local:PodcastViewModel)DataContext).PlayEpisodeCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource ui.PodcastView.c3396195e91c}"><icon:GlyphIcon Kind="{Binding PlayIcon}" Width="16" Height="16" /></Button>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="12" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="icon" Click="OnEpisodeMenu" ToolTip.Tip="{DynamicResource ui.PodcastView.9f07d2ce4115}"><icon:GlyphIcon Kind="more" Width="16" Height="16" /></Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </Panel>
      </DockPanel>
      <StackPanel Grid.Row="1" Grid.RowSpan="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}">
        <TextBlock Text="{Binding EmptyTitle}" Classes="heading" FontSize="22" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Text="{Binding EmptyDescription}" Classes="muted" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Grid>
    <local:PodcastWelcome Classes="reveal" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding ShowWelcome}" />
  </Grid>
</UserControl>
