<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Remote" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Remote.RemoteProviderPicker" x:DataType="local:RemoteViewModel">
        <ItemsControl Name="Providers" ItemsSource="{Binding ProviderChoices}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Name="ProviderGrid" Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RemoteProviderChoice">
            <Button Classes="remote-provider" Command="{Binding $parent[local:RemoteView].Model.ChooseProviderCommand}" CommandParameter="{Binding Id}" Margin="0,0,8,6" HorizontalContentAlignment="Stretch" Tag="{Binding Id}">
              <Grid ColumnDefinitions="34,*,12" ColumnSpacing="10">
                <Grid><icon:EchoIcon Kind="remote" Width="24" Height="24" BaseBrush="{DynamicResource EchoAccentText}" VerticalAlignment="Center" IsVisible="{Binding Beta}" /><icon:GlyphIcon Kind="{Binding Icon}" Width="23" Height="23" Stroke="{DynamicResource EchoAccentText}" IsVisible="{Binding !Beta}" /></Grid>
                <StackPanel Grid.Column="1" Spacing="7"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding Label}" Classes="provider-name" FontWeight="SemiBold" /><TextBlock Text="Beta" Foreground="{DynamicResource EchoAccentText}" FontSize="12" IsVisible="{Binding Beta}" VerticalAlignment="Center" /></StackPanel><TextBlock Text="{Binding Description}" Classes="remote-caption provider-description" TextWrapping="Wrap" LineHeight="19" /></StackPanel>
                <icon:GlyphIcon Grid.Column="2" Kind="chevron-right" Classes="provider-arrow" Width="14" Height="14" Stroke="{DynamicResource EchoAccentText}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
</UserControl>
