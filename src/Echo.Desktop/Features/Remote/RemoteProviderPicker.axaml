<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Remote" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Remote.RemoteProviderPicker" x:DataType="local:RemoteViewModel">
  <Border Background="#50000000" IsVisible="{Binding ProviderPickerOpen}">
    <Border Background="{DynamicResource EchoField}" MaxWidth="590" Margin="24" Padding="28" CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
      <ScrollViewer MaxHeight="560"><StackPanel Spacing="20">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Text="{DynamicResource remote.add}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource remote.chooseProvider}" Classes="remote-caption" /></StackPanel><Button Grid.Column="1" Classes="remote-icon" Command="{Binding CloseProviderPickerCommand}" ToolTip.Tip="{DynamicResource remote.cancel}"><icon:GlyphIcon Kind="close" Width="16" Height="16" /></Button></Grid>
        <ItemsControl ItemsSource="{Binding ProviderChoices}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RemoteProviderChoice">
            <Button Classes="quiet" Command="{Binding $parent[local:RemoteView].Model.ChooseProviderCommand}" CommandParameter="{Binding Id}" Padding="12,14" Margin="0,0,8,6" HorizontalContentAlignment="Stretch" MinHeight="86" Tag="{Binding Id}">
              <Grid ColumnDefinitions="34,*,12" ColumnSpacing="10">
                <Grid><icon:EchoIcon Kind="remote" Width="24" Height="24" BaseBrush="{DynamicResource EchoAccentText}" VerticalAlignment="Center" IsVisible="{Binding Beta}" /><icon:GlyphIcon Kind="{Binding Icon}" Width="23" Height="23" Stroke="{DynamicResource EchoAccentText}" IsVisible="{Binding !Beta}" /></Grid>
                <StackPanel Grid.Column="1" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" /><TextBlock Text="Beta" Classes="remote-caption" FontSize="10" IsVisible="{Binding Beta}" VerticalAlignment="Center" /></StackPanel><TextBlock Text="{Binding Description}" Classes="remote-caption" FontSize="11" TextWrapping="Wrap" LineHeight="17" /></StackPanel>
                <icon:GlyphIcon Grid.Column="2" Kind="chevron-right" Width="11" Height="11" Stroke="{DynamicResource EchoSubtle}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel></ScrollViewer>
    </Border>
  </Border>
</UserControl>
