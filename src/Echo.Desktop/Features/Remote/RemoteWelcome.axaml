<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Remote" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Remote.RemoteWelcome" x:DataType="local:RemoteViewModel">
  <Grid>
    <StackPanel MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="30,0,30,50">
      <Border Width="76" Height="76" Background="{DynamicResource EchoSelected}" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,7">
        <icon:EchoIcon Kind="remote" Width="38" Height="38" BaseBrush="{DynamicResource EchoAccentText}" />
      </Border>
      <TextBlock Text="{DynamicResource remote.welcomeTitle}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{DynamicResource remote.welcomeDescription}" Classes="remote-caption" FontSize="13" LineHeight="23" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="410" HorizontalAlignment="Center" />
      <Button Name="ConnectButton" Command="{Binding AddCommand}" Classes="primary remote-tool" HorizontalAlignment="Center" Margin="0,7,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8"><icon:GlyphIcon Kind="plus" Width="15" Height="15" Stroke="{DynamicResource EchoOnAccent}" /><TextBlock Text="{DynamicResource remote.add}" /></StackPanel>
      </Button>
      <TextBlock Text="{DynamicResource remote.providerSummary}" Classes="remote-caption" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" HorizontalAlignment="Center" Margin="0,10,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
