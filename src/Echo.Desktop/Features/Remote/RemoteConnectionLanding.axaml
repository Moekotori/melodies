<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Remote" xmlns:icon="using:Echo.Desktop.Controls"
             xmlns:motion="using:Echo.Desktop.Motion"
             x:Class="Echo.Desktop.Features.Remote.RemoteConnectionLanding" x:DataType="local:RemoteViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Name="LandingBody" RowDefinitions="Auto,*" MaxWidth="1080" Margin="24,36,24,24" VerticalAlignment="Top">
      <StackPanel Name="Heading" Spacing="16" Margin="18,0,18,38">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{DynamicResource remote.welcomeTitle}" FontSize="42" FontWeight="Medium" Foreground="{DynamicResource EchoHeading}" />
          <Button Grid.Column="1" Classes="remote-icon" Command="{Binding CloseProviderPickerCommand}" IsVisible="{Binding HasSavedSources}" ToolTip.Tip="{DynamicResource remote.cancel}"><icon:GlyphIcon Kind="close" Width="18" Height="18" /></Button>
        </Grid>
        <TextBlock Text="{DynamicResource remote.welcomeDescription}" Classes="remote-caption" FontSize="15" LineHeight="25" TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left" />
      </StackPanel>
      <Grid Grid.Row="1" Name="ConnectionBody" ColumnDefinitions="*,0,*" RowDefinitions="Auto,Auto">
        <local:RemoteProviderPicker Name="ProviderPicker" Grid.ColumnSpan="3" VerticalAlignment="Top" />
        <motion:MotionSurface Name="EditorSurface" Grid.Column="2" Grid.Row="0" IsOpen="{Binding EditorOpen}" Axis="Horizontal" Travel="24" VerticalAlignment="Top">
          <local:RemoteConnectionEditor Name="ConnectionEditor" />
        </motion:MotionSurface>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
