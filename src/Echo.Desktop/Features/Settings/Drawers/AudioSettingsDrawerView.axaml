<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:playback="using:Echo.Playback" xmlns:player="using:Echo.Desktop.Features.Player"
             xmlns:drawers="using:Echo.Desktop.Features.Settings.Drawers" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Settings.Drawers.AudioSettingsDrawerView" x:DataType="shell:ShellViewModel">
  <UserControl.Resources><drawers:OutputDevicePresentation x:Key="DevicePresentation" /></UserControl.Resources>
  <Grid RowDefinitions="*,Auto">
    <TabControl Name="AudioTabs" Classes="drawer-tabs" Margin="22,14,22,0" SelectionChanged="OnCategoryChanged"
                HorizontalContentAlignment="Stretch" IsEnabled="{Binding !Player.AudioSettings.IsApplying}">
      <TabItem Header="输出设备">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Margin="0,22,0,24">
            <Grid ColumnDefinitions="18,*,Auto,26" ColumnSpacing="10" Height="36">
              <icon:GlyphIcon Kind="waves" Width="17" Height="17" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="输出设备" Classes="drawer-section" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Player.AudioSettings.Devices.Count}" Classes="subtle" FontSize="10" VerticalAlignment="Center" />
              <Button Grid.Column="3" Name="RefreshOutputButton" Classes="drawer-help" Command="{Binding Player.AudioSettings.RefreshCommand}" ToolTip.Tip="插上或拔掉设备后重新扫描">
                <icon:GlyphIcon Kind="refresh" Width="15" Height="15" />
              </Button>
            </Grid>
            <ListBox Name="OutputModeInput" Classes="drawer-modes" ItemsSource="{Binding Player.AudioSettings.Modes}" SelectedItem="{Binding Player.AudioSettings.SelectedMode}">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputMode"><TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ListBox Name="OutputDeviceInput" Classes="drawer-devices" MaxHeight="470" ItemsSource="{Binding Player.AudioSettings.Devices}"
                     SelectedItem="{Binding Player.AudioSettings.SelectedDevice}" IsEnabled="{Binding !Player.AudioSettings.IsRefreshing}"
                     PointerReleased="OnDeviceReleased" KeyDown="OnDeviceKeyDown">
              <ListBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputDevice">
                <Grid ColumnDefinitions="28,*,Auto,16" ColumnSpacing="10">
                  <icon:GlyphIcon Kind="{Binding Converter={StaticResource DevicePresentation}, ConverterParameter=icon}" Width="21" Height="21" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Converter={StaticResource DevicePresentation}}" Classes="heading" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Converter={StaticResource DevicePresentation}, ConverterParameter=detail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="2" Background="{DynamicResource EchoPanelMuted}" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Converter={StaticResource DevicePresentation}, ConverterParameter=badge}" Classes="muted" FontSize="9" FontWeight="SemiBold" />
                  </Border>
                  <icon:GlyphIcon Grid.Column="3" Kind="check" Width="15" Height="15" VerticalAlignment="Center" Stroke="{DynamicResource EchoAccentText}"
                                  IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding Player.AudioSettings.Message}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
            <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,18,0,0" IsVisible="{Binding Player.HasTrack}">
              <StackPanel Spacing="8"><TextBlock Text="当前输出" Classes="drawer-section" /><TextBlock Text="{Binding Player.OutputName}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{Binding Player.SignalPath}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="输出设置">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="0" Margin="0,22,0,24">
            <Grid ColumnDefinitions="18,*" ColumnSpacing="10" Height="40"><icon:GlyphIcon Kind="gauge" Width="17" Height="17" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="高级音频设置" Classes="drawer-section" VerticalAlignment="Center" /></Grid>
            <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,14,0,14">
              <StackPanel Spacing="0">
                <Grid ColumnDefinitions="18,*" ColumnSpacing="10" Height="28"><icon:GlyphIcon Kind="headphones" Width="16" Height="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="音效与速度" Classes="muted" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid>
                <Border Classes="drawer-row"><Grid ColumnDefinitions="18,*,38,22" ColumnSpacing="10">
                  <icon:GlyphIcon Kind="sliders" Width="16" Height="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="启用均衡器" FontSize="13" VerticalAlignment="Center" />
                  <CheckBox Name="EqualizerInput" Grid.Column="2" Classes="drawer-switch" IsChecked="{Binding Player.AudioSettings.EqualizerEnabled}" AutomationProperties.Name="启用均衡器" />
                  <Button Grid.Column="3" Classes="drawer-help" ToolTip.Tip="启用已保存的均衡器处理。关闭可恢复未经 EQ 处理的声音。"><icon:GlyphIcon Kind="help" Width="14" Height="14" /></Button>
                </Grid></Border>
                <Border Classes="drawer-row"><Grid ColumnDefinitions="18,*,38,22" ColumnSpacing="10">
                  <icon:GlyphIcon Kind="headphones" Width="16" Height="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="耳机交叉馈送" FontSize="13" VerticalAlignment="Center" />
                  <CheckBox Name="CrossfeedInput" Grid.Column="2" Classes="drawer-switch" IsChecked="{Binding Player.AudioSettings.CrossfeedEnabled}" AutomationProperties.Name="耳机交叉馈送" />
                  <Button Grid.Column="3" Classes="drawer-help" ToolTip.Tip="将少量对侧声道混入耳机输出，减轻左右分离感。"><icon:GlyphIcon Kind="help" Width="14" Height="14" /></Button>
                </Grid></Border>
                <Border Classes="drawer-row"><Grid ColumnDefinitions="18,*,100" ColumnSpacing="10"><icon:GlyphIcon Kind="gauge" Width="16" Height="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="播放速度" FontSize="13" VerticalAlignment="Center" /><NumericUpDown Name="PlaybackRateInput" Grid.Column="2" Minimum="0.5" Maximum="2" Increment="0.05" Value="{Binding Player.AudioSettings.PlaybackRate}" /></Grid></Border>
              </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,14,0,14">
              <StackPanel Spacing="0">
                <Grid ColumnDefinitions="18,*" ColumnSpacing="10" Height="28"><icon:GlyphIcon Kind="waves" Width="16" Height="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="输出格式" Classes="muted" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid>
                <Border Classes="drawer-row"><Grid ColumnDefinitions="*,180" ColumnSpacing="12"><TextBlock Text="采样率 / Hz" VerticalAlignment="Center" FontSize="13" /><ComboBox Name="SampleRateInput" Grid.Column="1" ItemsSource="{Binding Player.AudioSettings.Rates}" SelectedItem="{Binding Player.AudioSettings.SampleRate}" HorizontalAlignment="Stretch" /></Grid></Border>
                <Border Classes="drawer-row"><Grid ColumnDefinitions="*,210" ColumnSpacing="12"><TextBlock Text="输出格式" VerticalAlignment="Center" FontSize="13" /><ComboBox Name="OutputFormatInput" Grid.Column="1" ItemsSource="{Binding Player.AudioSettings.AvailableFormats}" SelectedItem="{Binding Player.AudioSettings.SelectedFormat}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="player:OutputFormatChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid></Border>
                <StackPanel IsVisible="{Binding Player.AudioSettings.IsDsd}" Spacing="10" Margin="0,12"><TextBlock Text="DSD 传输率 / Hz" FontSize="11" Classes="muted" /><ComboBox ItemsSource="{Binding Player.AudioSettings.DsdRates}" SelectedItem="{Binding Player.AudioSettings.DsdTransportRate}" HorizontalAlignment="Stretch" /></StackPanel>
              </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
              <StackPanel Spacing="0">
                <Grid ColumnDefinitions="18,*" ColumnSpacing="10" Height="28"><icon:GlyphIcon Kind="gauge" Width="16" Height="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="缓冲与设备" Classes="muted" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid>
                <Border Classes="drawer-row"><Grid ColumnDefinitions="*,150" ColumnSpacing="12"><TextBlock Text="缓冲帧数" VerticalAlignment="Center" FontSize="13" /><NumericUpDown Name="BufferInput" Grid.Column="1" Minimum="64" Maximum="32768" Increment="64" Value="{Binding Player.AudioSettings.BufferFrames}" /></Grid></Border>
                <StackPanel IsVisible="{Binding Player.AudioSettings.IsAsio}" Spacing="12" Margin="0,12">
                  <Grid ColumnDefinitions="*,110"><TextBlock Text="输出声道数" FontSize="13" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Minimum="2" Maximum="8" Increment="1" Value="{Binding Player.AudioSettings.OutputChannels}" IsEnabled="{Binding !Player.AudioSettings.IsDsd}" /></Grid>
                  <Grid ColumnDefinitions="*,110"><TextBlock Text="起始声道（1 起）" FontSize="13" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Minimum="1" Maximum="129" Increment="1" Value="{Binding Player.AudioSettings.AsioChannelStart}" /></Grid>
                  <Button Content="探测 DSD 支持" Classes="drawer-action" Command="{Binding Player.AudioSettings.ProbeDsdCommand}" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding Player.AudioSettings.DsdCapabilities}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="状态与修复">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18" Margin="0,22,0,24">
            <Grid ColumnDefinitions="18,*" ColumnSpacing="10" Height="36"><icon:GlyphIcon Kind="waves" Width="17" Height="17" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="信号路径" Classes="drawer-section" VerticalAlignment="Center" /></Grid>
            <SelectableTextBlock Text="{Binding Player.SignalPath}" FontSize="13" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Player.Error}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <Button Content="复制诊断信息" Classes="drawer-action" Click="OnCopyDiagnostics" HorizontalAlignment="Left" />
            <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel Spacing="14"><TextBlock Text="播放与恢复" Classes="drawer-section" /><Button Content="重试播放" Classes="drawer-action" Command="{Binding Player.RecoverCommand}" HorizontalAlignment="Left" /><Button Content="恢复普通输出与音效默认值" Classes="drawer-action" Command="{Binding Player.AudioSettings.ResetCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Name="ApplyFooter" Grid.Row="1" IsVisible="False" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="22,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <TextBlock Name="AudioFeedback" Text="{Binding Player.AudioSettings.Message}" Classes="muted" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Name="ApplyAudioButton" Grid.Column="1" Content="应用设置" Classes="drawer-action" Command="{Binding Player.AudioSettings.ApplyCommand}" IsEnabled="{Binding !Player.AudioSettings.IsRefreshing}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>