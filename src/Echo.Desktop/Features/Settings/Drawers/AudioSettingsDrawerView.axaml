<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:playback="using:Echo.Playback" xmlns:player="using:Echo.Desktop.Features.Player"
             x:Class="Echo.Desktop.Features.Settings.Drawers.AudioSettingsDrawerView" x:DataType="shell:ShellViewModel">
  <Grid RowDefinitions="*,Auto">
    <TabControl Name="AudioTabs" Margin="16,12,16,0" HorizontalContentAlignment="Stretch" IsEnabled="{Binding !Player.AudioSettings.IsApplying}">
      <TabItem Header="输出">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="15" Margin="6,20,6,24">
            <TextBlock Text="当前输出" Classes="heading" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Player.OutputName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Player.SignalPath}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <Border Height="1" Background="{DynamicResource EchoDivider}" Margin="0,4" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="输出设备" Classes="heading" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Name="RefreshOutputButton" Content="刷新" Command="{Binding Player.AudioSettings.RefreshCommand}" /></Grid>
            <TextBlock Text="输出模式" Classes="muted" FontSize="12" />
            <ComboBox Name="OutputModeInput" ItemsSource="{Binding Player.AudioSettings.Modes}" SelectedItem="{Binding Player.AudioSettings.SelectedMode}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputMode"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="输出设备" Classes="muted" FontSize="12" />
            <ComboBox Name="OutputDeviceInput" ItemsSource="{Binding Player.AudioSettings.Devices}" SelectedItem="{Binding Player.AudioSettings.SelectedDevice}" IsEnabled="{Binding !Player.AudioSettings.IsRefreshing}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputDevice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="系统默认输出会跟随系统选用的音频设备。独占、ASIO 和 WDM-KS 以当前宿主与驱动能力为准。" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="设置">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Margin="6,20,6,24">
            <TextBlock Text="输出格式" Classes="heading" FontWeight="SemiBold" FontSize="15" />
            <Grid ColumnDefinitions="*,180" ColumnSpacing="12"><TextBlock Text="采样率 / Hz" VerticalAlignment="Center" FontSize="13" />
              <ComboBox Name="SampleRateInput" Grid.Column="1" ItemsSource="{Binding Player.AudioSettings.Rates}" SelectedItem="{Binding Player.AudioSettings.SampleRate}" HorizontalAlignment="Stretch" /></Grid>
            <Grid ColumnDefinitions="*,180" ColumnSpacing="12"><TextBlock Text="缓冲帧数" VerticalAlignment="Center" FontSize="13" />
              <NumericUpDown Name="BufferInput" Grid.Column="1" Minimum="64" Maximum="32768" Increment="64" Value="{Binding Player.AudioSettings.BufferFrames}" /></Grid>
            <ComboBox Name="OutputFormatInput" ItemsSource="{Binding Player.AudioSettings.AvailableFormats}" SelectedItem="{Binding Player.AudioSettings.SelectedFormat}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="player:OutputFormatChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Spacing="12" IsVisible="{Binding Player.AudioSettings.IsDsd}">
              <TextBlock Text="DSD 传输率 / Hz" Classes="muted" FontSize="12" />
              <ComboBox ItemsSource="{Binding Player.AudioSettings.DsdRates}" SelectedItem="{Binding Player.AudioSettings.DsdTransportRate}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="12" IsVisible="{Binding Player.AudioSettings.IsAsio}">
              <Grid ColumnDefinitions="*,120"><TextBlock Text="输出声道数" FontSize="13" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Minimum="2" Maximum="8" Increment="1" Value="{Binding Player.AudioSettings.OutputChannels}" IsEnabled="{Binding !Player.AudioSettings.IsDsd}" /></Grid>
              <Grid ColumnDefinitions="*,120"><TextBlock Text="起始声道（1 起）" FontSize="13" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Minimum="1" Maximum="129" Increment="1" Value="{Binding Player.AudioSettings.AsioChannelStart}" /></Grid>
              <Button Content="探测 DSD 支持" Command="{Binding Player.AudioSettings.ProbeDsdCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Player.AudioSettings.DsdCapabilities}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource EchoDivider}" Margin="0,8" />
            <TextBlock Text="音效与速度" Classes="heading" FontSize="15" FontWeight="SemiBold" />
            <CheckBox Name="EqualizerInput" Content="启用均衡器" IsChecked="{Binding Player.AudioSettings.EqualizerEnabled}" />
            <CheckBox Name="CrossfeedInput" Content="耳机交叉馈送" IsChecked="{Binding Player.AudioSettings.CrossfeedEnabled}" />
            <Grid ColumnDefinitions="*,120"><TextBlock Text="播放速度" VerticalAlignment="Center" FontSize="13" /><NumericUpDown Name="PlaybackRateInput" Grid.Column="1" Minimum="0.5" Maximum="2" Increment="0.05" Value="{Binding Player.AudioSettings.PlaybackRate}" /></Grid>
            <TextBlock Text="修改后点击应用。实际采样率与格式以“诊断”中的输出确认结果为准。" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="诊断">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="6,20,6,24">
            <TextBlock Text="信号路径" Classes="heading" FontSize="15" FontWeight="SemiBold" />
            <SelectableTextBlock Text="{Binding Player.SignalPath}" FontSize="13" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Player.Error}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <Button Content="复制诊断信息" Click="OnCopyDiagnostics" HorizontalAlignment="Left" />
            <Border Height="1" Background="{DynamicResource EchoDivider}" />
            <TextBlock Text="恢复播放" Classes="heading" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="连接设备或修正配置后，可尝试重新打开当前输出并恢复播放。" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <Button Content="重试播放" Command="{Binding Player.RecoverCommand}" HorizontalAlignment="Left" />
            <Button Content="恢复普通输出与音效默认值" Command="{Binding Player.AudioSettings.ResetCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="22,14,22,20">
      <StackPanel Spacing="10"><TextBlock Name="AudioFeedback" Text="{Binding Player.AudioSettings.Message}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        <Button Name="ApplyAudioButton" Content="应用设置" Classes="primary" Command="{Binding Player.AudioSettings.ApplyCommand}" IsEnabled="{Binding !Player.AudioSettings.IsRefreshing}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></StackPanel>
    </Border>
  </Grid>
</UserControl>
