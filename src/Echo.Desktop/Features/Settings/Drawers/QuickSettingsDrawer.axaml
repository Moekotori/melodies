<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Settings.Drawers.QuickSettingsDrawer" x:DataType="shell:ShellViewModel">
  <UserControl.Styles><StyleInclude Source="DrawerStyles.axaml" /></UserControl.Styles>
  <Grid ClipToBounds="True">
    <Border Name="Scrim" Background="{DynamicResource DrawerScrim}" PointerPressed="OnScrimPressed" />
    <Border Name="DrawerPanel" Width="440" HorizontalAlignment="Right" Background="{DynamicResource DrawerSurface}"
            BorderBrush="{DynamicResource DrawerStroke}" BorderThickness="1,0,0,0" BoxShadow="-8 12 32 0 #24080A18">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border Padding="22,20,22,0">
          <Grid ColumnDefinitions="36,*,32" ColumnSpacing="12" Height="40">
            <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource EchoQueueActive}">
              <icon:GlyphIcon Kind="sliders" Width="19" Height="19" Stroke="{DynamicResource EchoAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding QuickSettingsTitle}" FontSize="20" FontWeight="SemiBold" Classes="heading" VerticalAlignment="Center" />
            <Button Name="CloseDrawerButton" Classes="drawer-close" Grid.Column="2" Width="32" Height="32" MinHeight="32" Padding="0" VerticalAlignment="Center"
                    Click="OnCloseClicked" ToolTip.Tip="{DynamicResource ui.QuickSettingsDrawer.240d2127ad8d}" AutomationProperties.Name="{DynamicResource ui.QuickSettingsDrawer.6a1aca397230}"><icon:GlyphIcon Kind="close" Width="18" Height="18" /></Button>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="22,18,22,0" Spacing="6">
          <Border Height="42" CornerRadius="12" BorderBrush="{DynamicResource DrawerStroke}" BorderThickness="1" Background="{DynamicResource DrawerInset}" Padding="13,0">
            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
              <icon:GlyphIcon Kind="search" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBox Name="DrawerSearchInput" Grid.Column="1" Classes="drawer-search" PlaceholderText="{DynamicResource ui.SettingsView.2874151bd36b}" MaxLength="100" TextChanged="OnSearchChanged" AutomationProperties.Name="{DynamicResource drawer.search.accessibleName}" />
              <Border Grid.Column="2" Background="{DynamicResource DrawerControl}" CornerRadius="5" Padding="6,3" VerticalAlignment="Center"><TextBlock Text="Ctrl F" FontSize="9" FontWeight="SemiBold" Classes="muted" /></Border>
            </Grid>
          </Border>
          <TextBlock Name="SearchFeedback" FontSize="11" Classes="muted" IsVisible="False" />
        </StackPanel>
        <ContentControl Name="DrawerContent" Grid.Row="2" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
