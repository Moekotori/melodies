<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icon="using:Echo.Desktop.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="DrawerToggleTrack">#d9dbe1</SolidColorBrush></ResourceDictionary>
        <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="DrawerToggleTrack">#454955</SolidColorBrush></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ControlTheme x:Key="DrawerTabsTheme" TargetType="TabControl">
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate>
          <Grid RowDefinitions="44,*"><Border Margin="22,0" Background="{DynamicResource DrawerInset}" CornerRadius="12" Padding="4"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" /></Border>
            <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          </Grid>
        </ControlTemplate></Setter>
      </ControlTheme>
      <ControlTheme x:Key="DrawerTabTheme" TargetType="TabItem">
        <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="Padding" Value="4,6" />
        <Setter Property="Template"><ControlTemplate><Border Name="TabBackground" Background="Transparent" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Margin="1,0" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Header}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" /></Border></ControlTemplate></Setter>
        <Style Selector="^:selected"><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /></Style>
        <Style Selector="^:selected /template/ Border#TabBackground"><Setter Property="Background" Value="{DynamicResource DrawerControl}" /><Setter Property="BorderBrush" Value="{DynamicResource DrawerStroke}" /><Setter Property="BoxShadow" Value="0 2 4 0 #08000000" /></Style>
        <Style Selector="^:pointerover:not(:selected) /template/ Border#TabBackground"><Setter Property="Background" Value="{DynamicResource DrawerHover}" /></Style>
        <Style Selector="^:focus-visible /template/ Border#TabBackground"><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="BorderThickness" Value="1" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="DrawerSwitchTheme" TargetType="CheckBox">
        <Setter Property="Width" Value="38" /><Setter Property="Height" Value="22" /><Setter Property="MinHeight" Value="22" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><ControlTemplate><Border Name="SwitchTrack" Background="{DynamicResource DrawerToggleTrack}" CornerRadius="11" Padding="3"><Border Name="SwitchKnob" Width="16" Height="16" CornerRadius="8" Background="White" BoxShadow="0 1 3 0 #24000000" HorizontalAlignment="Left" /></Border></ControlTemplate></Setter>
        <Style Selector="^:checked /template/ Border#SwitchTrack"><Setter Property="Background" Value="{DynamicResource EchoAccent}" /></Style>
        <Style Selector="^:checked /template/ Border#SwitchKnob"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
        <Style Selector="^:focus-visible /template/ Border#SwitchTrack"><Setter Property="BorderBrush" Value="{DynamicResource EchoAccentText}" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="DrawerModeTheme" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="4,6" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template"><ControlTemplate><Border Name="ModeBackground" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="1,0"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" /></Border></ControlTemplate></Setter>
        <Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /><Setter Property="FontWeight" Value="Medium" /></Style>
        <Style Selector="^:selected /template/ Border#ModeBackground"><Setter Property="Background" Value="{DynamicResource EchoField}" /></Style>
        <Style Selector="^:pointerover:not(:selected) /template/ Border#ModeBackground"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="DrawerDeviceTheme" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12" /><Setter Property="MinHeight" Value="68" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><ControlTemplate><Border Name="DeviceBackground" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" /></Border></ControlTemplate></Setter>
        <Style Selector="^:selected /template/ Border#DeviceBackground"><Setter Property="Background" Value="{DynamicResource EchoQueueActive}" /><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /></Style>
        <Style Selector="^:pointerover:not(:selected) /template/ Border#DeviceBackground"><Setter Property="Background" Value="{DynamicResource DrawerHover}" /></Style>
        <Style Selector="^:focus-visible /template/ Border#DeviceBackground"><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="BorderThickness" Value="1" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="DrawerSliderTrackTheme" TargetType="RepeatButton">
        <Setter Property="Template"><ControlTemplate><Grid Background="Transparent" Height="26"><Border Background="{TemplateBinding Background}" Height="3" CornerRadius="2" VerticalAlignment="Center" /></Grid></ControlTemplate></Setter>
      </ControlTheme>
      <ControlTheme x:Key="DrawerSliderThumbTheme" TargetType="Thumb">
        <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="7" /></ControlTemplate></Setter>
      </ControlTheme>
      <ControlTheme x:Key="DrawerSliderTheme" TargetType="Slider">
        <Setter Property="Template"><ControlTemplate>
          <Grid Height="26">
            <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="Horizontal">
              <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{DynamicResource DrawerSliderTrackTheme}" Background="{DynamicResource EchoAccent}" Focusable="False" /></Track.DecreaseButton>
              <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{DynamicResource DrawerSliderTrackTheme}" Background="{DynamicResource DrawerToggleTrack}" Focusable="False" /></Track.IncreaseButton>
              <Thumb Width="14" Height="14" Theme="{DynamicResource DrawerSliderThumbTheme}" Background="{DynamicResource EchoAccent}" />
            </Track>
          </Grid>
        </ControlTemplate></Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="TabControl.drawer-tabs"><Setter Property="Theme" Value="{DynamicResource DrawerTabsTheme}" /></Style>
  <Style Selector="TabControl.drawer-tabs TabItem"><Setter Property="Theme" Value="{DynamicResource DrawerTabTheme}" /></Style>
  <Style Selector="CheckBox.drawer-switch"><Setter Property="Theme" Value="{DynamicResource DrawerSwitchTheme}" /></Style>
  <Style Selector="ListBox.drawer-modes ListBoxItem"><Setter Property="Theme" Value="{DynamicResource DrawerModeTheme}" /></Style>
  <Style Selector="ListBox.drawer-devices ListBoxItem"><Setter Property="Theme" Value="{DynamicResource DrawerDeviceTheme}" /></Style>
  <Style Selector="ListBox.drawer-modes"><Setter Property="Background" Value="{DynamicResource DrawerInset}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="4" /><Setter Property="Height" Value="42" /></Style>
  <Style Selector="ListBox.drawer-devices"><Setter Property="Background" Value="{DynamicResource DrawerInset}" /><Setter Property="BorderBrush" Value="{DynamicResource DrawerStroke}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="5" /></Style>
  <Style Selector="TextBlock.drawer-section"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /></Style>
  <Style Selector="Border.drawer-row"><Setter Property="MinHeight" Value="48" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="2,10" /></Style>
  <Style Selector="Button.drawer-help"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Width" Value="22" /><Setter Property="Height" Value="26" /><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
  <Style Selector="Button.drawer-action"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="13,7" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="{DynamicResource DrawerControl}" /><Setter Property="BorderBrush" Value="{DynamicResource DrawerStroke}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="ComboBox"><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="36" /><Setter Property="Background" Value="{DynamicResource DrawerControl}" /><Setter Property="BorderBrush" Value="{DynamicResource DrawerStroke}" /><Setter Property="Foreground" Value="{DynamicResource EchoText}" /><Setter Property="CornerRadius" Value="10" /></Style>
  <Style Selector="NumericUpDown"><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="36" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="{DynamicResource DrawerControl}" /><Setter Property="BorderBrush" Value="{DynamicResource DrawerStroke}" /><Setter Property="Foreground" Value="{DynamicResource EchoText}" /></Style>
  <Style Selector="Button.drawer-close"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="Background" Value="{DynamicResource DrawerInset}" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="CornerRadius" Value="10" /></Style>
  <Style Selector="Button.drawer-close:pointerover"><Setter Property="Background" Value="{DynamicResource DrawerHover}" /><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /></Style>
  <Style Selector="Button.drawer-help:pointerover, Button.drawer-help:focus-visible"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Button.drawer-help:pointerover icon|GlyphIcon, Button.drawer-help:focus-visible icon|GlyphIcon"><Setter Property="Stroke" Value="{DynamicResource EchoAccentText}" /></Style>
  <Style Selector="Button.drawer-action.drawer-primary"><Setter Property="Background" Value="{DynamicResource EchoAccent}" /><Setter Property="Foreground" Value="{DynamicResource EchoPage}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style Selector="TextBox.drawer-search"><Setter Property="FontSize" Value="12" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="TemplatedControl.drawer-match"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
  <Style Selector="Slider"><Setter Property="Theme" Value="{DynamicResource DrawerSliderTheme}" /></Style>
  <Style Selector="ScrollViewer.drawer-scroll"><Setter Property="Margin" Value="0,0,4,0" /><Setter Property="Padding" Value="22,0,18,0" /></Style>
</Styles>
