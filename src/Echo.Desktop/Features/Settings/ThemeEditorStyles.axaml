<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ControlTheme x:Key="ThemeChoiceItem" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="ChoiceSurface" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#ChoiceSurface">
        <Setter Property="Background" Value="{DynamicResource EchoHover}" />
      </Style>
      <Style Selector="^:selected /template/ Border#ChoiceSurface">
        <Setter Property="Background" Value="{DynamicResource EchoField}" />
        <Setter Property="BoxShadow" Value="0 1 4 0 #18000000" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#ChoiceSurface">
        <Setter Property="BorderBrush" Value="{DynamicResource EchoFocus}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ThemeChoices" TargetType="ListBox">
      <Setter Property="AutoScrollToSelectedItem" Value="False" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource ThemeChoiceItem}" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Background" Value="{DynamicResource EchoPanelMuted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="SwitchTrack" CornerRadius="11" Background="{DynamicResource EchoBorder}" Padding="3">
            <Border Name="SwitchKnob" Width="16" Height="16" CornerRadius="8" Background="White" HorizontalAlignment="Left" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#SwitchTrack">
        <Setter Property="Background" Value="{DynamicResource EchoAccent}" />
      </Style>
      <Style Selector="^:checked /template/ Border#SwitchKnob">
        <Setter Property="HorizontalAlignment" Value="Right" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#SwitchTrack">
        <Setter Property="BorderBrush" Value="{DynamicResource EchoFocus}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ThemeSliderRail" TargetType="RepeatButton">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeSliderThumb" TargetType="Thumb">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{DynamicResource EchoAccent}" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource EchoField}" BoxShadow="0 1 3 0 #30000000" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeSlider" TargetType="Slider">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Template">
        <ControlTemplate>
          <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Theme="{StaticResource ThemeSliderRail}" Background="{DynamicResource EchoAccent}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Theme="{StaticResource ThemeSliderRail}" Background="{DynamicResource EchoBorder}" />
            </Track.IncreaseButton>
            <Track.Thumb>
              <Thumb Theme="{StaticResource ThemeSliderThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector=":is(ListBox).theme-choices">
    <Setter Property="Theme" Value="{StaticResource ThemeChoices}" />
  </Style>
  <Style Selector=":is(ListBox).theme-mode">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <UniformGrid Columns="5" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="TextBlock.theme-caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource EchoMuted}" />
  </Style>
  <Style Selector="TextBlock.theme-section">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource EchoHeading}" />
  </Style>
  <Style Selector="TextBox.theme-input">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource EchoBorder}" />
    <Setter Property="Background" Value="{DynamicResource EchoField}" />
  </Style>
  <Style Selector="TextBox.theme-input:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" />
  </Style>
  <Style Selector="TextBox.theme-hex">
    <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Button.theme-action">
    <Setter Property="Background" Value="{DynamicResource EchoPanelMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EchoBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="13,8" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Button.theme-quiet">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource EchoMuted}" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.theme-preset">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.theme-preset /template/ Border#PART_ButtonBorder">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.theme-preset.selected Border.preset-frame">
    <Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.theme-preset:pointerover Border.preset-frame">
    <Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="Theme" Value="{StaticResource ThemeSlider}" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource EchoField}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EchoBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector=":is(ListBox).theme-tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector=":is(ListBox).theme-tabs ListBoxItem">
    <Setter Property="Padding" Value="13,9" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector=":is(ListBox).theme-tabs ListBoxItem /template/ Border#ChoiceSurface">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector=":is(ListBox).theme-tabs ListBoxItem:selected /template/ Border#ChoiceSurface">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" />
  </Style>
  <Style Selector=":is(ListBox).theme-tabs ListBoxItem:focus-visible /template/ Border#ChoiceSurface">
    <Setter Property="BorderBrush" Value="{DynamicResource EchoFocus}" />
  </Style>
  <Style Selector="Border.theme-color-tile:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource EchoMuted}" />
  </Style>
  <Style Selector="Button.theme-save">
    <Setter Property="Background" Value="{DynamicResource EchoAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource EchoOnAccent}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.theme-save TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource EchoOnAccent}" />
  </Style>
  <Style Selector="Button.theme-save:pointerover">
    <Setter Property="Background" Value="{DynamicResource EchoAccent}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <StyleInclude Source="/Features/Settings/ThemeWorkspaceStyles.axaml" />
</Styles>
