<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="using:Echo.Desktop.Theming"
             x:Class="Echo.Desktop.Features.Settings.ThemeWallpaperFineSettings" x:DataType="theme:ThemeViewModel">
  <UserControl.Styles><StyleInclude Source="/Features/Settings/ThemeWallpaperStyles.axaml" /></UserControl.Styles>
  <StackPanel Spacing="16">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
      <StackPanel Spacing="4"><TextBlock Text="{DynamicResource ui.ThemeWallpaperFineSettings.5484805add55}" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding WallpaperX, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeWallpaperFineSettings.a4c42dcc03c4}" /></StackPanel>
      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{DynamicResource ui.ThemeWallpaperFineSettings.985aade0a013}" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding WallpaperY, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeWallpaperFineSettings.6bb9c6e7ccb1}" /></StackPanel>
    </Grid>
    <StackPanel Spacing="6">
      <TextBlock Text="{DynamicResource ui.ThemeWallpaperFineSettings.df962a91489e}" Classes="wallpaper-label" />
      <ComboBox ItemsSource="{Binding VideoPauseChoices}" SelectedItem="{Binding SelectedVideoPauseChoice, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{DynamicResource ui.ThemeWallpaperFineSettings.823a29d68fdb}" />
    </StackPanel>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource ui.ThemeWallpaperFineSettings.df88249c26ad}" FontSize="13" Foreground="{DynamicResource EchoText}" />
        <TextBlock Text="{DynamicResource ui.ThemeWallpaperFineSettings.8a790bd43b63}" Classes="wallpaper-label" TextWrapping="Wrap" />
      </StackPanel>
      <ToggleButton Grid.Column="1" Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding WallpaperUnifiedOpacity, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource ui.ThemeWallpaperFineSettings.4e339357b950}" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource ui.ThemeWallpaperFineSettings.8e81302aee67}" FontSize="13" Foreground="{DynamicResource EchoText}" />
        <TextBlock Text="{DynamicResource ui.ThemeWallpaperFineSettings.7a75ebcfdd85}" Classes="wallpaper-label" TextWrapping="Wrap" />
      </StackPanel>
      <ToggleButton Grid.Column="1" Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding WallpaperVisualProtection, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource ui.ThemeWallpaperFineSettings.a3cfb2a1abec}" />
    </Grid>
    <Button Content="{DynamicResource ui.ThemeWallpaperFineSettings.8143c43db805}" Classes="theme-quiet" Command="{Binding ResetWallpaperPositionCommand}" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
