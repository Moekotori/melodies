<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="using:Echo.Desktop.Theming"
             x:Class="Echo.Desktop.Features.Settings.ThemeWallpaperFineSettings" x:DataType="theme:ThemeViewModel">
  <StackPanel Spacing="18">
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="28" RowSpacing="16">
      <StackPanel Spacing="5"><TextBlock Text="水平位置" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding WallpaperX, Mode=TwoWay}" AutomationProperties.Name="背景水平位置" /></StackPanel>
      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="垂直位置" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding WallpaperY, Mode=TwoWay}" AutomationProperties.Name="背景垂直位置" /></StackPanel>
      <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="{Binding WallpaperOpacity, StringFormat='背景不透明度 {0:0}%'}" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding WallpaperOpacity, Mode=TwoWay}" AutomationProperties.Name="背景不透明度" /></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8"><TextBlock Text="视频暂停策略" Classes="wallpaper-label" /><ComboBox ItemsSource="{Binding VideoPauseChoices}" SelectedItem="{Binding SelectedVideoPauseChoice, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="背景视频暂停策略" /></StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="10"><ToggleButton Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding WallpaperUnifiedOpacity, Mode=TwoWay}" AutomationProperties.Name="统一界面透明度" /><TextBlock Text="统一页面、侧栏与播放栏的透明度" FontSize="12" VerticalAlignment="Center" /></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="10"><ToggleButton Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding WallpaperVisualProtection, Mode=TwoWay}" AutomationProperties.Name="背景可读性保护" /><TextBlock Text="可读性保护" FontSize="12" VerticalAlignment="Center" /></StackPanel>
    <Button Content="重置位置" Classes="theme-quiet" Command="{Binding ResetWallpaperPositionCommand}" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
