<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="using:Echo.Desktop.Motion" x:Class="Echo.Desktop.Features.Settings.MotionPreview">
  <StackPanel Spacing="18">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Name="PageTab" Classes="tab active" Content="{DynamicResource ui.MotionPreview.3f2191b43607}" Tag="page" Click="SelectExample" />
      <Button Name="CoverTab" Classes="tab" Content="{DynamicResource ui.MotionPreview.82991e954027}" Tag="cover" Click="SelectExample" />
      <Button Name="ListTab" Classes="tab" Content="{DynamicResource ui.MotionPreview.4a4d36ea1c86}" Tag="list" Click="SelectExample" />
    </StackPanel>
    <Border Background="{DynamicResource EchoPanelMuted}" Padding="28" MinHeight="180">
      <motion:MotionPresenter Name="ExampleHost" SurfaceBrush="{DynamicResource EchoPanelMuted}" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="{DynamicResource ui.MotionPreview.950de3832805}" Click="Replay" />
      <Button Content="{DynamicResource ui.MotionPreview.266b6e66004c}" Click="ToggleDetails" />
      <Button Content="{DynamicResource ui.MotionPreview.29a3384c4f60}">
        <Button.Flyout><motion:MotionFlyout><StackPanel Width="240" Spacing="10">
          <TextBlock Text="{DynamicResource ui.MotionPreview.117764b36334}" Classes="heading" FontSize="16" />
          <TextBlock Text="{DynamicResource ui.MotionPreview.189f7a4a8b27}" Classes="muted" TextWrapping="Wrap" />
          <Button Content="{DynamicResource ui.MotionPreview.b2101414fb98}" Click="ShowNotice" />
        </StackPanel></motion:MotionFlyout></Button.Flyout>
      </Button>
    </StackPanel>
    <motion:MotionSurface Name="Details">
      <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
        <TextBlock Text="{DynamicResource ui.MotionPreview.bc729fb769ad}" Classes="muted" TextWrapping="Wrap" MaxWidth="620" />
      </Border>
    </motion:MotionSurface>
  </StackPanel>
</UserControl>
