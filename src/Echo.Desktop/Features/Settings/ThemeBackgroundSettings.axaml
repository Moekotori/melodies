<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Echo.Desktop.Theming" xmlns:settings="using:Echo.Desktop.Features.Settings"
             x:Class="Echo.Desktop.Features.Settings.ThemeBackgroundSettings" x:DataType="theme:ThemeViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Features/Settings/ThemeEditorStyles.axaml" />
    <StyleInclude Source="/Features/Settings/ThemeWallpaperStyles.axaml" />
  </UserControl.Styles>
  <StackPanel Spacing="22">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.f4b669c55756}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" />
        <TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.74c4cfdc866f}" Classes="wallpaper-label" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.f4f0ead1116b}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource EchoText}" />
        <ToggleButton Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding WallpaperEnabled, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.6873ddebe3ce}" />
      </StackPanel>
    </Grid>
    <Grid Name="WallpaperWorkspace" ColumnDefinitions="*,312" RowDefinitions="Auto,Auto" ColumnSpacing="28" RowSpacing="22">
      <StackPanel Name="PreviewColumn" Spacing="8">
        <settings:ThemeWallpaperPreview Name="WindowPreview" />
        <TextBlock Text="{Binding WallpaperStatus}" Classes="wallpaper-label" TextWrapping="Wrap" Margin="2,0,0,0" />
      </StackPanel>
      <StackPanel Name="AdjustmentColumn" Grid.Column="1" Spacing="16">
        <Border Classes="wallpaper-file">
          <StackPanel Spacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.9af69965f173}" Classes="wallpaper-kicker" />
              <TextBlock Text="{Binding WallpaperFileName}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EchoText}" ToolTip.Tip="{Binding Wallpaper}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource ui.ThemeBackgroundSettings.7e4eb0ddd360}" Classes="theme-save" Click="ChooseImage" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.f3dcf1db2928}" />
              <Button Content="{DynamicResource ui.ThemeBackgroundSettings.6135d4159e89}" Classes="theme-quiet" Command="{Binding ClearWallpaperCommand}" IsEnabled="{Binding HasWallpaperFile}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="{DynamicResource ui.ThemeBackgroundSettings.55077b0d1c7c}" Classes="theme-action" Click="ChooseWallpaperEngine" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.1aba8328fa66}" Classes="wallpaper-kicker" />
          <theme:ThemeChoiceList Name="WallpaperSelect" Classes="theme-choices wallpaper-options" ItemsSource="{Binding WallpaperChoices}" SelectedItem="{Binding SelectedWallpaperChoice, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.00420860661f}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          </theme:ThemeChoiceList>
        </StackPanel>
        <Border Classes="wallpaper-card">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.d443c8fcab04}" Classes="wallpaper-kicker" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.b762aec769a3}" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperZoom, StringFormat='{}{0:0}%'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="25" Maximum="400" Value="{Binding WallpaperZoom, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.2c05a9c4feba}" />
            </StackPanel>
            <Border Classes="wallpaper-rule" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.8e2f643ad160}" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperBrightness, StringFormat='{}{0:0}%'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="0" Maximum="200" Value="{Binding WallpaperBrightness, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.544406139520}" />
            </StackPanel>
            <Border Classes="wallpaper-rule" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.36bab7a3de7f}" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperBlur, StringFormat='{}{0:0} px'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="0" Maximum="40" Value="{Binding WallpaperBlur, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.80faf20d6a76}" />
            </StackPanel>
            <Border Classes="wallpaper-rule" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.f4b669c55756}" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperOpacity, StringFormat='{}{0:0}%'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding WallpaperOpacity, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.9eaa61edf066}" />
            </StackPanel>
            <Border Classes="wallpaper-rule" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.785d65c70fde}" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperUiOpacity, StringFormat='{}{0:0}%'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding WallpaperUiOpacity, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.0a337a204c6f}" />
            </StackPanel>
            <TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.763a1ab38075}" Classes="wallpaper-label" TextWrapping="Wrap" Margin="0,4,0,2" IsVisible="{Binding WallpaperVisualProtection}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.4963524494dc}" Classes="wallpaper-kicker" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{DynamicResource ui.ThemeBackgroundSettings.0c0be9c11e82}" Classes="theme-quiet" Command="{Binding ResetWallpaperEffectsCommand}" />
      </Grid>
      <theme:ThemeChoiceList Classes="theme-choices wallpaper-options" ItemsSource="{Binding WallpaperEffects}" SelectedItem="{Binding SelectedWallpaperEffect, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.8c375d57b855}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      </theme:ThemeChoiceList>
    </StackPanel>
    <StackPanel Spacing="2">
      <Expander Header="{DynamicResource ui.ThemeBackgroundSettings.f05bedd4edb0}" Classes="wallpaper-more" HorizontalAlignment="Stretch">
        <settings:ThemeWallpaperFineSettings Margin="4,2,4,12" />
      </Expander>
      <Expander Header="{DynamicResource ui.ThemeBackgroundSettings.7906aa8bb0b8}" Classes="wallpaper-more" HorizontalAlignment="Stretch">
        <StackPanel Spacing="14" Margin="4,2,4,14">
          <TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.97b57b75df11}" Classes="wallpaper-label" TextWrapping="Wrap" />
          <Border Classes="wallpaper-file">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock Text="{Binding PortraitFileName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding PortraitWallpaper}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="{DynamicResource ui.ThemeBackgroundSettings.c11330b85234}" Classes="theme-action" Click="ChoosePortrait" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.ab3415e81cf2}" />
                <Button Content="{DynamicResource ui.ThemeBackgroundSettings.6135d4159e89}" Classes="theme-quiet" Command="{Binding ClearPortraitWallpaperCommand}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <Button Content="{DynamicResource ui.ThemeBackgroundSettings.55077b0d1c7c}" Classes="theme-action" Click="ChoosePortraitWallpaperEngine" HorizontalAlignment="Left" />
          <ComboBox ItemsSource="{Binding WallpaperChoices}" SelectedItem="{Binding SelectedPortraitFit, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.4928754089c6}" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="12">
            <StackPanel Spacing="4"><TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.5484805add55}" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding PortraitX, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.ff224239e0d1}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{DynamicResource ui.ThemeBackgroundSettings.985aade0a013}" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding PortraitY, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.4278dffd4b43}" /></StackPanel>
            <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="{Binding PortraitZoom, StringFormat='缩放 {0:0}%'}" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="25" Maximum="400" Value="{Binding PortraitZoom, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeBackgroundSettings.1a7a5bc759a0}" /></StackPanel>
          </Grid>
        </StackPanel>
      </Expander>
      <Expander Header="{DynamicResource appearance.fonts.covers}" Classes="wallpaper-more" HorizontalAlignment="Stretch">
        <StackPanel Spacing="16" Margin="4,2,4,12">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource appearance.native.0e3e9f32bbdf}" FontSize="13" VerticalAlignment="Center" /><ToggleButton Grid.Column="1" Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding RoundedCovers, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource appearance.native.0e3e9f32bbdf}" /></Grid>
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{DynamicResource appearance.native.08af2512c311}" FontSize="13" /><TextBlock Text="{DynamicResource appearance.native.71eed35fa2f7}" Classes="theme-caption" /></StackPanel><ToggleButton Grid.Column="1" Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding ArtistAlbumArtwork, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource appearance.native.08af2512c311}" /></Grid>
        </StackPanel>
      </Expander>
    </StackPanel>
  </StackPanel>
</UserControl>
