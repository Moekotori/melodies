<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Echo.Desktop.Theming" xmlns:settings="using:Echo.Desktop.Features.Settings"
             x:Class="Echo.Desktop.Features.Settings.ThemeBackgroundSettings" x:DataType="theme:ThemeViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Features/Settings/ThemeEditorStyles.axaml" />
    <StyleInclude Source="/Features/Settings/ThemeWallpaperStyles.axaml" />
  </UserControl.Styles>
  <StackPanel Spacing="22">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
      <StackPanel Spacing="4">
        <TextBlock Text="背景" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" />
        <TextBlock Text="把喜欢的画面铺到窗口后面。" Classes="wallpaper-label" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="启用" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource EchoText}" />
        <ToggleButton Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding WallpaperEnabled, Mode=TwoWay}" AutomationProperties.Name="启用自定义背景" />
      </StackPanel>
    </Grid>
    <Grid Name="WallpaperWorkspace" ColumnDefinitions="*,312" RowDefinitions="Auto,Auto" ColumnSpacing="28" RowSpacing="22">
      <StackPanel Name="PreviewColumn" Spacing="8">
        <settings:ThemeWallpaperPreview Name="WindowPreview" />
        <TextBlock Text="{Binding WallpaperStatus}" Classes="wallpaper-label" TextWrapping="Wrap" Margin="2,0,0,0" />
      </StackPanel>
      <StackPanel Name="AdjustmentColumn" Grid.Column="1" Spacing="16">
        <Border Classes="wallpaper-file">
          <StackPanel Spacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="素材" Classes="wallpaper-kicker" />
              <TextBlock Text="{Binding WallpaperFileName}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EchoText}" ToolTip.Tip="{Binding Wallpaper}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="导入图片或视频" Classes="theme-save" Click="ChooseImage" AutomationProperties.Name="导入主背景" />
              <Button Content="移除" Classes="theme-quiet" Command="{Binding ClearWallpaperCommand}" IsEnabled="{Binding HasWallpaperFile}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="从 Wallpaper Engine 选择" Classes="theme-action" Click="ChooseWallpaperEngine" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <StackPanel Spacing="8">
          <TextBlock Text="画面适配" Classes="wallpaper-kicker" />
          <theme:ThemeChoiceList Name="WallpaperSelect" Classes="theme-choices wallpaper-options" ItemsSource="{Binding WallpaperChoices}" SelectedItem="{Binding SelectedWallpaperChoice, Mode=TwoWay}" AutomationProperties.Name="图片适配">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          </theme:ThemeChoiceList>
        </StackPanel>
        <Border Classes="wallpaper-card">
          <StackPanel Spacing="8">
            <TextBlock Text="氛围" Classes="wallpaper-kicker" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="缩放" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperZoom, StringFormat='{}{0:0}%'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="25" Maximum="400" Value="{Binding WallpaperZoom, Mode=TwoWay}" AutomationProperties.Name="背景缩放" />
            </StackPanel>
            <Border Classes="wallpaper-rule" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="亮度" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperBrightness, StringFormat='{}{0:0}%'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="0" Maximum="200" Value="{Binding WallpaperBrightness, Mode=TwoWay}" AutomationProperties.Name="背景亮度" />
            </StackPanel>
            <Border Classes="wallpaper-rule" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="模糊" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperBlur, StringFormat='{}{0:0} px'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="0" Maximum="40" Value="{Binding WallpaperBlur, Mode=TwoWay}" AutomationProperties.Name="背景模糊" />
            </StackPanel>
            <Border Classes="wallpaper-rule" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="背景" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperOpacity, StringFormat='{}{0:0}%'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding WallpaperOpacity, Mode=TwoWay}" AutomationProperties.Name="背景不透明度" />
            </StackPanel>
            <Border Classes="wallpaper-rule" />
            <StackPanel Spacing="1">
              <Grid ColumnDefinitions="*,56"><TextBlock Text="界面" Classes="wallpaper-label" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding WallpaperUiOpacity, StringFormat='{}{0:0}%'}" Classes="wallpaper-value" TextAlignment="Right" /></Grid>
              <Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding WallpaperUiOpacity, Mode=TwoWay}" AutomationProperties.Name="背景界面不透明度" />
            </StackPanel>
            <TextBlock Text="可读性保护会留住一层浅浅的界面底色。" Classes="wallpaper-label" TextWrapping="Wrap" Margin="0,4,0,2" IsVisible="{Binding WallpaperVisualProtection}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="效果预设" Classes="wallpaper-kicker" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="恢复均衡" Classes="theme-quiet" Command="{Binding ResetWallpaperEffectsCommand}" />
      </Grid>
      <theme:ThemeChoiceList Classes="theme-choices wallpaper-options" ItemsSource="{Binding WallpaperEffects}" SelectedItem="{Binding SelectedWallpaperEffect, Mode=TwoWay}" AutomationProperties.Name="背景效果预设">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      </theme:ThemeChoiceList>
    </StackPanel>
    <StackPanel Spacing="2">
      <Expander Header="位置与更多效果" Classes="wallpaper-more" HorizontalAlignment="Stretch">
        <settings:ThemeWallpaperFineSettings Margin="4,2,4,12" />
      </Expander>
      <Expander Header="竖屏背景" Classes="wallpaper-more" HorizontalAlignment="Stretch">
        <StackPanel Spacing="14" Margin="4,2,4,14">
          <TextBlock Text="窗口高于宽时自动切换。没有单独素材时，继续用主背景。" Classes="wallpaper-label" TextWrapping="Wrap" />
          <Border Classes="wallpaper-file">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock Text="{Binding PortraitFileName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding PortraitWallpaper}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="选择" Classes="theme-action" Click="ChoosePortrait" AutomationProperties.Name="选择竖屏背景" />
                <Button Content="移除" Classes="theme-quiet" Command="{Binding ClearPortraitWallpaperCommand}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <Button Content="从 Wallpaper Engine 选择" Classes="theme-action" Click="ChoosePortraitWallpaperEngine" HorizontalAlignment="Left" />
          <ComboBox ItemsSource="{Binding WallpaperChoices}" SelectedItem="{Binding SelectedPortraitFit, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="竖屏图片适配" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="12">
            <StackPanel Spacing="4"><TextBlock Text="水平位置" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding PortraitX, Mode=TwoWay}" AutomationProperties.Name="竖屏水平位置" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="垂直位置" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="0" Maximum="100" Value="{Binding PortraitY, Mode=TwoWay}" AutomationProperties.Name="竖屏垂直位置" /></StackPanel>
            <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="{Binding PortraitZoom, StringFormat='缩放 {0:0}%'}" Classes="wallpaper-label" /><Slider Classes="wallpaper-slider" Minimum="25" Maximum="400" Value="{Binding PortraitZoom, Mode=TwoWay}" AutomationProperties.Name="竖屏背景缩放" /></StackPanel>
          </Grid>
        </StackPanel>
      </Expander>
      <Expander Header="字体与文字" Classes="wallpaper-more" HorizontalAlignment="Stretch">
        <settings:ThemeTypographySettings Margin="4,2,4,12" />
      </Expander>
    </StackPanel>
  </StackPanel>
</UserControl>
