<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock.wallpaper-label"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
  <Style Selector="TextBlock.wallpaper-value"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource EchoText}" /></Style>
  <Style Selector="Button.wallpaper-preview-tone"><Setter Property="Background" Value="Transparent" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="Padding" Value="9,5" /><Setter Property="CornerRadius" Value="4" /></Style>
  <Style Selector="Button.wallpaper-preview-tone.selected"><Setter Property="Background" Value="{DynamicResource EchoPanelMuted}" /><Setter Property="Foreground" Value="{DynamicResource EchoText}" /></Style>
  <Style Selector=":is(ListBox).wallpaper-options"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector=":is(ListBox).wallpaper-options ListBoxItem"><Setter Property="Padding" Value="11,7" /><Setter Property="Margin" Value="0,0,5,5" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector=":is(ListBox).wallpaper-options ListBoxItem /template/ Border#ChoiceSurface"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="CornerRadius" Value="5" /><Setter Property="BoxShadow" Value="0 0 0 0 Transparent" /></Style>
  <Style Selector=":is(ListBox).wallpaper-options ListBoxItem:selected /template/ Border#ChoiceSurface"><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="Background" Value="{DynamicResource EchoField}" /></Style>
  <Style Selector=":is(ListBox).wallpaper-options ListBoxItem:selected"><Setter Property="Foreground" Value="{DynamicResource EchoAccent}" /></Style>
  <Style Selector="Slider.wallpaper-slider"><Setter Property="MinHeight" Value="18" /><Setter Property="Height" Value="24" /></Style>
  <Style Selector="Expander.wallpaper-more"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
</Styles>
