<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Echo.Desktop.Features.Settings" xmlns:models="using:Echo.Desktop.Features.Settings.Models"
             xmlns:icon="using:Echo.Desktop.Controls" xmlns:motion="using:Echo.Desktop.Motion"
             x:Class="Echo.Desktop.Features.Settings.SettingsView" x:DataType="settings:SettingsViewModel">
  <Grid Margin="32,28,32,28" RowDefinitions="64,*" ColumnDefinitions="216,*" ColumnSpacing="32" Name="SettingsLayout">
    <settings:SettingsNavigationView Grid.RowSpan="2" Name="CategoryNavigation" />
    <Grid Grid.Column="1" ColumnDefinitions="*" Margin="0,0,8,0" Name="SettingsHeader">
      <StackPanel Spacing="8" VerticalAlignment="Top" Margin="0,4,0,0">
        <TextBlock Text="{Binding ActiveCategory.Title}" FontSize="26" FontWeight="SemiBold" Classes="heading" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ActiveCategory.Description}" FontSize="13" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
      <Border Name="SettingsSearchBox" Grid.RowSpan="2" Height="40" VerticalAlignment="Top" Margin="0,54,8,0" Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="8" Padding="13,0">
        <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
          <icon:GlyphIcon Kind="search" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBox Name="SearchInput" Grid.Column="1" Classes="settings-search" Text="{Binding Query, Mode=TwoWay}" PlaceholderText="{DynamicResource ui.SettingsView.89940594eac1}" MaxLength="140" AutomationProperties.Name="{DynamicResource ui.SettingsView.2874151bd36b}" />
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Border IsVisible="{Binding !HasSearchResults}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="5" Padding="5,4"><TextBlock Text="Ctrl K" FontSize="9" Classes="muted" /></Border>
            <Button IsVisible="{Binding HasSearchResults}" Command="{Binding ClearSearchCommand}" Width="24" Height="28" MinHeight="28" Padding="0" ToolTip.Tip="{DynamicResource ui.AlbumsView.b6f00afa6537}"><icon:GlyphIcon Kind="close" Width="14" Height="14" /></Button>
          </Grid>
        </Grid>
      </Border>
    <motion:MotionPresenter Grid.Row="1" Grid.Column="1" Name="SectionHost" />
    <Border Name="SearchResultsPopup" Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasSearchResults}" Margin="0,-10,8,0" Width="480" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="8" Padding="7">
      <StackPanel MaxHeight="500">
        <TextBlock Text="{DynamicResource ui.SettingsView.f80e5af47264}" Classes="muted" Margin="12" IsVisible="{Binding HasNoSearchResults}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SearchResults}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:SettingsSearchResult">
            <Button Classes="settings-search-result" Classes.active="{Binding IsActive}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,9" Command="{Binding $parent[settings:SettingsView].((settings:SettingsViewModel)DataContext).OpenResultCommand}" CommandParameter="{Binding}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding Title}" FontSize="13" /><TextBlock Grid.Column="1" Text="{Binding CategoryTitle}" Classes="muted" FontSize="11" /></Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
