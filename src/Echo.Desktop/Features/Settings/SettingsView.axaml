<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Echo.Desktop.Features.Settings" xmlns:models="using:Echo.Desktop.Features.Settings.Models"
             xmlns:icon="using:Echo.Desktop.Controls" xmlns:motion="using:Echo.Desktop.Motion"
             x:Class="Echo.Desktop.Features.Settings.SettingsView" x:DataType="settings:SettingsViewModel">
  <Grid Margin="28,22,28,24" RowDefinitions="50,*" Name="SettingsLayout">
    <Grid ColumnDefinitions="230,500,*" ColumnSpacing="26" Name="SettingsHeader">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Command="{Binding BackCommand}" Width="28" Height="40" MinHeight="40" Padding="0" ToolTip.Tip="返回上一页（Esc）"><icon:GlyphIcon Kind="chevron-left" Width="18" Height="18" /></Button>
        <TextBlock Text="设置" FontSize="28" FontWeight="Bold" Classes="heading" VerticalAlignment="Center" />
      </StackPanel>
      <Border Grid.Column="1" Height="40" VerticalAlignment="Top" Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="8" Padding="13,0">
        <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
          <icon:GlyphIcon Kind="search" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBox Name="SearchInput" Grid.Column="1" Classes="settings-search" Text="{Binding Query, Mode=TwoWay}" PlaceholderText="搜索设置..." MaxLength="140" AutomationProperties.Name="搜索设置" />
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Border IsVisible="{Binding !HasSearchResults}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="5" Padding="5,4"><TextBlock Text="Ctrl K" FontSize="9" Classes="muted" /></Border>
            <Button IsVisible="{Binding HasSearchResults}" Command="{Binding ClearSearchCommand}" Width="24" Height="28" MinHeight="28" Padding="0" ToolTip.Tip="清空搜索"><icon:GlyphIcon Kind="close" Width="14" Height="14" /></Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="230,*" ColumnSpacing="26" Name="SettingsBody">
      <Border Background="{DynamicResource SettingsNavBackground}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="13" Padding="8,9">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding NavigationGroups}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="13" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:SettingsNavigationGroup">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="8,3,8,0"><TextBlock Text="{Binding Title}" FontSize="10" Classes="subtle settings-group-label" Classes.active="{Binding IsActive}" /><Border Grid.Column="1" Background="{DynamicResource SettingsDivider}" Height="1" VerticalAlignment="Center" /></Grid>
                <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:SettingsCategoryItem">
                    <Button Classes="settings-category" Classes.active="{Binding IsActive}" Command="{Binding $parent[settings:SettingsView].((settings:SettingsViewModel)DataContext).SelectCategoryCommand}" CommandParameter="{Binding Id}" ToolTip.Tip="{Binding Description}">
                      <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                        <icon:GlyphIcon Kind="{Binding Icon}" Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Classes="category-title" FontSize="13" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <motion:MotionPresenter Grid.Column="1" Name="SectionHost" />
    </Grid>
    <Border Name="SearchResultsPopup" Grid.Row="1" IsVisible="{Binding HasSearchResults}" Margin="256,-8,0,0" Width="500" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="8" Padding="7">
      <StackPanel MaxHeight="500">
        <TextBlock Text="没有找到相关设置" Classes="muted" Margin="12" IsVisible="{Binding HasNoSearchResults}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SearchResults}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:SettingsSearchResult">
            <Button Classes="settings-search-result" Classes.active="{Binding IsActive}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,9" Command="{Binding $parent[settings:SettingsView].((settings:SettingsViewModel)DataContext).OpenResultCommand}" CommandParameter="{Binding}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding Title}" FontSize="13" /><TextBlock Grid.Column="1" Text="{Binding CategoryTitle}" Classes="muted" FontSize="11" /></Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
