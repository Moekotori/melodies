<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Echo.Desktop.Theming" x:Class="Echo.Desktop.Features.Settings.ThemeWallpaperPreview" x:DataType="theme:ThemeViewModel">
  <UserControl.Styles><StyleInclude Source="/Features/Settings/ThemeEditorStyles.axaml" /><StyleInclude Source="/Features/Settings/ThemeWallpaperStyles.axaml" /></UserControl.Styles>
  <StackPanel Spacing="10">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.bfdc4787f2ca}" Classes="wallpaper-kicker" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Border Classes="wallpaper-tone">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Name="LightPreview" Content="{DynamicResource ui.ThemeWallpaperPreview.aa0819dfc4d8}" Classes="wallpaper-preview-tone" Click="PreviewLight" AutomationProperties.Name="{DynamicResource ui.ThemeWallpaperPreview.1e34c5d059b4}" />
            <Button Name="DarkPreview" Content="{DynamicResource ui.ThemeWallpaperPreview.a6b75d068032}" Classes="wallpaper-preview-tone" Click="PreviewDark" AutomationProperties.Name="{DynamicResource ui.ThemeWallpaperPreview.cf8b965d679a}" />
          </StackPanel>
        </Border>
        <Button Name="ExpandPreview" Content="{DynamicResource ui.ThemeWallpaperPreview.80f8fbcfa011}" Classes="wallpaper-preview-tone" Click="Expand" AutomationProperties.Name="{DynamicResource ui.ThemeWallpaperPreview.faac636bc38b}" />
      </StackPanel>
    </Grid>
    <Border Classes="wallpaper-stage">
      <Viewbox Name="SceneViewbox" Stretch="Uniform" MaxHeight="440">
        <ThemeVariantScope Name="PreviewTone" RequestedThemeVariant="Light">
          <Grid Name="PreviewScene" Width="960" Height="600" Background="{DynamicResource EchoPage}" ClipToBounds="True">
            <theme:WallpaperViewport Name="PreviewWallpaper" IsHitTestVisible="False" />
            <Grid RowDefinitions="44,*,86" ColumnDefinitions="188,*" IsHitTestVisible="False">
              <Border Grid.ColumnSpan="2" Background="{DynamicResource EchoTitlebar}">
                <Grid ColumnDefinitions="*,Auto" Margin="22,0">
                  <TextBlock Text="melodies" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource EchoHeading}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource EchoMuted}" Opacity="0.35" />
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource EchoMuted}" Opacity="0.35" />
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource EchoMuted}" Opacity="0.55" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="{DynamicResource EchoSidebar}" Padding="16,22">
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.203c08e0d44a}" FontSize="14" Foreground="{DynamicResource EchoMuted}" Margin="10,4" />
                  <Border Background="{DynamicResource EchoSidebarSelected}" CornerRadius="6" Padding="10,7">
                    <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.e470074a673c}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource EchoAccent}" />
                  </Border>
                  <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.9e070772b185}" FontSize="14" Foreground="{DynamicResource EchoMuted}" Margin="10,4" />
                  <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.8104520f6e69}" FontSize="14" Foreground="{DynamicResource EchoMuted}" Margin="10,4" />
                  <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.473e57b72072}" FontSize="14" Foreground="{DynamicResource EchoMuted}" Margin="10,4" />
                  <Border Height="1" Background="{DynamicResource EchoDivider}" Margin="10,12" />
                  <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.df3d58c7d84b}" FontSize="14" Foreground="{DynamicResource EchoMuted}" Margin="10,4" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource EchoPageContent}" Padding="40,32">
                <StackPanel Spacing="28">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.5181dae96fcb}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" />
                    <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.b5b38cb60c19}" FontSize="14" Foreground="{DynamicResource EchoMuted}" />
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <Border Width="108" Height="108" CornerRadius="8" Background="{DynamicResource EchoAccent}" Opacity="0.22">
                      <TextBlock Text="♪" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource EchoAccent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.360d70d4c97f}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" />
                      <Border Width="168" Height="7" Background="{DynamicResource EchoText}" Opacity="0.14" HorizontalAlignment="Left" CornerRadius="4" />
                      <Border Width="92" Height="6" Background="{DynamicResource EchoMuted}" Opacity="0.16" HorizontalAlignment="Left" CornerRadius="3" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="28,*,52" ColumnSpacing="12"><TextBlock Text="01" Foreground="{DynamicResource EchoAccent}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" /><Border Grid.Column="1" Height="7" Background="{DynamicResource EchoText}" Opacity="0.12" CornerRadius="4" VerticalAlignment="Center" /><Border Grid.Column="2" Height="6" Background="{DynamicResource EchoMuted}" Opacity="0.14" CornerRadius="3" VerticalAlignment="Center" /></Grid>
                    <Grid ColumnDefinitions="28,*,52" ColumnSpacing="12"><TextBlock Text="02" Foreground="{DynamicResource EchoMuted}" FontSize="12" VerticalAlignment="Center" /><Border Grid.Column="1" Width="240" Height="7" Background="{DynamicResource EchoText}" Opacity="0.1" HorizontalAlignment="Left" CornerRadius="4" VerticalAlignment="Center" /><Border Grid.Column="2" Height="6" Background="{DynamicResource EchoMuted}" Opacity="0.12" CornerRadius="3" VerticalAlignment="Center" /></Grid>
                    <Grid ColumnDefinitions="28,*,52" ColumnSpacing="12"><TextBlock Text="03" Foreground="{DynamicResource EchoMuted}" FontSize="12" VerticalAlignment="Center" /><Border Grid.Column="1" Width="280" Height="7" Background="{DynamicResource EchoText}" Opacity="0.1" HorizontalAlignment="Left" CornerRadius="4" VerticalAlignment="Center" /><Border Grid.Column="2" Height="6" Background="{DynamicResource EchoMuted}" Opacity="0.12" CornerRadius="3" VerticalAlignment="Center" /></Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource EchoPlayer}" Padding="22,16">
                <Grid ColumnDefinitions="*,Auto,*">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="6" Background="{DynamicResource EchoAccent}" Opacity="0.2" />
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                      <Border Width="120" Height="7" Background="{DynamicResource EchoText}" Opacity="0.2" CornerRadius="4" />
                      <Border Width="72" Height="6" Background="{DynamicResource EchoMuted}" Opacity="0.18" CornerRadius="3" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <TextBlock Text="‹" FontSize="22" Foreground="{DynamicResource EchoMuted}" VerticalAlignment="Center" />
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource EchoAccent}">
                      <Path Data="M 4,2 L 12,8 L 4,14 Z" Fill="{DynamicResource EchoOnAccent}" Width="10" Height="12" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </Border>
                    <TextBlock Text="›" FontSize="22" Foreground="{DynamicResource EchoMuted}" VerticalAlignment="Center" />
                  </StackPanel>
                  <Grid Grid.Column="2" Width="110" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource EchoDivider}" CornerRadius="2" />
                    <Border Width="46" HorizontalAlignment="Left" Background="{DynamicResource EchoAccent}" CornerRadius="2" />
                  </Grid>
                </Grid>
              </Border>
            </Grid>
            <Border Name="EmptyPreview" Background="{DynamicResource EchoPage}" IsVisible="True">
              <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource EchoPanelMuted}" HorizontalAlignment="Center">
                  <Path Data="M 4,16 L 10,8 L 16,14 L 22,6 L 28,16" Stroke="{DynamicResource EchoMuted}" StrokeThickness="1.6" Width="22" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.59bd431ca6ce}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Text="{DynamicResource ui.ThemeWallpaperPreview.1947a81c54d5}" FontSize="13" Foreground="{DynamicResource EchoMuted}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </ThemeVariantScope>
      </Viewbox>
    </Border>
  </StackPanel>
</UserControl>
