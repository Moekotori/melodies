<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Echo.Desktop.Theming" x:Class="Echo.Desktop.Features.Settings.ThemeWallpaperPreview" x:DataType="theme:ThemeViewModel">
  <UserControl.Styles><StyleInclude Source="/Features/Settings/ThemeEditorStyles.axaml" /><StyleInclude Source="/Features/Settings/ThemeWallpaperStyles.axaml" /></UserControl.Styles>
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="窗口预览" Classes="wallpaper-label" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
        <Button Name="LightPreview" Content="浅色" Classes="wallpaper-preview-tone" Click="PreviewLight" AutomationProperties.Name="预览浅色背景" />
        <Button Name="DarkPreview" Content="深色" Classes="wallpaper-preview-tone" Click="PreviewDark" AutomationProperties.Name="预览深色背景" />
        <Button Name="ExpandPreview" Content="放大" Classes="wallpaper-preview-tone" Click="Expand" Margin="8,0,0,0" AutomationProperties.Name="放大背景预览" />
      </StackPanel>
    </Grid>
    <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <Viewbox Name="SceneViewbox" Stretch="Uniform" MaxHeight="420">
        <ThemeVariantScope Name="PreviewTone" RequestedThemeVariant="Light">
          <Grid Name="PreviewScene" Width="960" Height="600" Background="{DynamicResource EchoPage}" ClipToBounds="True">
            <theme:WallpaperViewport Name="PreviewWallpaper" IsHitTestVisible="False" />
            <Grid RowDefinitions="40,*,82" ColumnDefinitions="178,*" IsHitTestVisible="False">
              <Border Grid.ColumnSpan="2" Background="{DynamicResource EchoTitlebar}">
                <Grid ColumnDefinitions="*,Auto" Margin="20,0">
                  <TextBlock Text="Melodies" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource EchoText}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center"><TextBlock Text="—" /><TextBlock Text="□" /><TextBlock Text="×" /></StackPanel>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="{DynamicResource EchoSidebar}" Padding="20,30">
                <StackPanel Spacing="24">
                  <TextBlock Text="首页" FontSize="15" Foreground="{DynamicResource EchoMuted}" />
                  <TextBlock Text="歌曲" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource EchoAccent}" />
                  <TextBlock Text="专辑" FontSize="15" Foreground="{DynamicResource EchoMuted}" />
                  <TextBlock Text="艺术家" FontSize="15" Foreground="{DynamicResource EchoMuted}" />
                  <TextBlock Text="歌单" FontSize="15" Foreground="{DynamicResource EchoMuted}" />
                  <Border Height="1" Background="{DynamicResource EchoDivider}" Margin="0,8" />
                  <TextBlock Text="设置" FontSize="15" Foreground="{DynamicResource EchoMuted}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource EchoPageContent}" Padding="36,28">
                <StackPanel Spacing="26">
                  <StackPanel Spacing="8"><TextBlock Text="你的音乐" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" /><TextBlock Text="背景效果将应用到整个窗口" FontSize="14" Foreground="{DynamicResource EchoMuted}" /></StackPanel>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="22">
                    <Border Width="116" Height="116" CornerRadius="6" Background="{DynamicResource EchoAccent}" Opacity="0.2"><TextBlock Text="♪" FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                      <TextBlock Text="背景预览" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" />
                      <Border Width="170" Height="8" Background="{DynamicResource EchoMuted}" Opacity="0.16" HorizontalAlignment="Left" CornerRadius="4" />
                      <Border Width="90" Height="7" Background="{DynamicResource EchoMuted}" Opacity="0.1" HorizontalAlignment="Left" CornerRadius="4" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="21" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="32,*,60" ColumnSpacing="14"><TextBlock Text="01" Foreground="{DynamicResource EchoMuted}" FontSize="13" /><Border Grid.Column="1" Width="300" Height="8" Background="{DynamicResource EchoText}" Opacity="0.12" HorizontalAlignment="Left" CornerRadius="4" /><Border Grid.Column="2" Height="7" Background="{DynamicResource EchoMuted}" Opacity="0.1" CornerRadius="4" /></Grid>
                    <Grid ColumnDefinitions="32,*,60" ColumnSpacing="14"><TextBlock Text="02" Foreground="{DynamicResource EchoMuted}" FontSize="13" /><Border Grid.Column="1" Width="230" Height="8" Background="{DynamicResource EchoText}" Opacity="0.12" HorizontalAlignment="Left" CornerRadius="4" /><Border Grid.Column="2" Height="7" Background="{DynamicResource EchoMuted}" Opacity="0.1" CornerRadius="4" /></Grid>
                    <Grid ColumnDefinitions="32,*,60" ColumnSpacing="14"><TextBlock Text="03" Foreground="{DynamicResource EchoMuted}" FontSize="13" /><Border Grid.Column="1" Width="270" Height="8" Background="{DynamicResource EchoText}" Opacity="0.12" HorizontalAlignment="Left" CornerRadius="4" /><Border Grid.Column="2" Height="7" Background="{DynamicResource EchoMuted}" Opacity="0.1" CornerRadius="4" /></Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource EchoPlayer}" Padding="24,14">
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="30">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Border Width="44" Height="44" CornerRadius="4" Background="{DynamicResource EchoAccent}" Opacity="0.18" /><StackPanel Spacing="9" VerticalAlignment="Center"><Border Width="105" Height="7" Background="{DynamicResource EchoText}" Opacity="0.18" CornerRadius="4" /><Border Width="65" Height="6" Background="{DynamicResource EchoMuted}" Opacity="0.14" CornerRadius="3" /></StackPanel></StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center"><TextBlock Text="‹" FontSize="28" Foreground="{DynamicResource EchoMuted}" /><TextBlock Text="▶" FontSize="24" Foreground="{DynamicResource EchoText}" /><TextBlock Text="›" FontSize="28" Foreground="{DynamicResource EchoMuted}" /></StackPanel>
                  <Border Grid.Column="2" Width="100" Height="4" Background="{DynamicResource EchoMuted}" Opacity="0.25" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
            <Border Name="EmptyPreview" Background="{DynamicResource EchoPage}" IsVisible="True">
              <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="从一张喜欢的图片开始" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" HorizontalAlignment="Center" />
                <TextBlock Text="选好背景，在这里查看窗口效果" FontSize="15" Foreground="{DynamicResource EchoMuted}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </ThemeVariantScope>
      </Viewbox>
    </Border>
  </StackPanel>
</UserControl>
