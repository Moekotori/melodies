<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Echo.Desktop.Shell" xmlns:player="using:Echo.Desktop.Features.Player" xmlns:playback="using:Echo.Playback"
             x:Class="Echo.Desktop.Features.Settings.PlaybackSettingsView" x:DataType="shell:ShellViewModel">
  <Expander Header="{DynamicResource ui.PlayerBar.ff71ead6e0d9}" HorizontalAlignment="Stretch">
    <Border Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="9" Padding="20">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource ui.PlayerBar.ff71ead6e0d9}" Classes="heading" FontSize="16" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="settings-control" Content="{DynamicResource ui.PlaybackSettingsView.dc54091453cc}" Command="{Binding Player.AudioSettings.RefreshCommand}" /></Grid>
        <Grid ColumnDefinitions="*,280" ColumnSpacing="20"><TextBlock Text="{DynamicResource ui.PlayerOutputPanel.c25a1af82895}" FontSize="15" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Player.AudioSettings.Modes}" SelectedItem="{Binding Player.AudioSettings.SelectedMode}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputMode"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
        <Grid ColumnDefinitions="*,280" ColumnSpacing="20"><TextBlock Text="{DynamicResource ui.PlaybackSettingsView.6538fe3f7e82}" FontSize="15" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Player.AudioSettings.Devices}" SelectedItem="{Binding Player.AudioSettings.SelectedDevice}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="playback:AudioOutputDevice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
        <Grid ColumnDefinitions="*,280" ColumnSpacing="20"><TextBlock Text="{DynamicResource ui.PlaybackSettingsView.0f549853799d}" FontSize="15" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Player.AudioSettings.Rates}" SelectedItem="{Binding Player.AudioSettings.SampleRate}" HorizontalAlignment="Stretch" /></Grid>
        <Grid ColumnDefinitions="*,280" ColumnSpacing="20"><TextBlock Text="{DynamicResource ui.PlayerOutputPanel.41d0e52f0a91}" FontSize="15" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Player.AudioSettings.Formats}" SelectedItem="{Binding Player.AudioSettings.SelectedFormat}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="player:OutputFormatChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
        <Grid ColumnDefinitions="*,280" ColumnSpacing="20"><TextBlock Text="{DynamicResource ui.PlayerOutputPanel.cc143767eee8}" FontSize="15" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Minimum="128" Maximum="8192" Increment="128" Value="{Binding Player.AudioSettings.BufferFrames}" /></Grid>
        <CheckBox Content="{DynamicResource ui.PlayerOutputPanel.61600fa691d5}" IsChecked="{Binding Player.AudioSettings.EqualizerEnabled}" />
        <CheckBox Content="{DynamicResource ui.PlayerOutputPanel.a2018d18ffbc}" IsChecked="{Binding Player.AudioSettings.CrossfeedEnabled}" />
        <Grid ColumnDefinitions="*,280" ColumnSpacing="20"><TextBlock Text="{DynamicResource ui.PlayerOutputPanel.c114a632b201}" FontSize="15" VerticalAlignment="Center" /><NumericUpDown Grid.Column="1" Minimum="0.5" Maximum="2" Increment="0.05" Value="{Binding Player.AudioSettings.PlaybackRate}" /></Grid>
        <Button Classes="primary" Content="{DynamicResource ui.PlayerOutputPanel.a1a42cd9b16e}" Command="{Binding Player.AudioSettings.ApplyCommand}" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding Player.AudioSettings.Message}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Expander>
</UserControl>
