<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icon="using:Echo.Desktop.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SettingsSurface">#a3fafafd</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsHeaderSurface">#b5fafafd</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsBorder">#85e0e1e9</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsDivider">#4de0e1e9</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsSelected">#ccededfa</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsToggleBackground">#eeeef3</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsToggleTrack">#dfe1e9</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsBadge">#f4ead2</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsBadgeText">#80652b</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SettingsSurface">#a3202127</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsHeaderSurface">#b5202127</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsBorder">#8534363f</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsDivider">#4d34363f</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsSelected">#cc2a2c42</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsToggleBackground">#292b34</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsToggleTrack">#454955</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsBadge">#393020</SolidColorBrush>
          <SolidColorBrush x:Key="SettingsBadgeText">#e1c788</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Button.settings-search-result.active"><Setter Property="Background" Value="{DynamicResource SettingsSelected}" /></Style>
  <Style Selector="Button.settings-tab"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,2" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="0,8,0,10" /><Setter Property="FontSize" Value="13.5" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector="Button.settings-tab:pointerover"><Setter Property="Foreground" Value="{DynamicResource EchoText}" /></Style>
  <Style Selector="Button.settings-tab.active"><Setter Property="Foreground" Value="{DynamicResource EchoText}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /></Style>
  <Style Selector="Button.settings-control"><Setter Property="Background" Value="{DynamicResource EchoField}" /><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="Button.settings-choice"><Setter Property="Background" Value="{DynamicResource EchoField}" /><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="Button.settings-choice.selected"><Setter Property="Background" Value="{DynamicResource SettingsSelected}" /><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /></Style>
  <Style Selector="ComboBox.settings-select"><Setter Property="Width" Value="156" /><Setter Property="MinHeight" Value="36" /><Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Background" Value="{DynamicResource EchoField}" /><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}" /><Setter Property="Foreground" Value="{DynamicResource EchoText}" /></Style>
  <Style Selector="ComboBox.settings-select:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="ComboBox.settings-select:disabled /template/ Border#Background"><Setter Property="Background" Value="{DynamicResource EchoField}" /><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}" /></Style>
  <Style Selector="ComboBox.settings-select:disabled /template/ Border#HighlightBackground"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="TextBox.settings-search"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="TextBox.settings-search:focus"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
</Styles>
