<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="using:Echo.Desktop.Theming" xmlns:settings="using:Echo.Desktop.Features.Settings" xmlns:contracts="using:Echo.Contracts.Settings" x:Class="Echo.Desktop.Features.Settings.ThemeSettingsView" x:DataType="theme:ThemeViewModel">
  <UserControl.Styles><StyleInclude Source="/Features/Settings/ThemeEditorStyles.axaml" /></UserControl.Styles>
  <UserControl.Resources><x:Double x:Key="ThemeColorFieldWidth">250</x:Double><x:Double x:Key="ThemeModeWidth">500</x:Double></UserControl.Resources>
  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18" Margin="0,0,0,6" IsVisible="{Binding !IsBackgroundSection}">
      <TextBlock Text="显示模式" FontSize="14" VerticalAlignment="Center" />
      <theme:ThemeChoiceList Grid.Column="1" Classes="theme-choices theme-line-options" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}" AutomationProperties.Name="主题模式" />
    </Grid>
    <Border Height="1" Background="{DynamicResource EchoDivider}" IsVisible="{Binding !IsBackgroundSection}" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,4" IsVisible="{Binding !IsBackgroundSection}">
      <StackPanel Spacing="8">
        <TextBlock Text="当前主题" Classes="theme-caption" />
        <Button Name="OpenPresetButton" Classes="theme-theme-picker" Width="250" HorizontalAlignment="Left" Command="{Binding OpenPresetGalleryCommand}" AutomationProperties.Name="全部主题">
          <Grid ColumnDefinitions="*,14" ColumnSpacing="14"><TextBlock Text="{Binding CurrentThemeLabel}" FontSize="14" TextTrimming="CharacterEllipsis" /><Path Grid.Column="1" Data="M 2,3 L 6,7 L 10,3" Stroke="{DynamicResource EchoMuted}" StrokeThickness="1.5" Width="12" Height="9" VerticalAlignment="Center" /></Grid>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
        <TextBlock Text="编辑配色" Classes="theme-caption" HorizontalAlignment="Right" />
        <theme:ThemeChoiceList Classes="theme-choices theme-line-options" ItemsSource="{Binding Tones}" SelectedItem="{Binding EditTone, Mode=TwoWay}" AutomationProperties.Name="编辑配色" />
      </StackPanel>
      <Popup Name="PresetPopup" PlacementTarget="{Binding #OpenPresetButton}" Placement="Bottom" VerticalOffset="7" IsOpen="{Binding IsPresetGalleryOpen, Mode=TwoWay}" IsLightDismissEnabled="True" ShouldUseOverlayLayer="True">
        <Border Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" CornerRadius="7" Padding="18"><settings:ThemePresetGallery DataContext="{Binding}" /></Border>
      </Popup>
    </Grid>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
      <theme:ThemeChoiceList Classes="theme-choices theme-tabs" ItemsSource="{Binding EditorSections}" SelectedItem="{Binding EditorSection, Mode=TwoWay}" AutomationProperties.Name="主题编辑分类" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="撤销" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Classes="theme-quiet" />
        <Button Content="···" Classes="theme-quiet" ToolTip.Tip="更多主题操作" IsVisible="{Binding !IsBackgroundSection}">
          <Button.Flyout><Flyout><StackPanel Spacing="4"><Button Content="随机配色" Command="{Binding RandomizeCommand}" HorizontalAlignment="Stretch" /><Button Content="恢复默认外观" Command="{Binding ResetAllCommand}" HorizontalAlignment="Stretch" /></StackPanel></Flyout></Button.Flyout>
        </Button>
        <Button Content="保存主题" Command="{Binding SaveCopyCommand}" Classes="theme-save" AutomationProperties.Name="保存当前配色" IsVisible="{Binding !IsBackgroundSection}" />
      </StackPanel>
    </Grid>
    <settings:ThemeColorPalette IsVisible="{Binding IsColorsSection}" />
    <settings:ThemeSurfaceSettings IsVisible="{Binding IsMaterialsSection}" />
    <settings:ThemeBackgroundSettings IsVisible="{Binding IsBackgroundSection}" />
    <StackPanel IsVisible="{Binding IsLibrarySection}" Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBox Classes="theme-input" Text="{Binding Name, Mode=TwoWay}" MaxLength="60" PlaceholderText="为主题命名" AutomationProperties.Name="主题名称" />
        <Button Grid.Column="1" Content="保存为新主题" Command="{Binding SaveCopyCommand}" Classes="theme-action" />
      </Grid>
      <TextBlock Text="保存你喜欢的配色，让浅色与深色成对保留。" Classes="theme-caption" IsVisible="{Binding !HasLibrary}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Library}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="contracts:CustomTheme">
            <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,0,1" Padding="0,8">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="应用" Classes="theme-action" Command="{Binding $parent[UserControl].((theme:ThemeViewModel)DataContext).ApplyCustomCommand}" CommandParameter="{Binding}" />
                <Button Grid.Column="2" Content="改名" Classes="theme-quiet" Command="{Binding $parent[UserControl].((theme:ThemeViewModel)DataContext).RenameCustomCommand}" CommandParameter="{Binding}" ToolTip.Tip="使用上方名称" />
                <Button Grid.Column="3" Content="删除" Classes="theme-quiet" Command="{Binding $parent[UserControl].((theme:ThemeViewModel)DataContext).DeleteCustomCommand}" CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="导入主题" Click="ImportTheme" Classes="theme-action" />
        <Button Content="导出当前主题" Click="ExportTheme" Classes="theme-action" />
      </StackPanel>
    </StackPanel>
    <Border BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,1,0,0" Padding="0,18,0,0" IsVisible="{Binding !IsBackgroundSection}">
      <WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,24,12">
          <ToggleButton Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" AutomationProperties.Name="定时切换" />
          <TextBlock Text="定时切换" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="7" IsEnabled="{Binding ScheduleEnabled}" Margin="0,0,20,12">
          <TextBlock Text="深色" Classes="theme-caption" VerticalAlignment="Center" />
          <TextBox Classes="theme-input" Text="{Binding DarkAt, Mode=TwoWay}" Width="66" MaxLength="5" />
          <TextBlock Text="浅色" Classes="theme-caption" VerticalAlignment="Center" />
          <TextBox Classes="theme-input" Text="{Binding LightAt, Mode=TwoWay}" Width="66" MaxLength="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
          <ToggleButton Theme="{StaticResource ThemeSwitch}" IsChecked="{Binding Invert, Mode=TwoWay}" AutomationProperties.Name="反色模式" />
          <TextBlock Text="反色模式" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <TextBlock Text="{Binding Feedback}" IsVisible="{Binding Feedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource EchoWarning}" FontSize="12" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
