<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="using:Echo.Desktop.Theming" xmlns:settings="using:Echo.Desktop.Features.Settings" x:Class="Echo.Desktop.Features.Settings.ThemeColorPalette" x:DataType="theme:ThemeViewModel">
  <UserControl.Styles><StyleInclude Source="/Features/Settings/ThemeEditorStyles.axaml" /></UserControl.Styles>
  <StackPanel Spacing="14">
    <theme:ThemeChoiceList Classes="theme-choices theme-tabs" ItemsSource="{Binding ColorGroups}" SelectedItem="{Binding ActiveColorGroup, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeColorPalette.978d74d4ab15}">
      <theme:ThemeChoiceList.ItemTemplate><DataTemplate x:DataType="theme:ThemeColorGroup"><TextBlock Text="{Binding ShortTitle}" FontSize="12" /></DataTemplate></theme:ThemeChoiceList.ItemTemplate>
    </theme:ThemeChoiceList>
    <Grid Name="ColorWorkspace" ColumnDefinitions="*,220" ColumnSpacing="32">
      <ListBox Name="ColorList" Classes="theme-color-list" ItemsSource="{Binding ActiveColorGroup.Fields}" SelectedItem="{Binding SelectedColor, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource ui.ThemeColorPalette.1cab851c69fc}">
        <ListBox.ItemTemplate><DataTemplate x:DataType="theme:ThemeColorField">
          <Grid ColumnDefinitions="*,76,24" ColumnSpacing="12">
            <StackPanel Spacing="3"><TextBlock Text="{Binding Label}" FontSize="13" /><TextBlock Text="{Binding Hint}" Classes="theme-caption" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" Foreground="{DynamicResource EchoMuted}" VerticalAlignment="Center" />
            <Border Grid.Column="2" Background="{Binding Swatch}" Width="22" Height="22" CornerRadius="4" BorderBrush="{DynamicResource EchoBorder}" BorderThickness="1" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border Name="InspectorBorder" Grid.Column="1" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="1,0,0,0" Padding="24,0,0,0">
        <ContentControl Content="{Binding SelectedColor}"><ContentControl.ContentTemplate><DataTemplate x:DataType="theme:ThemeColorField"><settings:ThemeColorInspector /></DataTemplate></ContentControl.ContentTemplate></ContentControl>
      </Border>
    </Grid>
    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0"><TextBlock Text="{Binding ContrastStatus}" Classes="theme-caption" VerticalAlignment="Center" TextWrapping="Wrap" /><Button Grid.Column="1" Content="{DynamicResource ui.ThemeColorPalette.85d5efa8c57d}" Command="{Binding ResetToneCommand}" Classes="theme-quiet" /></Grid>
  </StackPanel>
</UserControl>