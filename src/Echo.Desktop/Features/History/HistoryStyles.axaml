<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Echo.Desktop.Features.History">
  <Style Selector="ListBoxItem"><Setter Property="Theme" Value="{StaticResource HistoryItemTheme}" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  <Style Selector="TextBlock.history-column"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource EchoSubtle}" /></Style>
  <Style Selector="Button.history-view-tab"><Setter Property="Padding" Value="0,0,0,13" /><Setter Property="MinHeight" Value="40" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector="Button.history-view-tab.active"><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="BorderThickness" Value="0,0,0,2" /></Style>
  <Style Selector="Button.history-view-tab:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.history-range"><Setter Property="Padding" Value="11,7" /><Setter Property="MinHeight" Value="34" /><Setter Property="CornerRadius" Value="6" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
  <Style Selector="Button.history-range.active"><Setter Property="Background" Value="{DynamicResource EchoPanelMuted}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /></Style>
  <Style Selector="Button.history-tool"><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Background" Value="{DynamicResource EchoField}" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button.history-play"><Setter Property="Padding" Value="18,7" /><Setter Property="MinHeight" Value="34" /><Setter Property="CornerRadius" Value="7" /><Setter Property="FontSize" Value="12" /><Setter Property="Background" Value="{DynamicResource EchoAccent}" /><Setter Property="Foreground" Value="{DynamicResource EchoOnAccent}" /></Style>
  <Style Selector="Button.history-play:disabled"><Setter Property="Background" Value="{DynamicResource EchoPanelMuted}" /><Setter Property="Foreground" Value="{DynamicResource EchoSubtle}" /></Style>
  <Style Selector="TextBox.history-search"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0,9" /><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="34" /></Style>
  <Style Selector="Button.history-clear-search"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="Width" Value="26" /><Setter Property="CornerRadius" Value="5" /></Style>
  <Style Selector="CheckBox.history-counted"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="MinHeight" Value="34" /></Style>
  <Style Selector="Button.history-play TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoOnAccent}" /></Style>
  <Style Selector="Button.history-play:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoSubtle}" /></Style>
</Styles>
