<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:connect="using:Echo.Desktop.Features.Connect" xmlns:local="using:Echo.Desktop.Features.Connect.Receive"
             x:Class="Echo.Desktop.Features.Connect.Receive.ConnectReceiveView" x:DataType="local:ConnectReceiveViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="0,4,8,28" MaxWidth="720" HorizontalAlignment="Left">
      <connect:ConnectServiceCardView DataContext="{Binding Renderer}" />
      <Border Classes="connect-card" IsVisible="{Binding Listening}">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource ui.ConnectReceiveView.345813b7f25e}" Classes="connect-kicker" />
          <TextBox Text="{Binding ListenAddress}" IsReadOnly="True" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="connect-tool" Content="{DynamicResource ui.ConnectReceiveView.4c6de01bbe86}" Click="OnCopyAddress" />
            <Button Classes="connect-tool" Content="{DynamicResource ui.ConnectReceiveView.d357163d70ec}" Command="{Binding StopIncomingCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <connect:ConnectServiceCardView DataContext="{Binding AirPlay}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
