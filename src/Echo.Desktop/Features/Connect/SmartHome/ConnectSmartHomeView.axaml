<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Connect.SmartHome"
             x:Class="Echo.Desktop.Features.Connect.SmartHome.ConnectSmartHomeView" x:DataType="local:ConnectSmartHomeViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="0,4,8,28" MaxWidth="720" HorizontalAlignment="Left">
      <Border Classes="connect-card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="MQTT" Classes="connect-kicker" />
              <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.823acd635ba7}" FontSize="22" Classes="heading" />
            </StackPanel>
            <Border Grid.Column="1" Classes="connect-state" Classes.live="{Binding PortReachable}"><TextBlock Text="{Binding StateLabel}" FontSize="12" /></Border>
          </Grid>
          <Border Classes="connect-inset">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="72,*">
                <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.6320b4a8722a}" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding StateTopic}" FontSize="13" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid ColumnDefinitions="72,*">
                <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.928f87d4507b}" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding CommandTopic}" FontSize="13" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid ColumnDefinitions="72,*">
                <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.997a5e6e513f}" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding LastCommand}" FontSize="13" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.b6198624c2ad}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
          <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.2fb1439352ac}" FontSize="12" Classes="muted" />
              <TextBox Text="{Binding Host, Mode=TwoWay}" MaxLength="253" PlaceholderText="127.0.0.1" LostFocus="OnEdited" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.e71ac32b544b}" FontSize="12" Classes="muted" />
              <TextBox Text="{Binding PortText, Mode=TwoWay}" MaxLength="5" PlaceholderText="1883" LostFocus="OnEdited" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.9857543ab103}" FontSize="12" Classes="muted" />
          <TextBox Text="{Binding Topic, Mode=TwoWay}" MaxLength="80" PlaceholderText="echo/playback" LostFocus="OnEdited" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.311bb313fdec}" FontSize="12" Classes="muted" />
              <TextBox Text="{Binding Username, Mode=TwoWay}" MaxLength="64" PlaceholderText="{DynamicResource ui.ConnectSmartHomeView.293b74110f45}" LostFocus="OnEdited" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="{DynamicResource ui.ConnectSmartHomeView.a621ab606db2}" FontSize="12" Classes="muted" />
              <TextBox Text="{Binding Password, Mode=TwoWay}" MaxLength="128" PasswordChar="•" PlaceholderText="{DynamicResource ui.ConnectSmartHomeView.8bcc3e177f5f}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
          <Button Classes="connect-primary" Content="{Binding ActionLabel}" Command="{Binding TestCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
