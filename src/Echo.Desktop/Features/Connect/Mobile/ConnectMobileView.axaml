<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:connect="using:Echo.Desktop.Features.Connect" xmlns:local="using:Echo.Desktop.Features.Connect.Mobile"
             x:Class="Echo.Desktop.Features.Connect.Mobile.ConnectMobileView" x:DataType="local:ConnectMobileViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="0,4,8,28" MaxWidth="720" HorizontalAlignment="Left">
      <connect:ConnectServiceCardView DataContext="{Binding Card}" />
      <Border Classes="connect-card">
        <StackPanel Spacing="14">
          <TextBlock Text="这一次的配对" Classes="connect-kicker" />
          <Border Classes="connect-code">
            <TextBlock Text="{Binding CodeDisplay}" FontSize="34" FontWeight="SemiBold" LetterSpacing="4" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="地址" Classes="muted" FontSize="12" />
          <TextBox Text="{Binding Address}" IsReadOnly="True" />
          <TextBlock Text="令牌" Classes="muted" FontSize="12" />
          <TextBox Text="{Binding TokenText}" IsReadOnly="True" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="connect-tool" Content="复制地址" Click="OnCopyAddress" Margin="0,0,8,8" />
            <Button Classes="connect-tool" Content="复制配对码" Click="OnCopyCode" Margin="0,0,8,8" />
            <Button Classes="connect-tool" Content="换一个配对码" Command="{Binding RotateCommand}" Margin="0,0,8,8" />
            <Button Classes="connect-tool" Content="显示或隐藏令牌" Command="{Binding RevealCommand}" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
