<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:connect="using:Echo.Desktop.Features.Connect" xmlns:local="using:Echo.Desktop.Features.Connect.Mobile"
             x:Class="Echo.Desktop.Features.Connect.Mobile.ConnectMobileView" x:DataType="local:ConnectMobileViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="0,4,8,28" MaxWidth="720" HorizontalAlignment="Left">
      <connect:ConnectServiceCardView DataContext="{Binding Card}" />
      <Border Classes="connect-card">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource ui.ConnectMobileView.015d281061be}" Classes="connect-kicker" />
          <Border Classes="connect-code">
            <TextBlock Text="{Binding CodeDisplay}" FontSize="34" FontWeight="SemiBold" LetterSpacing="4" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="{DynamicResource ui.ConnectMobileView.37aac5b4e639}" Classes="muted" FontSize="12" />
          <TextBox Text="{Binding Address}" IsReadOnly="True" />
          <TextBlock Text="{DynamicResource ui.ConnectMobileView.735da237b6da}" Classes="muted" FontSize="12" />
          <TextBox Text="{Binding TokenText}" IsReadOnly="True" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="connect-tool" Content="{DynamicResource ui.ConnectMobileView.4c6de01bbe86}" Click="OnCopyAddress" Margin="0,0,8,8" />
            <Button Classes="connect-tool" Content="{DynamicResource ui.ConnectMobileView.43e714e6d1a6}" Click="OnCopyCode" Margin="0,0,8,8" />
            <Button Classes="connect-tool" Content="{DynamicResource ui.ConnectMobileView.3d6881cd1cd3}" Command="{Binding RotateCommand}" Margin="0,0,8,8" />
            <Button Classes="connect-tool" Content="{DynamicResource ui.ConnectMobileView.ebb5d5ea0964}" Command="{Binding RevealCommand}" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
