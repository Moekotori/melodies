<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:folders="using:Echo.Desktop.Features.Folders" xmlns:icon="using:Echo.Desktop.Controls"
             xmlns:library="using:Echo.Contracts.Library" x:Class="Echo.Desktop.Features.Folders.FoldersView" x:DataType="folders:FoldersViewModel">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="/Features/Folders/FolderListStyles.axaml" />
    <ResourceInclude Source="/Features/Folders/FolderToolbarThemes.axaml" />
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <UserControl.Styles><StyleInclude Source="/Features/Folders/FolderPageStyles.axaml" /></UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="24">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Name="BackFolderButton" Classes="icon" Command="{Binding BackFolderCommand}" IsVisible="{Binding HasFolder}" ToolTip.Tip="{DynamicResource folders.previous}"><icon:GlyphIcon Kind="chevron-left" Width="20" Height="20" /></Button>
        <TextBlock IsVisible="{Binding !HasFolder}" Text="{DynamicResource folders.title}" Classes="heading" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" MaxHeight="30" VerticalAlignment="Center" IsVisible="{Binding HasFolder}" Name="BreadcrumbBar">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="folder-breadcrumb" Content="{DynamicResource folders.localLibrary}" Command="{Binding ShowRootsCommand}" FontSize="12" MinHeight="22" Padding="0" />
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="library:FolderRow"><StackPanel Orientation="Horizontal"><icon:GlyphIcon Kind="chevron-right" Width="10" Height="10" Margin="0,0,8,0" Opacity="0.55" /><Button Classes="folder-breadcrumb" Tag="{Binding}" Click="OnBreadcrumb" FontSize="12" MinHeight="22" Padding="0" MaxWidth="120"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></Button></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

      </StackPanel>
      <StackPanel Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Grid Name="FolderSearchBox" ColumnDefinitions="Auto,Auto" ColumnSpacing="6" IsVisible="{Binding HasFolder}">
          <Grid Name="SearchInput" IsVisible="False">
            <TextBox Name="SearchField" Text="{Binding Search, Mode=TwoWay}" MaxLength="128" PlaceholderText="{DynamicResource folders.searchShort}"
                     Height="36" Padding="12,7,32,7" CornerRadius="8" Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource EchoBorder}" KeyDown="OnSearchKey" />
            <Button Content="×" Click="OnClearSearch" Classes="icon" Width="28" Height="32" MinHeight="32" HorizontalAlignment="Right"
                    IsVisible="{Binding Search, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="{DynamicResource folders.clearSearch}" />
          </Grid>
          <ToggleButton Name="SearchToggle" Grid.Column="1" Theme="{StaticResource FolderToolbarToggle}" Width="36" Padding="0" Click="OnToggleSearch"
                        ToolTip.Tip="{DynamicResource folders.searchShort}" AutomationProperties.Name="{DynamicResource folders.searchShort}">
            <icon:GlyphIcon Kind="search" Width="17" Height="17" />
          </ToggleButton>
        </Grid>

        <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="{DynamicResource folders.refresh}"><icon:GlyphIcon Kind="refresh" Width="17" Height="17" /></Button>
        <Button Name="ImportButton" IsVisible="{Binding !HasFolder}" Classes="folder-secondary" Click="OnImport" Padding="12,0">
          <StackPanel Orientation="Horizontal" Spacing="8"><icon:GlyphIcon Kind="plus" Width="15" Height="15" /><TextBlock Text="{DynamicResource folders.import}" FontSize="12" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Name="MainPane" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Border Name="HeroSurface" IsVisible="{Binding HasFolder}" Background="Transparent" BorderThickness="0" Padding="24" Margin="0,0,0,26">
        <Grid Name="Hero" ColumnDefinitions="160,*" ColumnSpacing="28">
          <Grid Name="CoverStack" Width="160" Height="160" VerticalAlignment="Top">
            <Border Background="{DynamicResource EchoPanelMuted}" CornerRadius="10" ClipToBounds="True">
              <Grid><Image Source="{DynamicResource EchoPlaceholderImage}" Stretch="UniformToFill" /><Image Name="CoverFront" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /></Grid>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
            <TextBlock Name="FolderTitle" Text="{Binding Title}" Classes="heading" FontSize="40" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PathLabel}" />
            <TextBlock Text="{Binding HeaderSummary}" Foreground="{DynamicResource EchoMuted}" FontSize="13" TextTrimming="CharacterEllipsis" />
            <WrapPanel Name="ActionBar" Margin="0,10,0,0">
              <Button Classes="primary folder-play" Command="{Binding PlayCommand}" IsEnabled="{Binding CanAct}" Margin="0,0,8,4"><StackPanel Orientation="Horizontal" Spacing="8"><icon:GlyphIcon Kind="play-solid" Stroke="{DynamicResource EchoOnAccent}" Width="14" Height="14" /><TextBlock Text="{DynamicResource folders.playAll}" FontSize="13" /></StackPanel></Button>
              <Button Classes="folder-secondary" Command="{Binding AppendCommand}" IsEnabled="{Binding CanAct}" Margin="0,0,8,4" Padding="12,0"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="queue" Width="16" Height="16" /><TextBlock Text="{DynamicResource folders.append}" FontSize="12" /></StackPanel></Button>
              <Button Classes="folder-secondary" Command="{Binding ShuffleCommand}" IsEnabled="{Binding CanAct}" Width="38" Padding="0" Margin="0,0,0,4" ToolTip.Tip="{DynamicResource folders.shuffle}"><icon:GlyphIcon Kind="shuffle" Width="16" Height="16" /></Button>
            </WrapPanel>
          </StackPanel>
        </Grid>
        </Border>
        <Grid Name="WallPane" Grid.Row="1" RowDefinitions="*,Auto">
          <ContentControl Name="WallHost" />
          <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding Wall.IsLoading}" VerticalAlignment="Top" />
          <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasFolder}">
            <TextBlock Text="{DynamicResource folders.noRoots}" Classes="muted" IsVisible="{Binding Wall.IsEmpty}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" IsVisible="{Binding Wall.ShowPagination}">
            <Button Classes="icon" Command="{Binding Wall.PreviousCommand}" IsEnabled="{Binding Wall.CanPrevious}" ToolTip.Tip="{DynamicResource folders.previous}"><icon:GlyphIcon Kind="chevron-left" Width="15" Height="15" /></Button>
            <TextBlock Text="{Binding Wall.PageText}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
            <Button Classes="icon" Command="{Binding Wall.NextCommand}" IsEnabled="{Binding Wall.CanNext}" ToolTip.Tip="{DynamicResource folders.next}"><icon:GlyphIcon Kind="chevron-right" Width="15" Height="15" /></Button>
          </StackPanel>
        </Grid>
          <Grid Grid.Row="2" Name="FilterBar" IsVisible="{Binding HasFolder}" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12">
            <ToggleButton Name="LosslessToggle" Theme="{StaticResource FolderToolbarToggle}" Grid.Column="1" Content="{DynamicResource folders.lossless}" IsChecked="{Binding LosslessOnly, Mode=TwoWay}" ToolTip.Tip="{Binding Quality}" />
            <ComboBox Grid.Column="2" Name="SortBox" Theme="{StaticResource FolderToolbarChoice}" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" MinWidth="122" AutomationProperties.Name="{DynamicResource query.sort}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="folders:FolderSortChoice"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource EchoMuted}" FontSize="12" VerticalAlignment="Center" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ToggleButton Grid.Column="3" Theme="{StaticResource FolderToolbarToggle}" Width="36" Padding="0" IsChecked="{Binding Descending, Mode=TwoWay}" ToolTip.Tip="{DynamicResource folders.reverse}"><icon:GlyphIcon Kind="arrow-right" Width="15" Height="15" RenderTransformOrigin="50%,50%"><icon:GlyphIcon.RenderTransform><RotateTransform Angle="90" /></icon:GlyphIcon.RenderTransform></icon:GlyphIcon></ToggleButton>
            <Button Grid.Column="4" Classes="icon" ToolTip.Tip="{DynamicResource folders.manage}">
              <icon:GlyphIcon Kind="more" Width="18" Height="18" />
              <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight"><StackPanel Spacing="12">
                <Button Name="FolderPathButton" Content="{DynamicResource folders.open}" Click="OnOpenFolder" IsEnabled="{Binding HasFolder}" />
                <Button Content="{DynamicResource folders.copyPath}" Click="OnCopyPath" IsEnabled="{Binding HasFolder}" />
                <Button Name="RescanButton" Content="{DynamicResource folders.rescan}" Click="OnRescan" IsEnabled="{Binding HasFolder}" />
                <Border Height="1" Background="{DynamicResource EchoDivider}" />
                <CheckBox Content="{DynamicResource folders.recursive}" IsChecked="{Binding Recursive, Mode=TwoWay}" />
                <TextBlock Text="{DynamicResource folders.selectionHint}" Classes="muted" FontSize="12" MaxWidth="240" TextWrapping="Wrap" />
              </StackPanel></Flyout></Button.Flyout>
            </Button>
          </Grid>
        <StackPanel Grid.Row="3" Spacing="8">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource EchoAccentText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{DynamicResource folders.retry}" Command="{Binding RetryCommand}" />
          </Grid>
          <Grid Name="ScanRow" ColumnDefinitions="*,Auto" Margin="0,0,0,8" IsVisible="False"><TextBlock Name="ScanText" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Name="CancelScanButton" Content="{DynamicResource folders.cancel}" Click="OnCancelScan" /></Grid>
        </StackPanel>
        <folders:FolderTrackList Name="TrackPanel" Grid.Row="4" IsVisible="{Binding HasFolder}" />
        <Grid Grid.Row="5" IsVisible="{Binding HasFolder}" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,16">
          <TextBlock Text="{Binding PageText}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" ToolTip.Tip="{DynamicResource folders.previous}"><icon:GlyphIcon Kind="chevron-left" Width="15" Height="15" /></Button>
          <Button Grid.Column="2" Classes="icon" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" ToolTip.Tip="{DynamicResource folders.next}"><icon:GlyphIcon Kind="chevron-right" Width="15" Height="15" /></Button>
        </Grid>
    </Grid>
  </Grid>
</UserControl>
