<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Playlists.PlaylistFavoriteTile">
  <Button Name="OpenButton" Classes="playlist-wall-entry" Click="OnOpen">
    <StackPanel Spacing="12" Margin="0,0,0,28">
      <Border Name="Artwork" Background="{DynamicResource PlaylistCoverBackground0}" CornerRadius="2">
        <icon:GlyphIcon Name="Icon" Width="48" Height="48" Stroke="{DynamicResource PlaylistCoverForeground0}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Spacing="3">
        <TextBlock Name="Title" Classes="heading" FontSize="14" FontWeight="Normal" TextTrimming="CharacterEllipsis" />
        <TextBlock Name="Count" Classes="muted" FontSize="12" />
      </StackPanel>
    </StackPanel>
  </Button>
</UserControl>
