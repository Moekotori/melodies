<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="/Features/Folders/FolderListStyles.axaml" /></ResourceDictionary.MergedDictionaries>
  <ControlTheme x:Key="PlaylistListItem" TargetType="ListBoxItem" BasedOn="{StaticResource FolderListItem}">
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource EchoHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
