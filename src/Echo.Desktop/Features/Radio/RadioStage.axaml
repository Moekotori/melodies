<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Radio" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Radio.RadioStage" x:DataType="local:RadioViewModel"
             Background="{DynamicResource EchoField}">
  <Grid RowDefinitions="Auto,*" Margin="32">
    <Button HorizontalAlignment="Left" Click="OnBack"><StackPanel Orientation="Horizontal" Spacing="8"><icon:GlyphIcon Kind="chevron-left" Width="16" Height="16" /><TextBlock Text="返回全部电台" VerticalAlignment="Center" /></StackPanel></Button>
    <StackPanel Grid.Row="1" MaxWidth="760" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="20">
      <TextBlock Text="{Binding Status}" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding FeatureName}" FontSize="40" Classes="heading" TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Text="{Binding FeatureDescription}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16"><TextBlock Text="NET" Foreground="{DynamicResource EchoAccentText}" VerticalAlignment="Bottom" Margin="0,0,0,16" /><TextBlock Text="{Binding Frequency}" FontSize="84" Classes="heading" FontWeight="Regular" /></StackPanel>
      <local:RadioTunerScale Height="50" Value="{Binding TunerValue}" TickBrush="{DynamicResource EchoSubtle}" AccentBrush="{DynamicResource EchoAccentText}" />
      <Button HorizontalAlignment="Center" Classes="primary" Command="{Binding ListenCommand}" IsEnabled="{Binding CanListen}"><StackPanel Orientation="Horizontal" Spacing="8"><icon:GlyphIcon Kind="{Binding PlayIcon}" Width="17" Height="17" Stroke="{DynamicResource EchoOnAccent}" /><TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" /></StackPanel></Button>
      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource EchoAccentText}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>
</UserControl>
