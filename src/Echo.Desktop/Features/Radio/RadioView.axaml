<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Radio" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Radio.RadioView" x:DataType="local:RadioViewModel"
             Background="{DynamicResource EchoField}">
  <UserControl.Styles>
    <Style Selector="Button.radio-tool"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="CornerRadius" Value="7" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button.radio-tab"><Setter Property="Padding" Value="0,0,0,12" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
    <Style Selector="Button.radio-tab.active"><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="BorderThickness" Value="0,0,0,2" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.radio-tab.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /></Style>
    <Style Selector="TextBox.radio-search"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="CornerRadius" Value="0" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TextBlock.radio-caption"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
  </UserControl.Styles>
  <Grid>
    <Grid Margin="0,0,0,12" RowDefinitions="Auto,Auto,Auto,*,Auto" Name="PageLayout">
      <Grid Name="PageHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Spacing="7"><TextBlock Text="电台" FontSize="{StaticResource EchoPageTitleSize}" Classes="heading" /><TextBlock Text="收藏的声音，随时为你开播。" Classes="muted" FontSize="13" /></StackPanel>
        <StackPanel Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Name="DirectoryButton" Classes="radio-tool" Command="{Binding ToggleDirectoryCommand}" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="search" Width="16" Height="16" /><TextBlock Text="全球电台" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Name="ImportButton" Classes="radio-tool" Click="OnImport" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="download" Width="16" Height="16" RenderTransformOrigin="50%,50%"><icon:GlyphIcon.RenderTransform><RotateTransform Angle="180" /></icon:GlyphIcon.RenderTransform></icon:GlyphIcon><TextBlock Text="导入" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Name="AddButton" Classes="primary radio-tool" Command="{Binding AddCommand}" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="plus" Width="16" Height="16" Stroke="{DynamicResource EchoOnAccent}" /><TextBlock Text="添加电台" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
      </Grid>
      <TextBlock Name="ServiceNote" Grid.Row="1" Margin="0,0,0,18" FontSize="12" LineHeight="20" Classes="muted" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left">
        <Run Text="默认的 " /><Run Text="ECHO Radio" FontWeight="SemiBold" /><Run Text=" 是网络服务。播放时会连接 " /><Run Text="echonext.moe" FontWeight="SemiBold" /><Run Text="，节目由服务端提供，可能变更或中断。删除后不会自动加回。" />
      </TextBlock>
      <Border Name="FeatureCard" Grid.Row="2" Background="{DynamicResource EchoPanelMuted}" CornerRadius="6" Padding="24" Margin="0,0,0,22">
        <Grid Name="FeatureGrid" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="40">
          <StackPanel Name="FeatureCopy" Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,3,0,12"><Ellipse Width="5" Height="5" Fill="{DynamicResource EchoMuted}" VerticalAlignment="Center" /><TextBlock Text="{Binding Status}" FontSize="12" Classes="muted" FontWeight="SemiBold" /></StackPanel>
            <Image Width="64" Height="64" Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,12" />
            <TextBlock Text="{Binding FeatureName}" FontSize="27" Classes="heading" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FeatureDescription}" Classes="muted" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="17" Margin="0,20,0,0">
              <Button Name="ListenButton" Classes="primary radio-tool" Command="{Binding ListenCommand}" IsEnabled="{Binding CanListen}"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="{Binding PlayIcon}" Stroke="{DynamicResource EchoOnAccent}" Width="16" Height="16" /><TextBlock Text="{Binding PlayLabel}" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Name="EnterButton" Classes="content-link" Click="OnEnter" IsEnabled="{Binding CanEnter}" Padding="0"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="进入电台界面" FontSize="12" VerticalAlignment="Center" /><icon:GlyphIcon Kind="arrow-right" Width="13" Height="13" /></StackPanel></Button>
            </StackPanel>
          </StackPanel>
          <StackPanel Name="TunerPanel" Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,0,0,4"><TextBlock Text="NET" Foreground="{DynamicResource EchoAccentText}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,11" /><TextBlock Text="{Binding Frequency}" Classes="heading" FontWeight="Regular" FontSize="52" LineHeight="64" /></StackPanel>
            <local:RadioTunerScale Height="49" Value="{Binding TunerValue}" TickBrush="{DynamicResource EchoSubtle}" AccentBrush="{DynamicResource EchoAccentText}" Opacity="0.85" ToolTip.Tip="网络电台标识，并非无线电频率" />
            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,Auto" Margin="0,8,0,0">
              <TextBlock Text="000" Classes="radio-caption" FontFamily="Consolas" FontSize="10" /><TextBlock Grid.Column="1" Text="125" Classes="radio-caption" FontFamily="Consolas" FontSize="10" /><TextBlock Grid.Column="2" Text="250" Classes="radio-caption" FontFamily="Consolas" FontSize="10" /><TextBlock Grid.Column="3" Text="375" Classes="radio-caption" FontFamily="Consolas" FontSize="10" /><TextBlock Grid.Column="4" Text="500" Classes="radio-caption" FontFamily="Consolas" FontSize="10" /><TextBlock Grid.Column="5" Text="625" Classes="radio-caption" FontFamily="Consolas" FontSize="10" /><TextBlock Grid.Column="6" Text="750" Classes="radio-caption" FontFamily="Consolas" FontSize="10" /><TextBlock Grid.Column="7" Text="875" Classes="radio-caption" FontFamily="Consolas" FontSize="10" /><TextBlock Grid.Column="8" Text="999" Classes="radio-caption" FontFamily="Consolas" FontSize="10" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Name="StationLibrary" RowDefinitions="Auto,Auto,Auto,*">
        <Grid Name="LibraryToolbar" ColumnDefinitions="*,210" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="22">
            <Button Name="AllTab" Classes="radio-tab" Classes.active="{Binding AllSelected}" Command="{Binding ShowAllCommand}"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="全部电台" FontSize="13" /><TextBlock Text="{Binding AllCount}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Name="FavoritesTab" Classes="radio-tab" Classes.active="{Binding FavoritesOnly}" Command="{Binding ShowFavoritesCommand}"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="已收藏" FontSize="12" /><TextBlock Text="{Binding FavoriteCount}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
          </StackPanel>
          <Grid Name="SearchArea" Grid.Column="1" ColumnDefinitions="20,*" VerticalAlignment="Top"><icon:GlyphIcon Kind="search" Width="15" Height="15" VerticalAlignment="Center" /><TextBox Name="SearchField" Grid.Column="1" Classes="radio-search" PlaceholderText="搜索电台" Text="{Binding Search, Mode=TwoWay}" MaxLength="160" /></Grid>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource EchoAccentText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border Grid.Row="2" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,0,1" Padding="0,8,0,12">
          <Grid Name="ColumnHeaders" ColumnDefinitions="44,*,128,104,90,108"><TextBlock Grid.Column="1" Text="电台" Classes="radio-caption" /><TextBlock Name="FrequencyHeader" Grid.Column="2" Text="网络频段" Classes="radio-caption" /><TextBlock Name="GenreHeader" Grid.Column="3" Text="类型" Classes="radio-caption" /><TextBlock Name="CodecHeader" Grid.Column="4" Text="格式" Classes="radio-caption" /></Grid>
        </Border>
        <Grid Grid.Row="3">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsControl Name="StationList" ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RadioStationRowModel"><local:RadioStationRow /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><TextBlock Text="{Binding EmptyTitle}" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="{Binding EmptyHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center" /></StackPanel>
          <ProgressBar IsVisible="{Binding IsBusy}" Height="2" IsIndeterminate="True" VerticalAlignment="Top" />
        </Grid>
      </Grid>
      <Grid Grid.Row="4" Name="StationFooter" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Button Name="ExportButton" Click="OnExport" Padding="0" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="download" Width="14" Height="14" /><TextBlock Text="导出 M3U" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Command="{Binding RequestClearCommand}" Padding="0" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="trash" Width="14" Height="14" /><TextBlock Text="全部删除" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="radio-caption" VerticalAlignment="Center" />
      </Grid>
    </Grid>
    <local:RadioDirectoryPanel Margin="32,96,32,28" IsVisible="{Binding DirectoryOpen}" />
    <local:RadioStage IsVisible="{Binding StageOpen}" />
    <Border IsVisible="{Binding ConfirmClear}" Background="#60000000">
      <Border Background="{DynamicResource EchoField}" Padding="26" CornerRadius="8" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16"><TextBlock Text="删除全部电台？" FontSize="22" Classes="heading" /><TextBlock Text="删除后不会自动加回。你可以先导出 M3U 作为备份。" TextWrapping="Wrap" Classes="muted" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="取消" Command="{Binding CancelClearCommand}" /><Button Content="全部删除" Command="{Binding ClearCommand}" IsEnabled="{Binding !IsBusy}" /></StackPanel></StackPanel></Border>
    </Border>
    <Border IsVisible="{Binding EditorOpen}" Background="#60000000">
      <Border Background="{DynamicResource EchoField}" Padding="26" CornerRadius="8" MaxWidth="460" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <ScrollViewer MaxHeight="600"><StackPanel Spacing="12"><TextBlock Text="电台资料" FontSize="24" Classes="heading" /><TextBlock Text="名称" FontSize="12" Classes="muted" /><TextBox Name="StationNameField" Text="{Binding DraftName, Mode=TwoWay}" MaxLength="160" PlaceholderText="电台名称" /><TextBlock Text="音频流地址" FontSize="12" Classes="muted" /><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding DraftUrl, Mode=TwoWay}" MaxLength="2048" PlaceholderText="https://…" /><Button Grid.Column="1" Margin="8,0,0,0" Content="探测" Command="{Binding ProbeCommand}" IsEnabled="{Binding !IsProbing}" /></Grid><TextBlock Text="{Binding ProbeSummary}" Classes="muted" FontSize="12" IsVisible="{Binding ProbeSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" /><TextBlock Text="简介" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftDescription, Mode=TwoWay}" MaxLength="512" /><TextBlock Text="封面地址" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftCover, Mode=TwoWay}" MaxLength="2048" PlaceholderText="https://…" /><TextBlock Text="视频地址" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftVideo, Mode=TwoWay}" MaxLength="2048" PlaceholderText="https://…" /><TextBlock Text="主页" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftHomepage, Mode=TwoWay}" MaxLength="2048" PlaceholderText="https://…" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="6"><TextBlock Text="类型" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftGenre, Mode=TwoWay}" MaxLength="80" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="格式" FontSize="12" Classes="muted" /><ComboBox SelectedItem="{Binding DraftCodec, Mode=TwoWay}" ItemsSource="{Binding $parent[local:RadioView].Codecs}" HorizontalAlignment="Stretch" /></StackPanel></Grid><TextBlock Text="{Binding EditorError}" TextWrapping="Wrap" Foreground="{DynamicResource EchoAccentText}" IsVisible="{Binding EditorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0"><Button Content="从剪贴板播放" Click="OnPaste" IsEnabled="{Binding !IsBusy}" /><Button Content="取消" Command="{Binding CloseEditorCommand}" IsEnabled="{Binding !IsBusy}" /><Button Name="SaveStationButton" Content="保存电台" Classes="primary" Command="{Binding SaveEditorCommand}" IsEnabled="{Binding !IsBusy}" /></StackPanel></StackPanel></ScrollViewer>
      </Border>
    </Border>
  </Grid>
</UserControl>
