<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Radio" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Radio.RadioView" x:DataType="local:RadioViewModel"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Button.radio-tool"><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="CornerRadius" Value="7" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button.radio-tab"><Setter Property="Padding" Value="0,0,0,12" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
    <Style Selector="Button.radio-tab.active"><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="BorderThickness" Value="0,0,0,2" /><Setter Property="FontWeight" Value="Medium" /></Style>
    <Style Selector="Button.radio-tab.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /></Style>
    <Style Selector="TextBox.radio-search"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource EchoDivider}" /><Setter Property="CornerRadius" Value="0" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TextBlock.radio-caption"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /></Style>
  </UserControl.Styles>
  <Grid>
    <Grid Margin="0,0,0,12" RowDefinitions="Auto,Auto,Auto,*,Auto" Name="PageLayout">
      <Grid Name="PageHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Spacing="7"><TextBlock Text="{DynamicResource ui.RadioView.a2a3e869226b}" Classes="page-title" /><TextBlock Text="{DynamicResource ui.RadioView.f752ffc70fda}" Classes="muted" FontSize="13" /></StackPanel>
        <StackPanel Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Name="DirectoryButton" Classes="radio-tool" Command="{Binding ToggleDirectoryCommand}" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="search" Width="16" Height="16" /><TextBlock Text="{DynamicResource ui.RadioView.4c3d22499c74}" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Name="ImportButton" Classes="radio-tool" Click="OnImport" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="download" Width="16" Height="16" RenderTransformOrigin="50%,50%"><icon:GlyphIcon.RenderTransform><RotateTransform Angle="180" /></icon:GlyphIcon.RenderTransform></icon:GlyphIcon><TextBlock Text="{DynamicResource ui.RadioView.576d81bb0631}" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Name="AddButton" Classes="primary radio-tool" Command="{Binding AddCommand}" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="plus" Width="16" Height="16" Stroke="{DynamicResource EchoOnAccent}" /><TextBlock Text="{DynamicResource ui.RadioView.fb0ca183494e}" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
      </Grid>
      <TextBlock Name="ServiceNote" Grid.Row="1" Margin="0,0,0,18" FontSize="12" LineHeight="20" Classes="muted" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left">
        <Run Text="默认的 " /><Run Text="ECHO Radio" FontWeight="SemiBold" /><Run Text=" 是网络服务。播放时会连接 " /><Run Text="echonext.moe" FontWeight="SemiBold" /><Run Text="，节目由服务端提供，可能变更或中断。删除后不会自动加回。" />
      </TextBlock>
      <Border Name="FeatureCard" Classes="page-feature" Grid.Row="2" Padding="24" Margin="0,0,0,22">
        <Grid Name="FeatureGrid" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="40">
          <StackPanel Name="FeatureCopy" Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,3,0,12"><Ellipse Width="5" Height="5" Fill="{DynamicResource EchoMuted}" VerticalAlignment="Center" /><TextBlock Text="{Binding Status}" FontSize="12" Classes="muted" FontWeight="Medium" /></StackPanel>
            <Image Width="64" Height="64" Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,12" />
            <TextBlock Text="{Binding FeatureName}" FontSize="27" Classes="heading" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FeatureDescription}" Classes="muted" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="17" Margin="0,20,0,0">
              <Button Name="ListenButton" Classes="primary radio-tool" Command="{Binding ListenCommand}" IsEnabled="{Binding CanListen}"><StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="{Binding PlayIcon}" Stroke="{DynamicResource EchoOnAccent}" Width="16" Height="16" /><TextBlock Text="{Binding PlayLabel}" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Name="EnterButton" Classes="content-link" Click="OnEnter" IsEnabled="{Binding CanEnter}" Padding="0"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{DynamicResource ui.RadioView.fd6aab7fcee3}" FontSize="12" VerticalAlignment="Center" /><icon:GlyphIcon Kind="arrow-right" Width="13" Height="13" /></StackPanel></Button>
            </StackPanel>
          </StackPanel>
          <StackPanel Name="TunerPanel" Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,0,0,4"><TextBlock Text="NET" Foreground="{DynamicResource EchoAccentText}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,11" /><TextBlock Text="{Binding Frequency}" Classes="heading" FontWeight="Regular" FontSize="52" LineHeight="64" /></StackPanel>
            <local:RadioTunerScale Height="49" Value="{Binding TunerValue}" TickBrush="{DynamicResource EchoSubtle}" AccentBrush="{DynamicResource EchoAccentText}" Opacity="0.85" ToolTip.Tip="{DynamicResource ui.RadioView.8ffe58829b9b}" />
            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,Auto" Margin="0,8,0,0">
              <TextBlock Text="000" Classes="radio-caption" FontFamily="Consolas" FontSize="12" /><TextBlock Grid.Column="1" Text="125" Classes="radio-caption" FontFamily="Consolas" FontSize="12" /><TextBlock Grid.Column="2" Text="250" Classes="radio-caption" FontFamily="Consolas" FontSize="12" /><TextBlock Grid.Column="3" Text="375" Classes="radio-caption" FontFamily="Consolas" FontSize="12" /><TextBlock Grid.Column="4" Text="500" Classes="radio-caption" FontFamily="Consolas" FontSize="12" /><TextBlock Grid.Column="5" Text="625" Classes="radio-caption" FontFamily="Consolas" FontSize="12" /><TextBlock Grid.Column="6" Text="750" Classes="radio-caption" FontFamily="Consolas" FontSize="12" /><TextBlock Grid.Column="7" Text="875" Classes="radio-caption" FontFamily="Consolas" FontSize="12" /><TextBlock Grid.Column="8" Text="999" Classes="radio-caption" FontFamily="Consolas" FontSize="12" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Name="StationLibrary" RowDefinitions="Auto,Auto,Auto,*">
        <Grid Name="LibraryToolbar" ColumnDefinitions="*,210" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="22">
            <Button Name="AllTab" Classes="radio-tab" Classes.active="{Binding AllSelected}" Command="{Binding ShowAllCommand}"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{DynamicResource ui.RadioView.c937b67195ae}" FontSize="13" /><TextBlock Text="{Binding AllCount}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Name="FavoritesTab" Classes="radio-tab" Classes.active="{Binding FavoritesOnly}" Command="{Binding ShowFavoritesCommand}"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{DynamicResource ui.RadioView.471dd4d7f869}" FontSize="12" /><TextBlock Text="{Binding FavoriteCount}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
          </StackPanel>
          <Grid Name="SearchArea" Grid.Column="1" ColumnDefinitions="20,*" VerticalAlignment="Top"><icon:GlyphIcon Kind="search" Width="15" Height="15" VerticalAlignment="Center" /><TextBox Name="SearchField" Grid.Column="1" Classes="radio-search" PlaceholderText="{DynamicResource ui.RadioView.55f30580ab3c}" Text="{Binding Search, Mode=TwoWay}" MaxLength="160" /></Grid>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource EchoAccentText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border Grid.Row="2" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,0,1" Padding="0,8,0,12">
          <Grid Name="ColumnHeaders" ColumnDefinitions="44,*,128,104,90,108"><TextBlock Grid.Column="1" Text="{DynamicResource ui.RadioView.a2a3e869226b}" Classes="radio-caption" /><TextBlock Name="FrequencyHeader" Grid.Column="2" Text="{DynamicResource ui.RadioView.4f9a9cf2a55b}" Classes="radio-caption" /><TextBlock Name="GenreHeader" Grid.Column="3" Text="{DynamicResource ui.RadioView.ba40014ff496}" Classes="radio-caption" /><TextBlock Name="CodecHeader" Grid.Column="4" Text="{DynamicResource ui.RadioView.0e8b1c78c5f3}" Classes="radio-caption" /></Grid>
        </Border>
        <Grid Grid.Row="3">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsControl Name="StationList" ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RadioStationRowModel"><local:RadioStationRow /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <StackPanel Classes="reveal" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><TextBlock Text="{Binding EmptyTitle}" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="{Binding EmptyHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center" /></StackPanel>
          <ProgressBar IsVisible="{Binding IsBusy}" Height="2" IsIndeterminate="True" VerticalAlignment="Top" />
        </Grid>
      </Grid>
      <Grid Grid.Row="4" Name="StationFooter" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Button Name="ExportButton" Click="OnExport" Padding="0" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="download" Width="14" Height="14" /><TextBlock Text="{DynamicResource ui.RadioView.2600128fb060}" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Command="{Binding RequestClearCommand}" Padding="0" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="6"><icon:GlyphIcon Kind="trash" Width="14" Height="14" /><TextBlock Text="{DynamicResource ui.RadioView.9b2ccbb48e31}" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="radio-caption" VerticalAlignment="Center" />
      </Grid>
    </Grid>
    <local:RadioDirectoryPanel Name="DirectoryPanel" Margin="32,96,32,28" IsVisible="{Binding DirectoryOpen}" />
    <local:RadioStage IsVisible="{Binding StageOpen}" />
    <Border IsVisible="{Binding ConfirmClear}" Background="#60000000">
      <Border Background="{DynamicResource EchoField}" Padding="26" CornerRadius="8" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource ui.RadioView.5a8e8baf9630}" FontSize="22" Classes="heading" /><TextBlock Text="{DynamicResource ui.RadioView.b93078de9964}" TextWrapping="Wrap" Classes="muted" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="{DynamicResource ui.RadioView.2cd0f3be8738}" Command="{Binding CancelClearCommand}" /><Button Content="{DynamicResource ui.RadioView.9b2ccbb48e31}" Command="{Binding ClearCommand}" IsEnabled="{Binding !IsBusy}" /></StackPanel></StackPanel></Border>
    </Border>
    <Border IsVisible="{Binding EditorOpen}" Background="#60000000">
      <Border Background="{DynamicResource EchoField}" Padding="26" CornerRadius="8" MaxWidth="460" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <ScrollViewer MaxHeight="600"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource ui.RadioView.af63c1f5a275}" FontSize="24" Classes="heading" /><TextBlock Text="{DynamicResource ui.RadioView.d44e9b3d3b31}" FontSize="12" Classes="muted" /><TextBox Name="StationNameField" Text="{Binding DraftName, Mode=TwoWay}" MaxLength="160" PlaceholderText="{DynamicResource ui.RadioView.267eaf6f0cd5}" /><TextBlock Text="{DynamicResource ui.RadioView.a812dfd8f05d}" FontSize="12" Classes="muted" /><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding DraftUrl, Mode=TwoWay}" MaxLength="2048" PlaceholderText="https://…" /><Button Grid.Column="1" Margin="8,0,0,0" Content="{DynamicResource ui.RadioView.a4bb0b667f00}" Command="{Binding ProbeCommand}" IsEnabled="{Binding !IsProbing}" /></Grid><TextBlock Text="{Binding ProbeSummary}" Classes="muted" FontSize="12" IsVisible="{Binding ProbeSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" /><TextBlock Text="{DynamicResource ui.RadioView.8131eafd0239}" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftDescription, Mode=TwoWay}" MaxLength="512" /><TextBlock Text="{DynamicResource ui.RadioView.ca6844ca55f8}" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftCover, Mode=TwoWay}" MaxLength="2048" PlaceholderText="https://…" /><TextBlock Text="{DynamicResource ui.RadioView.2e6b4fbdbc05}" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftVideo, Mode=TwoWay}" MaxLength="2048" PlaceholderText="https://…" /><TextBlock Text="{DynamicResource ui.RadioView.3e0d676d2d85}" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftHomepage, Mode=TwoWay}" MaxLength="2048" PlaceholderText="https://…" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="6"><TextBlock Text="{DynamicResource ui.RadioView.ba40014ff496}" FontSize="12" Classes="muted" /><TextBox Text="{Binding DraftGenre, Mode=TwoWay}" MaxLength="80" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{DynamicResource ui.RadioView.0e8b1c78c5f3}" FontSize="12" Classes="muted" /><ComboBox SelectedItem="{Binding DraftCodec, Mode=TwoWay}" ItemsSource="{Binding $parent[local:RadioView].Codecs}" HorizontalAlignment="Stretch" /></StackPanel></Grid><TextBlock Text="{Binding EditorError}" TextWrapping="Wrap" Foreground="{DynamicResource EchoAccentText}" IsVisible="{Binding EditorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0"><Button Content="{DynamicResource ui.RadioView.27dda79ed0f3}" Click="OnPaste" IsEnabled="{Binding !IsBusy}" /><Button Content="{DynamicResource ui.RadioView.2cd0f3be8738}" Command="{Binding CloseEditorCommand}" IsEnabled="{Binding !IsBusy}" /><Button Name="SaveStationButton" Content="{DynamicResource ui.RadioView.9a3fb2f794bb}" Classes="primary" Command="{Binding SaveEditorCommand}" IsEnabled="{Binding !IsBusy}" /></StackPanel></StackPanel></ScrollViewer>
      </Border>
    </Border>
  </Grid>
</UserControl>
