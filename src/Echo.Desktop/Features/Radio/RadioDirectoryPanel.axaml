<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echo.Desktop.Features.Radio" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Radio.RadioDirectoryPanel" x:DataType="local:RadioViewModel">
  <Border Background="{DynamicResource EchoPanelMuted}" CornerRadius="6" Padding="20">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <TextBlock Text="{DynamicResource ui.RadioDirectoryPanel.4c3d22499c74}" FontSize="20" Classes="heading" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding Directory.CloseCommand}" ToolTip.Tip="{DynamicResource ui.RadioDirectoryPanel.368c899b7c4f}"><icon:GlyphIcon Kind="close" Width="16" Height="16" /></Button>
      </Grid>
      <TextBlock DockPanel.Dock="Top" Text="{DynamicResource ui.RadioDirectoryPanel.708649776b4c}" TextWrapping="Wrap" Classes="muted" FontSize="12" Margin="0,0,0,14" />
      <Grid Name="Filters" DockPanel.Dock="Top" ColumnDefinitions="2*,*,*,*,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,0,0,12">
        <TextBox Name="NameFilter" Text="{Binding Directory.QueryName}" PlaceholderText="{DynamicResource ui.RadioDirectoryPanel.267eaf6f0cd5}" MaxLength="128" />
        <TextBox Name="CountryFilter" Grid.Column="1" Text="{Binding Directory.QueryCountry}" PlaceholderText="{DynamicResource ui.RadioDirectoryPanel.71ea33b29571}" MaxLength="2" />
        <TextBox Name="LanguageFilter" Grid.Column="2" Text="{Binding Directory.QueryLanguage}" PlaceholderText="{DynamicResource ui.RadioDirectoryPanel.9f6fee1aba17}" MaxLength="64" />
        <TextBox Name="TagFilter" Grid.Column="3" Text="{Binding Directory.QueryTag}" PlaceholderText="{DynamicResource ui.RadioDirectoryPanel.ba40014ff496}" MaxLength="64" />
        <Button Name="SearchButton" Grid.Column="4" Classes="primary" Command="{Binding Directory.SearchCommand}" IsEnabled="{Binding !Directory.Loading}" Content="{DynamicResource ui.RadioDirectoryPanel.44ce7ae909bb}" />
      </Grid>
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0" IsVisible="{Binding Directory.PageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Button Name="PreviousButton" Classes="icon" Command="{Binding Directory.PreviousCommand}" IsEnabled="{Binding Directory.CanPrevious}" ToolTip.Tip="{DynamicResource ui.RadioDirectoryPanel.c9b9ae7a6144}"><icon:GlyphIcon Kind="chevron-left" Width="16" Height="16" /></Button>
        <TextBlock Grid.Column="1" Text="{Binding Directory.PageText}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" FontSize="12" />
        <Button Name="NextButton" Grid.Column="2" Classes="icon" Command="{Binding Directory.NextCommand}" IsEnabled="{Binding Directory.CanNext}" ToolTip.Tip="{DynamicResource ui.RadioDirectoryPanel.8a8542f69648}"><icon:GlyphIcon Kind="chevron-right" Width="16" Height="16" /></Button>
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Directory.LimitMessage}" Foreground="{DynamicResource EchoAccentText}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Directory.LimitMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Grid>
        <TextBlock Text="{Binding Directory.Status}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Directory.HasResults}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Directory.Results}" IsEnabled="{Binding !Directory.Playing}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:RadioDirectoryRow">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MinHeight="56" Margin="0,0,0,8">
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1" Name="ListenResultButton" Classes="icon" Click="OnPlay" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource ui.RadioStationRow.b9788942be1d}"><icon:GlyphIcon Kind="play" Width="18" Height="18" /></Button>
                  <Button Grid.Column="2" Name="SaveResultButton" Content="{Binding Action}" IsEnabled="{Binding !Saved}" Click="OnAdd" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
