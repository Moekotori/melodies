<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="using:Echo.Desktop.Controls" x:Class="Echo.Desktop.Features.Albums.AlbumCard">
  <UserControl.Styles>
    <Style Selector="Button.album-card"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Top" /></Style>
    <Style Selector="Button.album-card:pointerover TextBlock.album-title"><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /></Style>
    <Style Selector="Button.album-card:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource EchoAccent}" /><Setter Property="BorderThickness" Value="1" /></Style>
  </UserControl.Styles>
  <Button Name="OpenButton" Classes="album-card" Click="OnOpen">
    <StackPanel Spacing="12">
      <Border Name="CoverFrame" Background="{DynamicResource EchoPanelMuted}" CornerRadius="{DynamicResource EchoCoverRadius}" ClipToBounds="True">
        <Grid>
          <Image Source="{DynamicResource EchoPlaceholderImage}" Stretch="UniformToFill" />
          <Image Name="Cover" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Grid>
      </Border>
      <StackPanel Spacing="5">
        <TextBlock Name="AlbumTitle" Classes="album-title" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource EchoHeading}" TextTrimming="CharacterEllipsis" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Name="Artist" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
          <TextBlock Name="TrackCount" Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Button>
</UserControl>
