<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:albums="using:Echo.Desktop.Features.Albums" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Albums.AlbumSortControl" x:DataType="albums:AlbumsViewModel">
  <Button Name="SortButton" Classes="libraryTool" AutomationProperties.Name="{DynamicResource query.sort}">
    <StackPanel Orientation="Horizontal" Spacing="8"><icon:GlyphIcon Kind="sort" Width="17" Height="17" /><TextBlock Text="{Binding SortLabel}" /><icon:GlyphIcon Kind="chevron-down" Width="12" Height="12" Stroke="{DynamicResource EchoMuted}" /></StackPanel>
    <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource LibraryPopupPresenter}">
      <ScrollViewer MaxHeight="410" Width="252" HorizontalScrollBarVisibility="Disabled" IsScrollChainingEnabled="False">
        <ItemsControl ItemsSource="{Binding SortOptions}" Margin="0,0,4,3">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="albums:AlbumSortOption">
            <StackPanel>
              <Border Height="1" Background="{DynamicResource EchoDivider}" Margin="6,8,6,2" IsVisible="{Binding HasSeparator}" />
              <TextBlock Text="{Binding Label}" Classes="libraryGroup" IsVisible="{Binding IsHeader}" />
              <Grid ColumnDefinitions="*,28" ColumnSpacing="3" IsVisible="{Binding !IsHeader}">
                <Button Classes="libraryOption" Classes.selected="{Binding IsSelected}" Click="OnSelect">
                  <Grid ColumnDefinitions="*,14" ColumnSpacing="8"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /><icon:GlyphIcon Grid.Column="1" Kind="check" Width="14" Height="14" IsVisible="{Binding IsSelected}" Stroke="{DynamicResource EchoAccent}" /></Grid>
                </Button>
                <Button Grid.Column="1" Classes="libraryDirection" IsVisible="{Binding CanDirection}" Click="OnDirection" ToolTip.Tip="{DynamicResource query.reverseDirection}" AutomationProperties.Name="{DynamicResource query.reverseDirection}"><icon:SortDirectionIcon Width="12" Height="14" Descending="{Binding Descending}" IsActive="{Binding IsSelected}" ActiveBrush="{DynamicResource EchoAccent}" IdleBrush="{DynamicResource EchoMuted}" /></Button>
              </Grid>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Flyout></Button.Flyout>
  </Button>
</UserControl>
