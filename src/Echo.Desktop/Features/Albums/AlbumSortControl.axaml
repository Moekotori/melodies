<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:albums="using:Echo.Desktop.Features.Albums" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Albums.AlbumSortControl" x:DataType="albums:AlbumsViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Features/Albums/AlbumSortStyles.axaml" />
  </UserControl.Styles>
  <Button Name="SortButton" Classes="libraryTool" AutomationProperties.Name="{DynamicResource query.sort}">
    <StackPanel Orientation="Horizontal" Spacing="8"><icon:GlyphIcon Kind="sort" Width="17" Height="17" /><TextBlock Text="{Binding SortLabel}" /><icon:GlyphIcon Kind="chevron-down" Width="12" Height="12" Stroke="{DynamicResource EchoMuted}" /></StackPanel>
    <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource LibraryQuerySortPresenter}">
      <ScrollViewer MaxHeight="520" Width="256" HorizontalScrollBarVisibility="Disabled" IsScrollChainingEnabled="False">
        <ItemsControl ItemsSource="{Binding SortOptions}" Margin="0,0,0,4">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="albums:AlbumSortOption">
            <StackPanel>
              <TextBlock Text="{Binding Label}" Classes="albumSortGroup" IsVisible="{Binding IsHeader}" />
              <Border Classes="albumSortRow" Classes.selected="{Binding IsSelected}" IsVisible="{Binding !IsHeader}">
                <Grid ColumnDefinitions="*,31">
                  <Button Grid.ColumnSpan="2" Classes="libraryOption" Classes.selected="{Binding IsSelected}" Click="OnSelect">
                    <Grid ColumnDefinitions="14,*" ColumnSpacing="9" Margin="0,0,28,0">
                      <icon:GlyphIcon Kind="check" Width="13" Height="13" IsVisible="{Binding IsSelected}" Stroke="{DynamicResource EchoAccentText}" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Classes="libraryDirection" IsVisible="{Binding CanDirection}" Click="OnDirection" ToolTip.Tip="{DynamicResource query.reverseDirection}" AutomationProperties.Name="{DynamicResource query.reverseDirection}">
                    <icon:SortDirectionIcon Width="11" Height="13" Descending="{Binding Descending}" IsActive="{Binding IsSelected}" ActiveBrush="{DynamicResource EchoAccentText}" IdleBrush="{DynamicResource EchoMuted}" />
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Flyout></Button.Flyout>
  </Button>
</UserControl>
