<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:albums="using:Echo.Desktop.Features.Albums" xmlns:icon="using:Echo.Desktop.Controls"
             xmlns:details="using:Echo.Desktop.Features.LibraryDetails"
             x:Class="Echo.Desktop.Features.Albums.AlbumDetailView" x:DataType="albums:AlbumDetailViewModel">
  <UserControl.Styles>
    <Style Selector="Button.cover-hit"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.cover-hit:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.album-back"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /></Style>
    <Style Selector="Button.album-back:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.album-back:pointerover TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /></Style>
    <Style Selector="Button.album-back:pointerover icon|GlyphIcon"><Setter Property="Stroke" Value="{DynamicResource EchoHeading}" /></Style>
    <Style Selector="Button.artist-link"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="FontWeight" Value="Medium" /></Style>
    <Style Selector="Button.artist-link:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.artist-link:pointerover TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /><Setter Property="TextDecorations" Value="Underline" /></Style>
    <Style Selector="Button.genre-link"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /></Style>
    <Style Selector="Button.genre-link:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.genre-link:pointerover TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoAccentText}" /><Setter Property="TextDecorations" Value="Underline" /></Style>
    <Style Selector="Button.detail-tab"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0,0,0,11" /><Setter Property="MinHeight" Value="0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.detail-tab:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.detail-tab.active"><Setter Property="Foreground" Value="{DynamicResource EchoText}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="BorderBrush" Value="{DynamicResource EchoAccentText}" /></Style>
    <Style Selector="Button.album-play"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="Background" Value="{DynamicResource EchoAccent}" /><Setter Property="Foreground" Value="{DynamicResource EchoOnAccent}" /><Setter Property="Height" Value="40" /><Setter Property="MinHeight" Value="40" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,0,18,0" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.album-play TextBlock"><Setter Property="Foreground" Value="{DynamicResource EchoOnAccent}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" /></Style>
    <Style Selector="Button.album-play:pointerover"><Setter Property="Background" Value="{DynamicResource EchoAccent}" /><Setter Property="Opacity" Value="0.92" /></Style>
    <Style Selector="Button.album-play:disabled"><Setter Property="Opacity" Value="0.56" /></Style>
    <Style Selector="Button.album-icon"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="20" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.album-icon:pointerover"><Setter Property="Background" Value="{DynamicResource EchoHover}" /></Style>
    <Style Selector="Button.album-liked icon|GlyphIcon"><Setter Property="Stroke" Value="{DynamicResource EchoDanger}" /></Style>
    <Style Selector="Button.rate"><Setter Property="Theme" Value="{StaticResource EchoButtonTheme}" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="MinHeight" Value="22" /><Setter Property="CornerRadius" Value="11" /></Style>
    <Style Selector="Button.rate:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.rate.selected icon|GlyphIcon"><Setter Property="Stroke" Value="{DynamicResource EchoAccentText}" /></Style>
    <Style Selector="Button.menu-item"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="8,0" /><Setter Property="MinHeight" Value="34" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="Button.load-more"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="16,0" /><Setter Property="CornerRadius" Value="999" /></Style>
    <Style Selector="TextBlock.fact-label"><Setter Property="Foreground" Value="{DynamicResource EchoMuted}" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /></Style>
    <Style Selector="TextBlock.fact-value"><Setter Property="Foreground" Value="{DynamicResource EchoHeading}" /><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></ControlTemplate></Setter></Style>
  </UserControl.Styles>
  <Grid>
  <ScrollViewer Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
  <Grid Name="PageContent" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18" MaxWidth="1600" HorizontalAlignment="Stretch" Margin="0,0,0,18">
    <Button Classes="content-link album-back" Click="OnBack" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" ZIndex="1" AutomationProperties.Name="{DynamicResource album.detail.back}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <icon:GlyphIcon Kind="chevron-left" Width="18" Height="18" Stroke="{DynamicResource EchoMuted}" />
        <TextBlock Text="{DynamicResource album.detail.back}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource EchoMuted}" />
      </StackPanel>
    </Button>
    <Grid Name="Hero" Grid.Row="0" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="320,*,240" ColumnSpacing="48" RowSpacing="18" Margin="0,34,0,0" HorizontalAlignment="Stretch">
      <Button Name="CoverButton" Classes="cover-hit" Click="OnPreviewCover" IsEnabled="False" Padding="0" CornerRadius="8" VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="Hand" ToolTip.Tip="{DynamicResource detail.cover.preview}" AutomationProperties.Name="{DynamicResource detail.cover.preview}">
        <Border Name="CoverFrame" Width="320" Height="320" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource EchoPanelMuted}" BorderThickness="0">
          <Grid><icon:GlyphIcon Name="CoverPlaceholder" Kind="disc" Width="58" Height="58" Stroke="{DynamicResource EchoSubtle}" StrokeWidth="1.25" /><Image Name="Cover" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /></Grid>
        </Border>
      </Button>
      <StackPanel Name="Console" Grid.Column="1" Spacing="24" VerticalAlignment="Top">
        <StackPanel Name="Copy" Spacing="14">
          <TextBlock Text="{DynamicResource album.detail.kicker}" Classes="muted" FontSize="13" FontWeight="Medium" LetterSpacing="1.6" />
          <TextBlock Name="AlbumTitle" Text="{Binding Album.Title}" ToolTip.Tip="{Binding Album.Title}" Foreground="{DynamicResource EchoHeading}" FontSize="44" FontWeight="Medium" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
          <Button Name="ArtistLink" Classes="artist-link" Click="OnArtist" HorizontalAlignment="Left" HorizontalContentAlignment="Left" FontSize="22" ToolTip.Tip="{DynamicResource ui.AlbumDetailView.5cec7079b8ac}">
            <TextBlock Name="ArtistLabel" Text="{Binding Album.Artist}" Foreground="{DynamicResource EchoText}" FontSize="22" FontWeight="Medium" TextWrapping="Wrap" />
          </Button>
          <WrapPanel Name="MetaLine" Orientation="Horizontal">
            <StackPanel Name="RatingChip" Orientation="Horizontal" Spacing="6" Margin="0,0,0,9" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource album.detail.rating}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="2" IsEnabled="{Binding CanPersonalState}">
                <Button Name="Rate1" Classes="rate" Tag="1" Click="OnRating"><icon:GlyphIcon Kind="star" Width="16" Height="16" StrokeWidth="1.5" /></Button>
                <Button Name="Rate2" Classes="rate" Tag="2" Click="OnRating"><icon:GlyphIcon Kind="star" Width="16" Height="16" StrokeWidth="1.5" /></Button>
                <Button Name="Rate3" Classes="rate" Tag="3" Click="OnRating"><icon:GlyphIcon Kind="star" Width="16" Height="16" StrokeWidth="1.5" /></Button>
                <Button Name="Rate4" Classes="rate" Tag="4" Click="OnRating"><icon:GlyphIcon Kind="star" Width="16" Height="16" StrokeWidth="1.5" /></Button>
                <Button Name="Rate5" Classes="rate" Tag="5" Click="OnRating"><icon:GlyphIcon Kind="star" Width="16" Height="16" StrokeWidth="1.5" /></Button>
              </StackPanel>
            </StackPanel>
          </WrapPanel>
        </StackPanel>
        <StackPanel Name="Actions" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsBusy}">
          <Button Name="PlayButton" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" Classes="album-play">
            <StackPanel Orientation="Horizontal" Spacing="8"><icon:GlyphIcon Kind="play" Width="15" Height="15" Stroke="{DynamicResource EchoOnAccent}" /><TextBlock Text="{DynamicResource album.detail.play}" /></StackPanel>
          </Button>
          <Button Name="AlbumFavoriteButton" Classes="icon album-icon" Classes.album-liked="{Binding Favorite}" Command="{Binding ToggleFavoriteCommand}" IsEnabled="{Binding CanPersonalState}" ToolTip.Tip="{Binding FavoriteAction}" AutomationProperties.Name="{Binding FavoriteAction}"><icon:GlyphIcon Kind="{Binding HeartIcon}" Width="20" Height="20" StrokeWidth="1.75" /></Button>
          <Button Name="MoreButton" Classes="icon album-icon" ToolTip.Tip="{DynamicResource ui.AlbumDetailView.9f07d2ce4115}" AutomationProperties.Name="{DynamicResource ui.AlbumDetailView.9f07d2ce4115}">
            <icon:GlyphIcon Kind="more" Width="20" Height="20" />
            <Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><Grid ColumnDefinitions="200,Auto" Margin="4" ColumnSpacing="8">
            <StackPanel Spacing="2" Margin="0,0,8,0">
              <TextBlock Text="{DynamicResource query.actions}" Classes="muted" FontSize="12" Margin="8,2,8,6" />
              <Button Classes="menu-item" Command="{Binding PlayNextCommand}"><StackPanel Orientation="Horizontal" Spacing="10"><icon:GlyphIcon Kind="play" Width="15" Height="15" /><TextBlock Text="{DynamicResource ui.AlbumDetailView.94ca0a7bf933}" FontSize="13" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Classes="menu-item" Command="{Binding AddToQueueCommand}"><StackPanel Orientation="Horizontal" Spacing="10"><icon:GlyphIcon Kind="queue" Width="15" Height="15" /><TextBlock Text="{DynamicResource album.detail.addQueue}" FontSize="13" VerticalAlignment="Center" /></StackPanel></Button>
              <Border Height="1" Margin="8,6" Background="{DynamicResource EchoDivider}" />
              <Button Classes="menu-item" Click="OnOpenFolder"><StackPanel Orientation="Horizontal" Spacing="10"><icon:GlyphIcon Kind="folder" Width="15" Height="15" /><TextBlock Text="{DynamicResource album.detail.showInFolder}" FontSize="13" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Classes="menu-item" Click="OnCopyFolder"><StackPanel Orientation="Horizontal" Spacing="10"><icon:GlyphIcon Kind="copy" Width="15" Height="15" /><TextBlock Text="{DynamicResource album.detail.copyPath}" FontSize="13" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Classes="menu-item" Click="OnCopyInfo"><StackPanel Orientation="Horizontal" Spacing="10"><icon:GlyphIcon Kind="copy" Width="15" Height="15" /><TextBlock Text="{DynamicResource album.detail.copyInfo}" FontSize="13" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource detail.sort.label}" Classes="muted" FontSize="12" Margin="10,2,10,6" />
              <details:DetailSortButton Name="TrackSort" IsInline="True" Margin="0,0,0,4" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" Descending="{Binding Descending, Mode=TwoWay}" />
            </StackPanel></Border></Grid></Flyout></Button.Flyout>
          </Button>
        </StackPanel>
      </StackPanel>
      <Border Name="Facts" Grid.Column="2" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="1,0,0,0" Padding="24,4,0,4" VerticalAlignment="Top">
        <WrapPanel Name="FactsPanel" Orientation="Vertical" ItemSpacing="18">
          <StackPanel Spacing="6"><TextBlock Text="{DynamicResource ui.AlbumDetailView.76d76ed548a8}" Classes="fact-label" /><TextBlock Text="{Binding AddedDate}" Classes="fact-value" /></StackPanel>
          <StackPanel Spacing="6"><TextBlock Text="{DynamicResource ui.Sidebar.a488e93d69cc}" Classes="fact-label" /><TextBlock Text="{DynamicResource album.detail.library}" Classes="fact-value" /></StackPanel>
          <StackPanel Spacing="6"><TextBlock Text="{DynamicResource ui.AlbumDetailView.739ed1896dcd}" Classes="fact-label" /><TextBlock Text="{Binding Album.TrackCount}" Classes="fact-value" /></StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasGenres}"><TextBlock Text="{DynamicResource album.detail.genre}" Classes="fact-label" /><WrapPanel Name="FactGenres" Orientation="Horizontal" /></StackPanel>
        </WrapPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource EchoDivider}" BorderThickness="0,0,0,1"><ScrollViewer Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
    <StackPanel Name="Tabs" Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center" Height="46" VerticalAlignment="Bottom">
      <Button Classes="detail-tab" Classes.active="{Binding IsTracks}" Content="{DynamicResource ui.AlbumDetailView.739ed1896dcd}" Tag="0" Click="OnTab" VerticalAlignment="Bottom" />
      <Button Classes="detail-tab" Classes.active="{Binding IsLiked}" Content="{DynamicResource text.653b04330b75}" Tag="5" Click="OnTab" VerticalAlignment="Bottom" />
      <Button Classes="detail-tab" Classes.active="{Binding IsGallery}" Content="{DynamicResource ui.AlbumDetailView.c7225dbf105e}" Tag="1" Click="OnTab" VerticalAlignment="Bottom" />
      <Button Classes="detail-tab" Classes.active="{Binding IsSources}" Content="{DynamicResource ui.Sidebar.a488e93d69cc}" Tag="2" Click="OnTab" VerticalAlignment="Bottom" />
      <Button Classes="detail-tab" Classes.active="{Binding IsVersions}" Content="{DynamicResource album.detail.tab.versions}" Tag="3" Click="OnTab" VerticalAlignment="Bottom" />
      <Button Classes="detail-tab" Classes.active="{Binding IsInformation}" Content="{DynamicResource album.detail.tab.information}" Tag="4" Click="OnTab" VerticalAlignment="Bottom" />
    </StackPanel>
    </ScrollViewer></Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource EchoAccentText}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="{DynamicResource ui.AlbumDetailView.b8784c8dd563}" Command="{Binding RetryCommand}" />
    </Grid>
    <Grid Name="TrackPanels" Grid.Row="3" RowDefinitions="Auto,Auto">
      <Grid Classes="reveal" IsVisible="{Binding IsTrackPanel}" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
        <WrapPanel Name="TrackSummary" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding TrackPanelCountText}" Classes="muted" FontSize="12" FontWeight="Medium" />
          <Border Width="1" Height="11" Margin="10,0" Background="{DynamicResource EchoDivider}" VerticalAlignment="Center" IsVisible="{Binding TrackPanelHasDuration}" />
          <TextBlock Text="{Binding TrackPanelDuration}" Classes="muted" FontSize="12" FontWeight="Medium" IsVisible="{Binding TrackPanelHasDuration}" />
          <Border Width="1" Height="11" Margin="10,0" Background="{DynamicResource EchoDivider}" VerticalAlignment="Center" IsVisible="{Binding HasQuality}" />
          <TextBlock Text="{Binding Quality}" Classes="muted" FontSize="12" FontWeight="Medium" IsVisible="{Binding HasQuality}" />
        </WrapPanel>
        <Grid Name="TrackHeader" Grid.Row="1" ColumnDefinitions="46,*,230,68,34" ColumnSpacing="18" Height="30">
          <TextBlock Text="#" Classes="muted" FontSize="12" FontWeight="Medium" LetterSpacing="0.7" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{DynamicResource album.detail.column.title}" Classes="muted" FontSize="12" FontWeight="Medium" LetterSpacing="0.7" VerticalAlignment="Center" />
          <TextBlock Name="SignalHeader" Grid.Column="2" Text="{DynamicResource album.detail.column.signal}" Classes="muted" FontSize="12" FontWeight="Medium" LetterSpacing="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="{DynamicResource album.detail.column.time}" Classes="muted" FontSize="12" FontWeight="Medium" LetterSpacing="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <ListBox Name="TrackList" Grid.Row="2" ItemsSource="{Binding Tracks}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate x:DataType="albums:AlbumTrackItem"><albums:AlbumTrackRow Classes="album-page" PlayRequested="OnTrackPlay" NextRequested="OnMenuNext" AddRequested="OnMenuAdd" /></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{DynamicResource playlists.emptyTracks}" IsVisible="{Binding IsEmpty}" Classes="muted" HorizontalAlignment="Center" Margin="24" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding HasMultiplePages}"><Button Classes="load-more" Content="{DynamicResource ui.AlbumDetailView.c9b9ae7a6144}" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" /><TextBlock Text="{Binding PageText}" Classes="muted" VerticalAlignment="Center" /><Button Classes="load-more" Content="{DynamicResource ui.AlbumDetailView.8a8542f69648}" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" /></StackPanel>
      </Grid>
      <Border Classes="reveal" IsVisible="{Binding IsGallery}"><StackPanel Spacing="16" Margin="0,8,0,24"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource ui.AlbumDetailView.259e0a7bedb5}" FontSize="21" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{DynamicResource ui.AlbumDetailView.18c937c42732}" Click="OnRefreshPanel" /></Grid><TextBlock Name="GalleryStatus" Classes="muted" FontSize="12" LineHeight="22" TextWrapping="Wrap" /><WrapPanel Name="Attachments" /></StackPanel></Border>
      <Border Classes="reveal" Grid.Row="1" IsVisible="{Binding IsSources}" BorderThickness="0" Background="{DynamicResource EchoField}" CornerRadius="14" Padding="22" Margin="0,8,0,24"><StackPanel Spacing="10"><TextBlock Text="{DynamicResource ui.AlbumDetailView.89f5750d9b79}" FontSize="18" FontWeight="SemiBold" /><SelectableTextBlock Text="{Binding Folder}" Classes="muted" TextWrapping="Wrap" FontSize="12" /><TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="{DynamicResource album.detail.showInFolder}" Click="OnOpenFolder" /><Button Content="{DynamicResource album.detail.copyPath}" Click="OnCopyFolder" /></StackPanel></StackPanel></Border>
      <Border Classes="reveal" Grid.Row="1" IsVisible="{Binding IsVersions}" BorderThickness="0" Background="{DynamicResource EchoField}" CornerRadius="14" Padding="22" Margin="0,8,0,24"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource ui.AlbumDetailView.9cee81c7212f}" FontSize="18" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{DynamicResource ui.AlbumDetailView.ce9bcfa4c1ef}" Click="OnRefreshPanel" /></Grid><TextBlock Name="VersionsStatus" Classes="muted" FontSize="12" TextWrapping="Wrap" /><StackPanel Name="Versions" Spacing="8" /></StackPanel></Border>
      <Border Classes="reveal" Grid.Row="1" IsVisible="{Binding IsInformation}" BorderThickness="0" Background="{DynamicResource EchoField}" CornerRadius="14" Padding="22" Margin="0,8,0,24"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource ui.AlbumDetailView.ebce58c89ed5}" FontSize="18" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{DynamicResource ui.AlbumDetailView.ce9bcfa4c1ef}" Click="OnRefreshPanel" /></Grid><SelectableTextBlock Name="Description" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" FontSize="14" LineHeight="26" /><Button Content="{DynamicResource album.detail.copyInfo}" Click="OnCopyInfo" HorizontalAlignment="Left" /></StackPanel></Border>
      <StackPanel Classes="reveal" Name="OnlinePanels" Grid.Row="0" Spacing="24" IsVisible="{Binding IsOnline}">
        <albums:AlbumOnlineView Name="OnlinePanel" />
        <StackPanel Name="RelatedPanel" IsVisible="False" Spacing="14" Margin="0,14,0,0"><TextBlock Text="{DynamicResource ui.AlbumDetailView.e50a5808dc33}" FontSize="18" FontWeight="SemiBold" /><WrapPanel Name="RelatedAlbums" /></StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
  </ScrollViewer>
    <Grid Name="CoverPreview" ZIndex="20" IsVisible="False" Background="#eb05070d" Margin="-8" PointerPressed="OnPreviewScrim" KeyDown="OnPreviewKey">
      <TextBlock Name="PreviewTitle" Margin="24,16,64,0" Foreground="White" FontSize="13" VerticalAlignment="Top" TextWrapping="Wrap" />
      <Image Name="PreviewImage" Margin="32" MaxWidth="680" MaxHeight="680" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
      <Button Name="PreviewClose" Classes="icon album-icon" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Click="OnClosePreview" ToolTip.Tip="{DynamicResource detail.cover.close}" AutomationProperties.Name="{DynamicResource detail.cover.close}"><icon:GlyphIcon Kind="close" Width="18" Height="18" Stroke="{DynamicResource EchoOnAccent}" /></Button>
    </Grid>
  </Grid>
</UserControl>
