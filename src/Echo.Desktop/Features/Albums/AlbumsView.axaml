<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:filters="using:Echo.Desktop.Features.LibraryDetails" xmlns:albums="using:Echo.Desktop.Features.Albums" xmlns:icon="using:Echo.Desktop.Controls"
             x:Class="Echo.Desktop.Features.Albums.AlbumsView" x:DataType="albums:AlbumsViewModel">
  <Grid>
    <Grid Name="Wall" RowDefinitions="Auto,Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource ui.AlbumsView.9e070772b185}" Classes="heading" FontSize="30" FontStyle="Normal" />
          <TextBlock Text="{Binding CountText}" Classes="muted" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Name="ImportButton" Click="OnImport" ToolTip.Tip="{DynamicResource ui.AlbumsView.1a99d0ec9af4}"><TextBlock Text="{DynamicResource ui.AlbumsView.9592c9b4b949}" FontSize="13" /></Button>
          <Button Classes="icon" Click="OnRefresh" ToolTip.Tip="{DynamicResource ui.AlbumsView.1a7b0aa3c283}"><icon:GlyphIcon Kind="refresh" Width="18" Height="18" /></Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,20">
        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="120">
          <icon:GlyphIcon Kind="search" Width="18" Height="18" Margin="12,0" ZIndex="1" />
          <TextBox Name="SearchField" Grid.ColumnSpan="3" Text="{Binding Search, Mode=TwoWay}" MaxLength="128" PlaceholderText="{DynamicResource ui.AlbumsView.a46fec777e53}" Padding="40,10,60,10" CornerRadius="6" Background="{DynamicResource EchoField}" BorderBrush="{DynamicResource EchoBorder}" KeyDown="OnSearchKey" />
          <Button Grid.Column="2" Content="×" Click="OnClearSearch" Classes="icon" ToolTip.Tip="{DynamicResource ui.AlbumsView.b6f00afa6537}" Margin="8,0" IsVisible="{Binding Search, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
        <Button Grid.Column="1" ToolTip.Tip="{DynamicResource ui.AlbumsView.f06571a3d112}">
          <StackPanel Orientation="Horizontal" Spacing="7"><icon:GlyphIcon Kind="settings" Width="16" Height="16" /><TextBlock Text="{DynamicResource ui.AlbumsView.b5f15473fdc0}" FontSize="13" /><TextBlock Text="⌄" /></StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="14" Width="300">
                <TextBlock Text="{DynamicResource ui.AlbumDetailView.eb11dd93ee99}" FontWeight="SemiBold" />
                <filters:LibraryFilterView DataContext="{Binding Filters}" />
                <Border Height="1" Background="{DynamicResource EchoDivider}" />
                <TextBlock Text="{DynamicResource ui.AlbumsView.088ca20b4938}" FontWeight="SemiBold" />
                <ComboBox Name="Density" SelectedIndex="0" SelectionChanged="OnDensityChanged" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="{DynamicResource ui.AlbumsView.7eb336e42cb5}" /><ComboBoxItem Content="{DynamicResource ui.AlbumsView.0fc19c9a6ba6}" /><ComboBoxItem Content="{DynamicResource ui.AlbumsView.995672c27fde}" /><ComboBoxItem Content="{DynamicResource ui.AlbumsView.b4184384945a}" />
                </ComboBox>
                <Button Content="{DynamicResource ui.AlbumsView.13a431e59b65}" Click="OnResetFilter" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <ComboBox SelectedIndex="{Binding SortIndex, Mode=TwoWay}" MinWidth="120" VerticalAlignment="Center">
            <ComboBoxItem Content="{DynamicResource ui.AlbumsView.4cea59dbe1d6}" /><ComboBoxItem Content="{DynamicResource ui.AlbumsView.8104520f6e69}" /><ComboBoxItem Content="{DynamicResource ui.AlbumsView.703d2fb0baef}" />
            <ComboBoxItem Content="{DynamicResource ui.AlbumsView.3411b4e3fafc}" /><ComboBoxItem Content="{DynamicResource ui.AlbumsView.ecad6a2d30ef}" /><ComboBoxItem Content="{DynamicResource ui.AlbumsView.cfc309de0941}" />
          </ComboBox>
          <ToggleButton IsChecked="{Binding Descending, Mode=TwoWay}" Content="↓" ToolTip.Tip="{DynamicResource ui.AlbumsView.b40514e8597f}" Width="32" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,8">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource EchoAccentText}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Grid Name="ScanProgressRow" ColumnDefinitions="*,Auto" IsVisible="False">
          <TextBlock Name="ScanText" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="{DynamicResource ui.AlbumsView.26bff7125c63}" Click="OnCancelImport" />
        </Grid>
      </StackPanel>
      <Grid Grid.Row="3">
        <ContentControl Name="ViewportHost" />
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <icon:GlyphIcon Kind="album" Width="32" Height="32" HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource ui.AlbumsView.3e53bf20bf17}" Classes="heading" FontSize="18" HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource ui.AlbumsView.206e79d0bee2}" Classes="muted" FontSize="13" />
          <Button Content="{DynamicResource ui.AlbumsView.9592c9b4b949}" Click="OnImport" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
    <ContentControl Name="DetailHost" IsVisible="False" />
  </Grid>
</UserControl>
