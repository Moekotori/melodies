uniform float2 draw_size;
uniform float2 draw_center;
uniform float draw_rotation;
uniform float4 draw_uv;


uniform float4 v_rect;
uniform float4 v_color;
uniform float4 v_params;

uniform float2 v_sizePx;
uniform shader u_tex;
uniform float2 u_tex_size;
uniform shader u_noise;
uniform float2 u_noise_size;
uniform float u_time;
uniform float3 u_base;
uniform float3 u_sub;
uniform float3 u_hi;
uniform float3 u_halo;
uniform float u_haloAlpha;

uniform float4 u_ripples[8];
uniform float3 u_rippleShape; // speed px/s, band width px, amplitude px
float4 sample_u_tex(float2 uv){return u_tex.eval(uv*u_tex_size);}
float4 sample_u_noise(float2 uv){return u_noise.eval(uv*u_noise_size);}
float2 rippleOffset(float2 p) {
  float2 o = float2(0.0);
  for (int i = 0; i < 8; i++) {
    float4 r = u_ripples[i];
    if (r.w <= 0.0) continue;
    float2 d = p - r.xy;
    float dist = length(d);
    float radius = r.z * u_rippleShape.x;
    float band = exp(-pow((dist - radius) / u_rippleShape.y, 2.0));
    float fade = r.w * pow(max(0.0, 1.0 - r.z / 2.8), 2.0);
    o += (d / max(dist, 1.0)) * sin((dist - radius) * 0.085) * band * fade * u_rippleShape.z;
  }
  return o;
}


half4 main(float2 coord) {
float4 outColor;
float2 v_local=coord/draw_size;
float2 v_uv=mix(draw_uv.xy,draw_uv.zw,v_local);
float c=cos(draw_rotation),s=sin(draw_rotation);
float2 q=(v_local-.5)*draw_size;
float2 v_screen=draw_center+float2(q.x*c-q.y*s,q.x*s+q.y*c);

  float fill = v_params.x;
  float wobble = v_params.y;
  float dissolve = v_params.z;
  float seed = v_params.w;
  float2 local = v_local;
  float2 w = float2(sin(local.y * 17.0 + u_time * 4.1 + seed * 6.2831), cos(local.x * 13.0 + u_time * 3.3 + seed * 3.1)) * 0.016 * wobble;
  float2 shifted = clamp(local + w + rippleOffset(v_screen) / v_sizePx, 0.0, 1.0);
  float2 t = sample_u_tex( mix(v_rect.xy, v_rect.zw, shifted)).rg;
  float fillA = t.r;
  float glowA = t.g * u_haloAlpha;
  if (dissolve > 0.0) {
    float n = sample_u_noise( local * 0.45 + float2(seed, seed * 1.7)).b;
    float keep = smoothstep(dissolve - 0.12, dissolve + 0.12, n * 1.1);
    fillA *= keep;
    glowA *= mix(keep, 1.0, 0.35) * (1.0 - dissolve * 0.6);
  }
  float hi = clamp((fill * 1.24 - 0.12 - local.x) / 0.24 + 0.5, 0.0, 1.0);
  float3 body = mix(mix(u_sub, u_base, v_color.r), u_hi, hi * v_color.r);
  float3 halo = mix(u_halo, u_hi, hi * v_color.r * 0.4);
  float3 rgb = body * fillA + halo * glowA * (1.0 - fillA);
  float a = fillA + glowA * (1.0 - fillA);
  outColor = float4(rgb, a) * v_color.a;
return half4(outColor);
}
